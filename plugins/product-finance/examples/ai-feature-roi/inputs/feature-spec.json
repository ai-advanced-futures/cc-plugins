{
  "feature": {
    "name": "AI Analytics Assistant",
    "codename": "project-insight",
    "version": "1.0.0",
    "description": "AI-powered analytics assistant that enables natural language data queries, automated insight generation, and intelligent report building",
    "status": "planning",
    "target_launch": "2026-Q2"
  },
  "capabilities": [
    {
      "name": "Natural Language Queries",
      "description": "Users can ask questions about their data in plain English",
      "examples": [
        "Show me revenue by region for last quarter",
        "Which customers are at risk of churning?",
        "Compare this month's performance to same period last year"
      ],
      "ai_usage": {
        "model": "gpt-4",
        "avg_tokens_per_query": 2500,
        "queries_per_user_per_month": 50
      }
    },
    {
      "name": "Automated Insights",
      "description": "AI proactively surfaces important trends and anomalies",
      "examples": [
        "Your conversion rate dropped 15% last week",
        "Customer segment A shows 2x higher engagement",
        "Revenue trending 10% above forecast"
      ],
      "ai_usage": {
        "model": "claude-sonnet-4",
        "avg_tokens_per_insight": 1500,
        "insights_per_user_per_month": 20
      }
    },
    {
      "name": "Smart Report Builder",
      "description": "AI suggests visualizations and report structures based on user goals",
      "examples": [
        "Create an executive summary for the board",
        "Build a weekly KPI dashboard",
        "Generate a customer health report"
      ],
      "ai_usage": {
        "model": "gpt-4",
        "avg_tokens_per_report": 5000,
        "reports_per_user_per_month": 5
      }
    },
    {
      "name": "Anomaly Detection",
      "description": "Continuous monitoring with AI-powered alerting",
      "examples": [
        "Alert: Unusual spike in error rates",
        "Warning: Customer X usage dropped 50%",
        "Notice: New competitor detected in your market"
      ],
      "ai_usage": {
        "model": "claude-haiku",
        "avg_tokens_per_check": 500,
        "checks_per_customer_per_day": 24
      }
    }
  ],
