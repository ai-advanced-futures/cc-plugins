{
  "schema_version": "1.0.0",
  "category": "subscription",
  "description": "Event schemas for subscription lifecycle tracking",
  "generated_at": "2026-01-23T10:00:00Z",
  "events": [
    {
      "event_name": "subscription_created",
      "event_category": "subscription",
      "description": "Emitted when a new subscription is created and activated",
      "trigger": "Stripe webhook: customer.subscription.created",
      "priority": "critical",
      "required_fields": [
        {
          "field_name": "customer_id",
          "field_type": "string",
          "description": "Unique customer/organization identifier",
          "example": "cus_ABC123",
          "source": "subscription.customer",
          "validation": "Must exist in customers table"
        },
        {
          "field_name": "subscription_id",
          "field_type": "string",
          "description": "Unique subscription identifier",
          "example": "sub_XYZ789",
          "source": "subscription.id",
          "validation": "Must be unique"
        },
        {
          "field_name": "plan",
          "field_type": "string",
          "description": "Plan/price identifier",
          "example": "price_professional_monthly",
          "source": "subscription.items.data[0].price.id",
          "validation": "Must be valid plan ID"
        },
        {
          "field_name": "mrr",
          "field_type": "number",
          "description": "Monthly recurring revenue in USD",
          "example": 99.00,
          "source": "subscription.items.data[0].price.unit_amount / 100",
          "validation": "Must be >= 0"
        },
        {
          "field_name": "billing_cycle",
          "field_type": "string",
          "description": "Billing interval",
          "example": "month",
          "source": "subscription.items.data[0].price.recurring.interval",
          "validation": "Must be 'month' or 'year'"
        },
        {
          "field_name": "start_date",
          "field_type": "datetime",
          "description": "Subscription start date (ISO 8601)",
          "example": "2026-01-23T10:00:00Z",
          "source": "subscription.start_date",
          "validation": "Must be valid ISO 8601 datetime"
        },
        {
          "field_name": "timestamp",
          "field_type": "datetime",
          "description": "Event timestamp (ISO 8601)",
          "example": "2026-01-23T10:00:05Z",
          "source": "Server timestamp",
          "validation": "Must be valid ISO 8601 datetime"
        }
      ],
      "optional_fields": [
        {
          "field_name": "discount_pct",
          "field_type": "number",
          "description": "Applied discount percentage",
          "example": 20
        },
        {
          "field_name": "promo_code",
          "field_type": "string",
          "description": "Applied promo/coupon code",
          "example": "LAUNCH20"
        },
        {
          "field_name": "source_channel",
          "field_type": "string",
          "description": "Acquisition channel",
          "example": "organic"
        },
        {
          "field_name": "sales_rep_id",
          "field_type": "string",
          "description": "Sales representative ID",
          "example": "emp_123"
        },
        {
          "field_name": "trial_converted",
          "field_type": "boolean",
          "description": "Whether this converted from trial",
          "example": true
        }
      ],
      "enables_metrics": [
        "MRR",
        "ARR",
        "Customer Count",
        "New MRR",
        "Trial Conversion Rate"
      ],
      "implementation_example": {
        "framework": "django",
        "location": "billing/webhooks.py",
        "code": "track_financial_event('subscription_created', {\n    'customer_id': subscription['customer'],\n    'subscription_id': subscription['id'],\n    'plan': plan_item['price']['id'],\n    'mrr': plan_item['price']['unit_amount'] / 100,\n    'billing_cycle': plan_item['price']['recurring']['interval'],\n    'start_date': datetime.fromtimestamp(subscription['start_date']).isoformat(),\n    'timestamp': datetime.utcnow().isoformat()\n})"
      }
    },
