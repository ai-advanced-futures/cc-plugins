    {
      "event_name": "customer_created",
      "event_category": "customer",
      "description": "Emitted when a new organization/customer is created",
      "trigger": "Organization signup completion",
      "priority": "high",
      "required_fields": [
        {
          "field_name": "customer_id",
          "field_type": "string",
          "description": "Unique customer/organization identifier",
          "example": "cus_ABC123",
          "validation": "Must be unique"
        },
        {
          "field_name": "company_name",
          "field_type": "string",
          "description": "Company/organization name",
          "example": "Acme Corporation"
        },
        {
          "field_name": "industry",
          "field_type": "string",
          "description": "Industry classification",
          "example": "technology",
          "enum": [
            "technology",
            "healthcare",
            "finance",
            "retail",
            "manufacturing",
            "education",
            "government",
            "other"
          ]
        },
        {
          "field_name": "employee_count",
          "field_type": "string",
          "description": "Company size range",
          "example": "51-200",
          "enum": [
            "1-10",
            "11-50",
            "51-200",
            "201-500",
            "501-1000",
            "1001-5000",
            "5000+"
          ]
        },
        {
          "field_name": "source_channel",
          "field_type": "string",
          "description": "Acquisition channel",
          "example": "organic_search",
          "enum": [
            "organic_search",
            "paid_search",
            "social_media",
            "referral",
            "partner",
            "outbound_sales",
            "event",
            "content_marketing",
            "direct",
            "other"
          ]
        },
        {
          "field_name": "timestamp",
          "field_type": "datetime",
          "description": "Event timestamp",
          "example": "2026-01-23T10:00:00Z"
        }
      ],
      "optional_fields": [
        {
          "field_name": "referral_source",
          "field_type": "string",
          "description": "Specific referral source",
          "example": "partner_xyz"
        },
        {
          "field_name": "sales_rep_id",
          "field_type": "string",
          "description": "Assigned sales representative",
          "example": "emp_123"
        },
        {
          "field_name": "campaign_id",
          "field_type": "string",
          "description": "Marketing campaign attribution",
          "example": "camp_spring2026"
        },
        {
          "field_name": "lead_id",
          "field_type": "string",
          "description": "Associated lead ID if converted",
          "example": "lead_xyz789"
        },
        {
          "field_name": "country",
          "field_type": "string",
          "description": "Country (ISO 3166-1 alpha-2)",
          "example": "US"
        },
        {
          "field_name": "timezone",
          "field_type": "string",
          "description": "Customer timezone",
          "example": "America/New_York"
        }
      ],
      "enables_metrics": [
        "Customer Count",
        "New Customers",
        "CAC by Channel",
        "Customer Segmentation"
      ]
    },
