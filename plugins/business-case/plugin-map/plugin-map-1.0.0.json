  "plugins": {
    "jtbd-market-discovery": {
      "min_version": "1.9.0",
      "commands": {
        "jtbd-market-discovery:discover": {
          "route": "jtbd-market-discovery:discover",
          "coach_runs": true,
          "reads_from": [],
          "kinds": [
            "job",
            "job_step",
            "opportunity_score",
            "customer_value",
            "customer_segment",
            "willingness_to_pay"
          ],
          "phases": [
            1,
            2,
            3,
            4,
            8
          ],
          "never_set": []
        },
        "jtbd-market-discovery:wtp-check": {
          "route": "jtbd-market-discovery:wtp-check",
          "coach_runs": true,
          "reads_from": [
            "jtbd-market-discovery:discover"
          ],
          "kinds": [
            "willingness_to_pay",
            "customer_value"
          ],
          "phases": [
            9
          ],
          "never_set": []
        }
      }
    },
    "pricing": {
      "min_version": "1.11.0",
      "commands": {
        "pricing:price": {
          "route": "pricing:price-runner",
