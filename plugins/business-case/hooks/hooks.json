{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/judge_guard.py\" pre-write", "timeout": 10, "onFailure": "block"}
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/judge_guard.py\" pre-dispatch", "timeout": 10, "onFailure": "block"}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/runner_guard.py\" pre-bash", "timeout": 10}
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/runner_guard.py\" pre-write", "timeout": 10}
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/runner_guard.py\" pre-read", "timeout": 10}
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/runner_guard.py\" pre-skill", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/judge_guard.py\" post-write", "timeout": 10}
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks-handlers/runner_guard.py\" post-bash", "timeout": 10}
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/brain-hook.sh\""}
        ]
      }
    ]
  }
}
