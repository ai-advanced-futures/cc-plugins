{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ai-advanced-futures/cc-plugins/plugins/pricing/schemas/agentic-pricing/archetype-cost-samples.schema.json",
  "title": "Archetype Cost Samples",
  "description": "Per-archetype raw cost-per-interaction samples emitted by an engagement / MCP collector for aiml aggregation. Producer: collector. Consumer: aiml. Audience: internal.",
  "type": "object",
  "required": ["engagement_id", "produced_at", "schema_version", "audience", "measurement_window", "telemetry_source", "archetypes"],
  "additionalProperties": false,
  "properties": {
    "engagement_id": {"type": "string", "format": "uuid"},
    "produced_at": {"type": "string", "format": "date-time"},
    "schema_version": {"type": "string", "const": "1.0.0"},
    "audience": {"type": "string", "const": "internal"},
    "measurement_window": {
      "type": "object",
      "required": ["start", "end", "duration_days"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "duration_days": {"type": "integer", "minimum": 1}
      }
    },
    "telemetry_source": {"type": "string", "enum": ["datadog", "grafana", "wandb", "trackio", "manual", "other"]},
    "archetypes": {
      "type": "object",
      "patternProperties": {
        "^(support_agent|developer_tool|vertical_pro_services_agent|sales_marketing_agent|knowledge_horizontal_copilot|autonomous_workflow_agent)$": {
          "type": "object",
          "required": ["cost_samples", "sample_size_n", "present"],
          "additionalProperties": false,
          "properties": {
            "cost_samples": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
            "sample_size_n": {"type": "integer", "minimum": 1},
            "present": {"type": "boolean"}
          }
        }
      },
      "additionalProperties": false
    },
    "notes": {"type": "string", "maxLength": 2000}
  }
}
