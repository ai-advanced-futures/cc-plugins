#!/usr/bin/env python3
"""sofa-state: the SQLite state store of sofa.

Many sessions write at the same time, so the database runs in WAL mode with a
busy timeout. Each command creates the schema when it is not there.

Database path: --db PATH, else $SOFA_STATE_DB, else <main folder>/.sofa/state.db.
Exit code: 0 on success; 2 on a bad argument (argparse), when `decision log` refuses
its arguments, when `kv set` gets a key that starts with `decision.`, and when
SOFA_GIT_TIMEOUT is not a number greater than 0 (read at the first git call, so a command
that makes no git call does not read it); 3 when `snapshot publish` refuses a snapshot because the guard
found a private value (nothing is pushed; `snapshot take` keeps exit 1 for the same output line); 1 on all other errors, also when
`decision log` cannot reserve a block of decision ids (see "decisions" below); also on
`snapshot take` when the floor configuration is missing or wrong, and when the snapshot or a rule set of the
file would hold a known private value (a session id, a path, a person login or a machine value).
"""

import argparse
import hashlib
import json
import math
import os
import random
import re
import secrets
import shlex
import signal
import sqlite3
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone

SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions (
    name TEXT PRIMARY KEY, id TEXT, role TEXT, model TEXT,
    state TEXT, item TEXT, since TEXT, last_heartbeat TEXT, free_since TEXT,
    colour TEXT);
CREATE TABLE IF NOT EXISTS items (
    id TEXT PRIMARY KEY, state TEXT, pr TEXT, branch TEXT, worktree TEXT,
    waits_for TEXT, session TEXT, picked_up_at TEXT, released_at TEXT, updated_at TEXT);
CREATE TABLE IF NOT EXISTS trips (
    id INTEGER PRIMARY KEY AUTOINCREMENT, item TEXT, from_role TEXT, to_role TEXT, at TEXT);
CREATE TABLE IF NOT EXISTS messages (
    id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, from_name TEXT, to_name TEXT,
    subject TEXT, at TEXT);
CREATE TABLE IF NOT EXISTS decisions (
    id TEXT PRIMARY KEY, story TEXT, level TEXT, confidence TEXT, reversibility TEXT,
    visibility TEXT, decided_by TEXT, summary TEXT, at TEXT, vetoed_at TEXT);
CREATE TABLE IF NOT EXISTS interactions (
    id INTEGER PRIMARY KEY AUTOINCREMENT, story TEXT, kind TEXT, by_whom TEXT, at TEXT);
CREATE TABLE IF NOT EXISTS asks (
    id TEXT PRIMARY KEY, story TEXT, priority TEXT, opened_at TEXT, closed_at TEXT);
CREATE TABLE IF NOT EXISTS usage (
    session TEXT, item TEXT, tokens INTEGER, at TEXT, UNIQUE(session, item));
CREATE TABLE IF NOT EXISTS heartbeats (name TEXT, at TEXT);
CREATE TABLE IF NOT EXISTS queue (position INTEGER PRIMARY KEY, item TEXT);
CREATE TABLE IF NOT EXISTS kv (key TEXT PRIMARY KEY, value TEXT);
"""

INTERACTION_KINDS = ["ask", "answer", "veto", "request", "defect"]
# The values of the decision tables (docs/adlc.md, section 4).
DECISION_LEVELS = ["detail", "middle", "direction"]
DECISION_CONFIDENCES = ["high", "medium", "low"]
DECISION_REVERSIBILITIES = ["reversible", "hard to reverse", "irreversible"]
DECISION_VISIBILITIES = ["visible", "hidden"]


class UsageError(Exception):
    """A bad argument that argparse cannot catch. `code` is the exit code."""

    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


class Quiet(UsageError):
    """An exit code with no message on stderr: the command printed its report on stdout."""


def now_iso():
    """Return the current UTC time as ISO-8601 with second precision."""
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def norm_iso(text):
    """Return TEXT in the one timestamp format of this store, as UTC."""
    if text is None:
        return now_iso()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    dt = datetime.fromisoformat(text)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# argparse names the type in its error line, so the name must read well.
norm_iso.__name__ = "ISO-8601 time"


def parse_iso(text):
    """Return the datetime of a stored timestamp, or None."""
    if not text:
        return None
    return datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


def main_folder():
    """The main folder of the repository: the parent of the common .git folder.

    The same folder in the main checkout and in each worktree. Raises
    subprocess.CalledProcessError outside a git repository.
    """
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            capture_output=True, text=True, check=True).stdout.strip()
    if os.path.basename(common) == ".git":
        return os.path.dirname(common)
    return subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                          text=True, check=True).stdout.strip()


def db_path(arg):
    """Find the database path from the flag, the environment or the main folder."""
    if arg:
        return arg
    if os.environ.get("SOFA_STATE_DB"):
        return os.environ["SOFA_STATE_DB"]
    folder = os.path.join(main_folder(), ".sofa")
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, "state.db")


def open_db(path):
    """Open the database for many writers and create the schema."""
    con = sqlite3.connect(path, timeout=5)
    con.row_factory = sqlite3.Row
    # busy_timeout must be set first: the change to WAL needs an exclusive lock.
    con.execute("PRAGMA busy_timeout=5000")
    con.execute("PRAGMA journal_mode=WAL")
    con.executescript(SCHEMA)
    # A store from an earlier version has no sessions.colour column.
    if "colour" not in [row[1] for row in con.execute("PRAGMA table_info(sessions)")]:
        con.execute("ALTER TABLE sessions ADD COLUMN colour TEXT")
    return con


def blank_to_none(value):
    """An empty string clears a field; None keeps the old value."""
    return None if value == "" else value


# --- sessions ---

def cmd_session_upsert(con, a):
    """Insert or update a session. `since` changes only with the state."""
    at = a.at
    con.execute("""
        INSERT INTO sessions (name, id, role, model, state, item, since, free_since)
        VALUES (:name, :id, :role, :model, COALESCE(:state, 'live'), :item, :at, NULL)
        ON CONFLICT(name) DO UPDATE SET
            id = excluded.id,
            role = excluded.role,
            model = COALESCE(excluded.model, sessions.model),
            state = COALESCE(:state, sessions.state),
            item = COALESCE(excluded.item, sessions.item),
            since = CASE WHEN :state IS NOT NULL AND :state IS NOT sessions.state
                         THEN excluded.since ELSE sessions.since END,
            free_since = CASE WHEN excluded.item IS NOT NULL THEN NULL ELSE sessions.free_since END
    """, dict(name=a.name, id=a.id, role=a.role, model=a.model,
              state=a.state, item=a.item, at=at))
    con.commit()


def cmd_session_free(con, a):
    """Set the session item to NULL and record when it became free."""
    con.execute("UPDATE sessions SET item = NULL, free_since = ? WHERE name = ?", (a.at, a.name))
    con.commit()


def cmd_session_colour(con, a):
    """Record the colour that /color set in the session. A row is created when it is not there."""
    con.execute("INSERT INTO sessions (name, state, since) VALUES (?, 'live', ?) "
                "ON CONFLICT(name) DO NOTHING", (a.name, a.at))
    con.execute("UPDATE sessions SET colour = ? WHERE name = ?", (a.colour, a.name))
    con.commit()


def cmd_session_heartbeat(con, a):
    """Record a heartbeat. A session row is created when it is not there."""
    con.execute("INSERT INTO sessions (name, state, since) VALUES (?, 'live', ?) "
                "ON CONFLICT(name) DO NOTHING", (a.name, a.at))
    con.execute("UPDATE sessions SET last_heartbeat = ? WHERE name = ?", (a.at, a.name))
    con.execute("INSERT INTO heartbeats (name, at) VALUES (?, ?)", (a.name, a.at))
    con.commit()


def cmd_session_list(con, a):
    """Print all sessions."""
    rows = con.execute("SELECT * FROM sessions ORDER BY name").fetchall()
    emit(rows, a.json, ["name", "id", "role", "model", "state", "item", "since",
                        "last_heartbeat", "free_since", "colour"])


# --- items ---

def cmd_item_set(con, a):
    """Insert or update an item. Omitted flags keep the old value; '' clears it."""
    con.execute("""
        INSERT INTO items (id, state, pr, branch, worktree, waits_for, session,
                           picked_up_at, released_at, updated_at)
        VALUES (:id, :state, :pr, :branch, :worktree, :waits_for, :session,
                :at, CASE WHEN :state = 'released' THEN :at END, :at)
        ON CONFLICT(id) DO UPDATE SET
            state = excluded.state,
            pr = CASE WHEN :pr_given THEN excluded.pr ELSE items.pr END,
            branch = CASE WHEN :branch_given THEN excluded.branch ELSE items.branch END,
            worktree = CASE WHEN :worktree_given THEN excluded.worktree ELSE items.worktree END,
            waits_for = CASE WHEN :waits_for_given THEN excluded.waits_for ELSE items.waits_for END,
            session = CASE WHEN :session_given THEN excluded.session ELSE items.session END,
            released_at = CASE WHEN excluded.state = 'released'
                               THEN COALESCE(items.released_at, excluded.updated_at)
                               ELSE items.released_at END,
            updated_at = excluded.updated_at
    """, dict(id=a.id, state=a.state, at=a.at,
              pr=blank_to_none(a.pr), pr_given=a.pr is not None,
              branch=blank_to_none(a.branch), branch_given=a.branch is not None,
              worktree=blank_to_none(a.worktree), worktree_given=a.worktree is not None,
              waits_for=blank_to_none(a.waits_for), waits_for_given=a.waits_for is not None,
              session=blank_to_none(a.session), session_given=a.session is not None))
    con.commit()


def cmd_item_trip(con, a):
    """Record one hand-over of an item between two roles."""
    con.execute("INSERT INTO trips (item, from_role, to_role, at) VALUES (?, ?, ?, ?)",
                (a.id, a.from_role, a.to_role, a.at))
    con.commit()


# --- messages ---

def cmd_message_log(con, a):
    """Record the header of a message. The body is never stored."""
    con.execute("INSERT INTO messages (type, from_name, to_name, subject, at) VALUES (?, ?, ?, ?, ?)",
                (a.type, a.from_name, a.to_name, a.subject, a.at))
    con.commit()


# --- decisions ---

# An id is D- and 1 to 9 ASCII digits. Use `fullmatch`: a longer id makes `int()` slow or raise.
DECISION_ID_RE = re.compile(r"D-([0-9]{1,9})")

INSERT_DECISION = """
    INSERT INTO decisions (id, story, level, confidence, reversibility, visibility,
                           decided_by, summary, at, vetoed_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, NULL)
"""

ON_ID_CONFLICT_UPDATE = """
    ON CONFLICT(id) DO UPDATE SET
        story = excluded.story, level = excluded.level, confidence = excluded.confidence,
        reversibility = excluded.reversibility, visibility = excluded.visibility,
        decided_by = excluded.decided_by, summary = excluded.summary, at = excluded.at
"""


# A store gives ids only from its own block of ids. Block k holds D-<1000k+1> to
# D-<1000k+999> (block 0: D-001 to D-999). A store reserves a block on origin with the tag
# refs/tags/sofa-decision-block/<k>, which git creates only 1 time (ADR-0011).
TAG_PREFIX = "refs/tags/sofa-decision-block/"
TAG_RE = re.compile(r"refs/tags/sofa-decision-block/([0-9]{1,6})")
MAX_BLOCK = 999999
MAX_CITED_ID = 99999  # the highest id of main that counts; old ids are near 5000 (block 99 at most)
MAX_PUSHES = 5
APP_KEYS = ["app-id", "installation-id", "key-path", "slug", "bot-user-id"]
RESERVE_FAILED = "cannot reserve a block of decision ids"
RESERVE_TAIL = "no decision written. Try again in 1 minute."
RESERVE_SHORT = "no decision written."
PUBLISH_FAILED = "cannot publish the snapshot"
PUBLISH_TAIL = "nothing pushed."


def block_range(k):
    """The first and the last id number of block K."""
    return (1, 999) if k == 0 else (1000 * k + 1, 1000 * k + 999)


def block_of(n):
    """The block of id number N. D-1000 belongs to block 0, because block 1 starts at D-1001."""
    return (n - 1) // 1000


def store_numbers(con):
    """The number of each id of the store that has the form of row 2."""
    return [int(m.group(1)) for row in con.execute("SELECT id FROM decisions")
            if (m := DECISION_ID_RE.fullmatch(row[0] or ""))]


def next_decision_id(con, k):
    """Return the next free D-<n> of block K (3 digits at least), or None when the block is full."""
    first, last = block_range(k)
    n = max((x for x in store_numbers(con) if first <= x <= last), default=first - 1) + 1
    return None if n > last else f"D-{n:03d}"


def stored_block(con):
    """The block of this store (the key decision.block), or None."""
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.block'").fetchone()
    try:
        block = int(row[0]) if row else None
    except ValueError:
        return None
    # A value out of range would give ids that do not have the form of row 2.
    return block if block is not None and 0 <= block <= MAX_BLOCK else None


def write_block(con, block):
    """Make BLOCK the block of this store. The caller holds the write transaction."""
    con.execute("INSERT INTO kv (key, value) VALUES ('decision.block', ?) "
                "ON CONFLICT(key) DO UPDATE SET value = excluded.value", (str(block),))


def git_timeout():
    """The time limit of 1 git call in seconds: SOFA_GIT_TIMEOUT, else 60."""
    raw = os.environ.get("SOFA_GIT_TIMEOUT")
    if raw is None:
        return 60.0
    try:
        value = float(raw)
    except ValueError:
        value = 0.0
    if not (math.isfinite(value) and value > 0):
        raise UsageError("SOFA_GIT_TIMEOUT must be a number of seconds greater than 0", code=2)
    return value


# The keys that select a repository, or change what `git config` reads. A value that a parent git
# process (a hook, an `exec` step of a rebase) set for its own repository is wrong for the
# repository of the store. 13 keys are the list of `git rev-parse --local-env-vars` (githooks(5)
# tells a hook to clear them), without GIT_CONFIG_PARAMETERS and GIT_CONFIG_COUNT, which hold the
# git setup of the session. GIT_CONFIG makes `git config` read 1 file, and `git push` reads the
# full config (git-config(1)). GIT_NAMESPACE is not in the list of git: it moves a tag on a local
# `origin` to a ref that other stores do not read. The case `envlist` compares this tuple with git.
REPO_ENV_KEYS = (
    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CONFIG", "GIT_OBJECT_DIRECTORY", "GIT_DIR",
    "GIT_WORK_TREE", "GIT_IMPLICIT_WORK_TREE", "GIT_GRAFT_FILE", "GIT_INDEX_FILE",
    "GIT_NO_REPLACE_OBJECTS", "GIT_REPLACE_REF_BASE", "GIT_PREFIX", "GIT_SHALLOW_FILE",
    "GIT_COMMON_DIR", "GIT_NAMESPACE",
)


def git_env():
    """The environment of each git call: a copy of os.environ with no key of REPO_ENV_KEYS.

    The GIT_CONFIG_* entries of the session stay (the App git setup, ADR-0007, decision 3).
    GIT_TERMINAL_PROMPT=0 stops the prompt on the terminal, and an empty GIT_ASKPASS stops each
    askpass program (GIT_ASKPASS, core.askPass, SSH_ASKPASS), so a call with no credential fails.
    """
    env = {k: v for k, v in os.environ.items() if k not in REPO_ENV_KEYS}
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_ASKPASS"] = ""
    return env


def run_git(repo, args, env=None, stdin=None):
    """Run `git -C REPO ARGS` in its own process group. Return (exit code, stdout, stderr).

    With `env=None` the call gets `git_env()`. On the time limit the full group stops, not only
    `git`: `git` starts children (`ssh`, `git-remote-https`, `upload-pack`) that hold the pipes
    open (docs/adlc.md, rule 16).
    """
    if env is None:
        env = git_env()
    limit = git_timeout()
    p = subprocess.Popen(["git", "-C", repo, *args], stdin=subprocess.PIPE if stdin is not None
                         else subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         text=True, errors="replace", env=env, start_new_session=True)
    try:
        out, err = p.communicate(stdin, timeout=limit)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass  # the group ended between the time-out and the kill
        try:
            out, err = p.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            # A child that left the group still holds the pipes: do not wait for it.
            p.stdout.close()
            p.stderr.close()
            out, err = "", ""
        return 124, out, f"no end after {limit:g} seconds"
    return p.returncode, out, err


class Git:
    """The git calls of 1 reservation: 1 repository, 1 environment (row 10 of the STORY-143 spec and
    rows 2 to 4 of the STORY-425 spec)."""

    def __init__(self, repo, failed=None, tail=None, short=None):
        # The text of an error is an argument, so a reservation and a publish each keep their own (row 8 of the
        # STORY-444 spec). The default is the text of a reservation. SHORT ends a message that gives no advice.
        self.failed = failed or RESERVE_FAILED
        self.tail = RESERVE_TAIL if tail is None else tail
        self.short = RESERVE_SHORT if short is None else short
        self.repo = repo
        self.env = git_env()
        ssh = self.env.get("GIT_SSH_COMMAND")
        if not ssh:
            rc, out, _ = run_git(repo, ["config", "--get", "core.sshCommand"], env=self.env)
            ssh = out.strip() if rc == 0 else ""
        if not ssh:
            ssh = shlex.quote(self.env["GIT_SSH"]) if self.env.get("GIT_SSH") else "ssh"
        self.env["GIT_SSH_COMMAND"] = ssh + " -o BatchMode=yes"

    def run(self, *args, stdin=None, extra=None):
        # The output is parsed, so a color setting of the person must not add escape codes to it.
        # EXTRA are more variables for this 1 call (the identity of a commit).
        env = {**self.env, **extra} if extra else self.env
        return run_git(self.repo, ["-c", "color.ui=never", "-c", "color.grep=never", *args],
                       env=env, stdin=stdin)

    def must(self, *args, stdin=None, extra=None):
        """Run a git call. Return stdout. Raise the error of row 9 when it fails."""
        rc, out, err = self.run(*args, stdin=stdin, extra=extra)
        if rc != 0:
            raise self.failure(args[0], rc, err)
        return out

    def failure(self, step, rc, err):
        text = f"{self.failed}: {step}: {git_reason(err, rc)}"
        return UsageError(f"{text}; {self.tail}" if self.tail else text)


def git_reason(err, rc):
    """The detail of a failed git step, from its stderr ERR (row 5 of the STORY-425 spec).

    A refused push prints `To <url>` first, which does not name the reason. The status line of the
    ref (flag `!`, git-push(1)) holds the reason of git, and a `remote:` line is the text of the
    hook or of the server. So: the first `! ` line, then `, ` and the first `remote:` line when
    there is one; else the first line; else `git exited RC`. A line that is only `remote:` is skipped.
    """
    lines = [x for x in (line.strip() for line in err.splitlines()) if x and x != "remote:"]
    flagged = [x for x in lines if x.startswith("! ")]
    if flagged:
        remote = [x for x in lines if x.startswith("remote:")]
        return flagged[0] + (", " + remote[0] if remote else "")
    return lines[0] if lines else f"git exited {rc}"


def store_repo(path):
    """The repository of the store at PATH, or None (row 10).

    The folder F that holds the `.sofa` folder of the store, only when `git -C F rev-parse
    --show-toplevel` prints the real path of F. A plain folder inside a checkout is no repository.
    """
    full = os.path.realpath(path)
    sofa = os.path.dirname(full)
    if os.path.basename(sofa) != ".sofa":
        return None
    folder = os.path.dirname(sofa)
    rc, out, _ = run_git(folder, ["rev-parse", "--show-toplevel"])
    return folder if rc == 0 and os.path.realpath(out.strip()) == folder else None


def repo_of_store(a, failed=RESERVE_FAILED):
    repo = store_repo(a.db_path)
    if repo is None:
        raise UsageError(f"{failed}: the store {a.db_path} is not <repository>/.sofa/"
                         "state.db; give no --db, or give the path of the store of the main folder.")
    return repo


def origin_url(git):
    """The 1 URL of origin, for fetch and for push (rows 3, 5, 6 and 20). The tags are read from the
    fetch URL and pushed to each push URL, so a second URL would send the tag to another repository
    (a fork, or an SSH address that uses the key of the person). It makes only local git calls."""
    fetch = [u for u in git.must("remote", "get-url", "--all", "origin").split("\n") if u]
    push = [u for u in git.must("remote", "get-url", "--push", "--all", "origin").split("\n") if u]
    if len(fetch) != 1 or push != fetch:
        raise UsageError((f"{git.failed}: remote: origin must have 1 URL for fetch and push "
                          f"(fetch {' '.join(fetch) or 'none'}, push {' '.join(push) or 'none'}); "
                          f"{git.short}").rstrip("; "))
    return fetch[0]


def has_app_values(con):
    """Does the store hold at least 1 of the machine.github-app.* values?"""
    marks = [f"machine.github-app.{k}" for k in APP_KEYS]
    rows = con.execute(f"SELECT value FROM kv WHERE key IN ({','.join('?' * len(marks))})", marks)
    return any(row[0] for row in rows)


def app_setup_ok(con, git, url):
    """Row 20. Return None when the store has no App values or the git setup is the App setup,
    else the text of the check that failed. URL is the 1 URL of origin. It makes no network call."""
    if not has_app_values(con):
        return None
    rc, out, _ = git.run("config", "-z", "--get-regexp", r"^credential\..*helper$")
    values = [e.split("\n", 1)[1] if "\n" in e else "" for e in out.split("\0") if e] if rc == 0 else []
    while "" in values:
        values = values[len(values) - values[::-1].index(""):]
    if not values:
        return "no credential helper is set after the last empty value"
    for value in values:
        try:
            words = shlex.split(value[1:]) if value.startswith("!") else []
        except ValueError:
            words = []
        if len(words) != 2 or words[1] != "credential" or os.path.basename(words[0]) != "sofa-github":
            return f"the credential helper {value} is not sofa-github credential"
    if not url.startswith("https://github.com/"):
        return f"the URL of origin is {url}, not an https://github.com/ URL"
    return None


def tag_numbers(git):
    """The reserved tags on origin, as {block number: object id of the tag}."""
    out = git.must("ls-remote", "--tags", "origin", TAG_PREFIX + "*")
    tags = {}
    for line in out.splitlines():
        oid, _, ref = line.partition("\t")
        m = TAG_RE.fullmatch(ref.strip())
        if m:
            tags[int(m.group(1))] = oid.strip()
    return tags


def main_block(git):
    """The highest block of an id that docs/ of origin/main cites, or -1 (row 7)."""
    # The random part: a stale lock of a killed run must not stop a run with the same pid.
    ref = f"refs/sofa-state/main-{os.getpid()}-{secrets.token_hex(4)}"
    try:
        git.must("fetch", "--no-tags", "--no-write-fetch-head", "--refmap=", "origin",
                 f"+refs/heads/main:{ref}")
        rc, out, err = git.run("grep", "--no-color", "-o", "-h", "-w", "-E", "D-[0-9]+", ref, "--", "docs/")
        if rc not in (0, 1):
            raise git.failure("grep", rc, err)
    finally:
        git.run("update-ref", "-d", ref)
    ids = (DECISION_ID_RE.fullmatch(line.rsplit(":", 1)[-1].strip()) for line in out.splitlines())
    # An id above MAX_CITED_ID is an example or a typo, not an old id: one D-<9 digits> in docs/
    # must not stop each reservation (issue 1803). A block above it comes from a tag (k_tag).
    return max((block_of(n) for n in (int(m.group(1)) for m in ids if m) if n <= MAX_CITED_ID),
               default=-1)


def store_id(con):
    """The id of this store (the key decision.store). It is read first, so a store that has an id needs no write
    lock (in WAL mode a read goes on while another writer holds the lock, STORY-444 row 18). Only when the key is
    absent, it is written and committed at once."""
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    if row:
        return row[0]
    con.execute("INSERT OR IGNORE INTO kv (key, value) VALUES ('decision.store', ?)",
                (secrets.token_hex(8),))
    con.commit()
    return con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()[0]


def reserve_block(con, repo):
    """Reserve a new block on origin and return its number k (rows 6, 7, 18 and 20)."""
    git = Git(repo)
    problem = app_setup_ok(con, git, origin_url(git))
    if problem:
        raise UsageError(f"{RESERVE_FAILED}: this session has no App git setup ({problem}); "
                         "no decision written. Start the session fresh with dispatch.sh.")
    k_main = main_block(git)
    tags = tag_numbers(git)
    k_store = max((block_of(n) for n in store_numbers(con)), default=-1)
    for _ in range(MAX_PUSHES):
        k_tag = max(tags, default=-1)  # tags is a dict: max() reads its keys
        k = 1 + max(k_tag, k_main, k_store, -1)
        if k > MAX_BLOCK:
            top = max(k_tag, k_main, k_store)
            source = "the tags" if top == k_tag else "main" if top == k_main else "the store"
            raise UsageError(f"{RESERVE_FAILED}: no block above {MAX_BLOCK} is free "
                             f"(the highest is from {source}).")
        sid = store_id(con)
        blob = git.must("hash-object", "-w", "--stdin", stdin=f"store {sid}\nblock {k}\n").strip()
        text = (f"object {blob}\ntype blob\ntag sofa-decision-block/{k}\n"
                f"tagger sofa-state <sofa-state@localhost> {int(time.time())} +0000\n\nstore {sid}\n")
        tag = git.must("hash-object", "-t", "tag", "-w", "--stdin", stdin=text).strip()
        rc, _, err = git.run("push", "origin", f"{tag}:{TAG_PREFIX}{k}")
        if rc == 0:
            return k
        # Another store may have taken block k. Read the tags again: a tag k there means yes.
        try:
            tags = tag_numbers(git)
        except UsageError:
            raise git.failure("push", rc, err) from None
        if tags.get(k) == tag:
            return k  # the push reached origin and the client saw a failure: the tag is ours
        if k not in tags:
            raise git.failure("push", rc, err)
    raise UsageError(f"{RESERVE_FAILED}: push: {MAX_PUSHES} blocks were taken while this store "
                     "reserved; no decision written. Try again in 1 minute.")


def claim_block(con, a):
    """Return the block that gives the next id, with the write transaction open (rows 8 and 12)."""
    for _ in range(3):
        block = stored_block(con)
        if (block is None or next_decision_id(con, block) is None) \
                and getattr(a, "reserved_block", None) is None:
            a.reserved_block = reserve_block(con, repo_of_store(a))
        # The write lock comes before the second read, so 2 sessions do not take the same id.
        con.execute("BEGIN IMMEDIATE")
        block = stored_block(con)
        if block is None or next_decision_id(con, block) is None:
            if getattr(a, "reserved_block", None) is None:
                con.rollback()
                continue
            block = a.reserved_block
            write_block(con, block)
        if next_decision_id(con, block) is not None:
            return block
        con.rollback()
        a.reserved_block = None
    raise UsageError("the block of this store filled 3 times while it reserved; "
                     "run the command again.")


def cmd_decision_log(con, a):
    """Record a decision and print its id. With no --id, take the next free id of the block."""
    if a.replace and not a.id:
        raise UsageError("--replace needs --id", code=2)
    if a.id is not None and not DECISION_ID_RE.fullmatch(a.id):
        raise UsageError("--id must be D- and 1 to 9 digits, for example D-042", code=2)
    if a.id:
        con.execute("BEGIN IMMEDIATE")
        decision_id = a.id
    else:
        decision_id = next_decision_id(con, claim_block(con, a))
    old = con.execute("SELECT story FROM decisions WHERE id = ?", (decision_id,)).fetchone()
    if old and not a.replace:
        raise UsageError(f"decision {decision_id} exists (story {old['story']}); give no --id "
                         "to take the next free id, or --replace to write over it", code=2)
    # Only --replace writes over a row. A plain insert fails on an id that exists.
    sql = INSERT_DECISION + (ON_ID_CONFLICT_UPDATE if a.replace else "")
    con.execute(sql, (decision_id, a.story, a.level, a.confidence, a.reversibility,
                      a.visibility, a.by, a.summary, a.at))
    con.commit()
    print(decision_id)


def check_tag(con, a, block):
    """`decision block --check`: does origin hold the tag of this block, made by this store?"""
    git = Git(repo_of_store(a))
    problem = app_setup_ok(con, git, origin_url(git))
    if problem:
        raise UsageError(f"{RESERVE_FAILED}: this session has no App git setup ({problem}); "
                         "no decision written. Start the session fresh with dispatch.sh.")
    name = f"{TAG_PREFIX}{block}"
    if not git.must("ls-remote", "--tags", "origin", name).strip():
        print("tag missing")
        raise Quiet("", code=1)
    ref = f"refs/sofa-state/check-{os.getpid()}-{secrets.token_hex(4)}"
    try:
        git.must("fetch", "--no-tags", "--no-write-fetch-head", "--refmap=", "origin", f"+{name}:{ref}")
        text = git.must("cat-file", "-p", f"{ref}^{{}}")
    finally:
        git.run("update-ref", "-d", ref)
    owner = text.splitlines()[0].removeprefix("store ") if text.startswith("store ") else "unknown"
    mine = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    if mine is None or owner != mine[0]:
        print(f"tag of store {owner}")
        raise Quiet("", code=1)
    print("tag ok")


def cmd_decision_block(con, a):
    """Print the block of this store. --reserve reserves one when no id is free; --check reads its tag."""
    block = stored_block(con)
    if a.reserve and (block is None or next_decision_id(con, block) is None):
        # `a` is the same object in each try of run_with_retry, so a lock after the push
        # does not push a second tag.
        if getattr(a, "reserved_block", None) is None:
            a.reserved_block = reserve_block(con, repo_of_store(a))
        con.execute("BEGIN IMMEDIATE")
        block = stored_block(con)
        if block is None or next_decision_id(con, block) is None:
            block = a.reserved_block
            write_block(con, block)
        con.commit()
    if block is None:
        print("no block")
        raise Quiet("", code=1)
    if a.check:
        return check_tag(con, a, block)
    first, last = block_range(block)
    free = next_decision_id(con, block)
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    print(f"block {block}: D-{first:03d} to D-{last:03d}, "
          f"{'full' if free is None else 'next ' + free}, store {row[0] if row else 'unknown'}")


def cmd_decision_veto(con, a):
    """Mark a decision as vetoed."""
    cur = con.execute("UPDATE decisions SET vetoed_at = ? WHERE id = ?", (a.at, a.id))
    con.commit()
    if cur.rowcount == 0:
        raise UsageError(f"no decision with id {a.id}")


def cmd_decision_list(con, a):
    """Print decisions, with filters on story and time."""
    sql, args = "SELECT * FROM decisions WHERE 1=1", []
    if a.story:
        sql += " AND story = ?"
        args.append(a.story)
    if a.since:
        sql += " AND at >= ?"
        args.append(a.since)
    rows = con.execute(sql + " ORDER BY at, id", args).fetchall()
    emit(rows, a.json, ["id", "story", "level", "confidence", "reversibility", "visibility",
                        "decided_by", "at", "vetoed_at", "summary"])


# --- asks ---

def cmd_ask_open(con, a):
    """Open an ask to hitl."""
    con.execute("INSERT INTO asks (id, story, priority, opened_at, closed_at) VALUES (?, ?, ?, ?, NULL) "
                "ON CONFLICT(id) DO UPDATE SET story = excluded.story, priority = excluded.priority",
                (a.id, a.story, a.priority, a.at))
    con.commit()


def cmd_ask_close(con, a):
    """Close an ask."""
    cur = con.execute("UPDATE asks SET closed_at = ? WHERE id = ? AND closed_at IS NULL", (a.at, a.id))
    con.commit()
    if cur.rowcount == 0:
        raise UsageError(f"no open ask with id {a.id}")


def cmd_ask_list(con, a):
    """Print all asks."""
    rows = con.execute("SELECT * FROM asks ORDER BY opened_at, id").fetchall()
    emit(rows, a.json, ["id", "story", "priority", "opened_at", "closed_at"])


# --- interactions, usage, queue, kv ---

def cmd_interaction_log(con, a):
    """Record one human interaction on a story."""
    con.execute("INSERT INTO interactions (story, kind, by_whom, at) VALUES (?, ?, ?, ?)",
                (a.story, a.kind, a.by, a.at))
    con.commit()


def cmd_usage_set(con, a):
    """Set the token count of a session on an item."""
    con.execute("INSERT INTO usage (session, item, tokens, at) VALUES (?, ?, ?, ?) "
                "ON CONFLICT(session, item) DO UPDATE SET tokens = excluded.tokens, at = excluded.at",
                (a.session, a.item, a.tokens, a.at))
    con.commit()


def cmd_queue_set(con, a):
    """Replace the queue with the given items, in order."""
    with con:
        con.execute("DELETE FROM queue")
        con.executemany("INSERT INTO queue (position, item) VALUES (?, ?)",
                        list(enumerate(a.items, start=1)))


def cmd_queue_list(con, a):
    """Print the queue, one item per line."""
    for row in con.execute("SELECT item FROM queue ORDER BY position"):
        print(row["item"])


def cmd_kv_set(con, a):
    """Set one key. A key that starts with `decision.` is written only by `decision log`."""
    if a.key.startswith("decision."):
        raise UsageError("a key that starts with decision. is written only by sofa-state "
                         "(the block of decision ids); do not set it by hand", code=2)
    con.execute("INSERT INTO kv (key, value) VALUES (?, ?) "
                "ON CONFLICT(key) DO UPDATE SET value = excluded.value", (a.key, a.value))
    con.commit()


def cmd_kv_get(con, a):
    """Print one value. Exit 1 when the key is not there."""
    row = con.execute("SELECT value FROM kv WHERE key = ?", (a.key,)).fetchone()
    if row is None:
        raise UsageError(f"no key {a.key}")
    print(row["value"])


# --- metrics, report, prune ---

def story_metrics(con, story):
    """Compute the metrics of one story."""
    one = lambda sql, *args: con.execute(sql, args).fetchone()[0]
    closed_asks = one("SELECT COUNT(*) FROM asks WHERE story = ? AND closed_at IS NOT NULL", story)
    ask_inter = one("SELECT COUNT(*) FROM interactions WHERE story = ? AND kind = 'ask'", story)
    item = con.execute("SELECT picked_up_at, released_at FROM items WHERE id = ?", (story,)).fetchone()
    picked = item["picked_up_at"] if item else None
    released = item["released_at"] if item else None
    cycle = None
    if picked and released:
        hours = (parse_iso(released) - parse_iso(picked)).total_seconds() / 3600
        cycle = round(hours, 1)
    return {
        "story": story,
        "hitl_questions": closed_asks + ask_inter,
        "autonomous_decisions": one("SELECT COUNT(*) FROM decisions WHERE story = ? "
                                    "AND decided_by != 'hitl' AND vetoed_at IS NULL", story),
        "review_defects": one("SELECT COUNT(*) FROM interactions WHERE story = ? AND kind = 'defect'", story),
        "trips": one("SELECT COUNT(*) FROM trips WHERE item = ?", story),
        "picked_up_at": picked,
        "released_at": released,
        "cycle_hours": cycle,
    }


def cmd_metrics(con, a):
    """Print the metrics of one story."""
    m = story_metrics(con, a.story)
    if a.json:
        print(json.dumps(m))
        return
    for key, value in m.items():
        print(f"{key}: {'' if value is None else value}")


def age(text, now):
    """Return a short age such as 5m or 2h, or '-' when there is no time."""
    dt = parse_iso(text)
    if dt is None:
        return "-"
    seconds = max(0, int((now - dt).total_seconds()))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


# The slug pattern of sofa-github (Values.slug) and the pattern of a GitHub login.
SLUG_RE = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,98}[A-Za-z0-9])?"
LOGIN_RE = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?"


def store_owner(con):
    """The instance and the bot of this store, from 2 keys. A missing value, or a value that does
    not match its pattern, gives None. It reads no other machine. key, so the report never shows
    the key path of the App."""
    def value(key, pattern):
        row = con.execute("SELECT value FROM kv WHERE key = ?", (key,)).fetchone()
        text = (row["value"] or "") if row else ""
        return text if re.fullmatch(pattern, text) else None
    slug = value("machine.github-app.slug", SLUG_RE)
    return value("machine.instance", LOGIN_RE), (f"{slug}[bot]" if slug else None)


def cmd_report(con, a):
    """Print the dashboard: the instance and the bot of the store, sessions, items, open asks, queue,
    recent decisions."""
    now = parse_iso(a.at)
    day_ago = (now - timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
    sessions = con.execute("SELECT * FROM sessions ORDER BY name").fetchall()
    items = con.execute("SELECT * FROM items ORDER BY id").fetchall()
    asks = con.execute("SELECT * FROM asks WHERE closed_at IS NULL ORDER BY opened_at").fetchall()
    queue = [r["item"] for r in con.execute("SELECT item FROM queue ORDER BY position")]
    decisions = con.execute("SELECT * FROM decisions WHERE at >= ? ORDER BY at", (day_ago,)).fetchall()
    instance, bot = store_owner(con)
    if a.json:
        print(json.dumps({
            "instance": instance,
            "bot": bot,
            "sessions": [dict(r, heartbeat_age=age(r["last_heartbeat"], now)) for r in sessions],
            "items": [dict(r) for r in items],
            "open_asks": [dict(r) for r in asks],
            "queue": queue,
            "decisions_24h": [dict(r) for r in decisions],
        }))
        return
    print(f"instance {instance or '?'} · bot {bot or '?'}")
    print("\nsessions")
    table([[s["name"], s["role"], s["state"], s["item"], age(s["last_heartbeat"], now)] for s in sessions],
          ["name", "role", "state", "item", "beat"])
    print("\nitems")
    table([[i["id"], i["state"], i["pr"], i["session"], i["waits_for"]] for i in items],
          ["id", "state", "pr", "session", "waits"])
    print("\nopen asks")
    table([[k["id"], k["story"], k["priority"], age(k["opened_at"], now)] for k in asks],
          ["id", "story", "prio", "age"])
    print("\nqueue")
    print("  " + (" ".join(queue) if queue else "(empty)"))
    print("\ndecisions (24h)")
    table([[d["id"], d["story"], d["decided_by"], "veto" if d["vetoed_at"] else "", d["summary"]]
           for d in decisions], ["id", "story", "by", "veto", "summary"])


def cmd_prune(con, a):
    """Remove heartbeats and messages older than N days."""
    limit = (parse_iso(a.at) - timedelta(days=a.days)).strftime("%Y-%m-%dT%H:%M:%SZ")
    with con:
        con.execute("DELETE FROM heartbeats WHERE at < ?", (limit,))
        con.execute("DELETE FROM messages WHERE at < ?", (limit,))


# --- snapshot ---
# `snapshot take` writes 1 versioned, scrubbed JSON snapshot of the line (STORY-443). Each view of the
# floor reads this and nothing else, so no view can leak a value that it did not get.
#
# How a later story adds data and keeps SCHEMA_VERSION at 1: it adds a new top-level section or a new field of
# a row, with its form, to SNAPSHOT_FIELDS (or RULE_FIELDS, for a field of a rule set), and 1 new key or field
# of `build_snapshot`. A story that removes or renames a key, or changes the meaning or the type of a value,
# adds 1 to SCHEMA_VERSION. A reader ignores a key that it does not know, and a reader that gets a higher
# number judges nothing in that line.

SCHEMA_VERSION = 1
FLOOR_CONFIG = os.path.join(".claude", "sofa-floor.json")
FLOOR_MAX_BYTES = 262144
FLOOR_SETS = ["health", "streams", "prices"]

_NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}")
_ROLE = re.compile(r"[a-z][a-z0-9-]{0,39}")
_MODEL = re.compile(r"[a-z0-9][a-z0-9.\[\]-]{0,63}")
_STATE = re.compile(r"[a-z][a-z _-]{0,31}")
_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,79}")
_TIME = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
_PR = re.compile(r"[0-9]{1,9}")
_UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.IGNORECASE)
_LEVEL, _CONFIDENCE = set(DECISION_LEVELS), set(DECISION_CONFIDENCES)
_REVERSIBILITY, _VISIBILITY = set(DECISION_REVERSIBILITIES), set(DECISION_VISIBILITIES)

# A section of the snapshot: the query of cmd_report, and each field that may go into it with its form (a regex,
# fullmatch, or a set of words). A field that is not here goes nowhere: only a list of allowed fields is safe,
# because the free-text columns (waits_for, summary) and the person columns (decided_by, by_whom) hold any text.
SNAPSHOT_FIELDS: dict[str, tuple[str, dict]] = {
    "sessions": ("SELECT * FROM sessions ORDER BY name", {
        "name": _NAME, "role": _ROLE, "model": _MODEL, "state": _STATE, "item": _ID,
        "since": _TIME, "last_heartbeat": _TIME, "free_since": _TIME}),
    "items": ("SELECT * FROM items ORDER BY id", {
        "id": _ID, "state": _STATE, "pr": _PR, "session": _NAME,
        "picked_up_at": _TIME, "released_at": _TIME, "updated_at": _TIME}),
    "open_asks": ("SELECT * FROM asks WHERE closed_at IS NULL ORDER BY opened_at", {
        "id": _ID, "story": _ID, "priority": _STATE, "opened_at": _TIME}),
    "decisions_24h": ("SELECT * FROM decisions WHERE at >= ? ORDER BY at", {
        "id": _ID, "story": _ID, "level": _LEVEL, "confidence": _CONFIDENCE,
        "reversibility": _REVERSIBILITY, "visibility": _VISIBILITY, "at": _TIME, "vetoed_at": _TIME}),
}
# The fields of each rule set that may go into the key `rules`. The story that owns a field adds it here with its
# form (D-7032, CONSTRAINT-01). `health.snapshot_max_age_seconds` (STORY-444, D-7199) is the age in seconds after
# which a reader marks the snapshot of a line as old: a whole number from 60 to 86400.
SNAPSHOT_MAX_AGE = range(60, 86401)
RULE_FIELDS: dict[str, dict] = {name: {} for name in FLOOR_SETS}
RULE_FIELDS["health"]["snapshot_max_age_seconds"] = SNAPSHOT_MAX_AGE
# The label of a line (the key line.label of the store): the name that a view shows for the line (STORY-444).
_LABEL = re.compile(r"[a-z0-9][a-z0-9-]{0,31}")
_STORE_ID = re.compile(r"[0-9a-f]{16}")

# The names that may go into the place (WHERE) of a guard message: each key that build_snapshot writes. A key of a
# dict that is not here comes from data (the store or the file), so it never goes into a message (STORY-485). A story
# that adds a section, a key or a field adds its name here, in the same change. Each name is a word of the script:
# a key that comes from data (a login, a path, a work order) is never added here.
WHERE_NAMES = frozenset({
    "schema_version", "taken_at", "line", "store", "label", "queue", "rules", "rules_digest", "nulled",
    *SNAPSHOT_FIELDS, *(f for _, fields in SNAPSHOT_FIELDS.values() for f in fields),
    *FLOOR_SETS, *(f for fields in RULE_FIELDS.values() for f in fields),
})

GUARD_MIN_CHARS = 4


class Scrubber:
    """Keep a value only when it has the form of its field, and count each value that it replaces."""

    def __init__(self):
        self.nulled = 0

    def value(self, form, value):
        """FORM is a regex (fullmatch), a set of words, or a `range` (a whole number inside it; a boolean and a
        float are no whole number)."""
        if value is None:
            return None
        if isinstance(form, range):
            ok = type(value) is int and value in form
        else:
            ok = isinstance(value, str) and (value in form if isinstance(form, set) else form.fullmatch(value))
        if ok:
            return value
        self.nulled += 1
        return None


def read_floor_config(path):
    """Read and check the floor configuration. Return its 3 rule sets. Raise UsageError (exit 1)."""
    where = f"the floor configuration {path}"
    if not os.path.exists(path):
        raise UsageError(f"no floor configuration: {path} does not exist; create it with the keys "
                         "schema_version (1), health, streams and prices")
    try:
        with open(path, "rb") as f:
            raw = f.read(FLOOR_MAX_BYTES + 1)
    except OSError as e:
        raise UsageError(f"{where} cannot be read: {e.strerror or type(e).__name__}") from None
    if len(raw) > FLOOR_MAX_BYTES:
        raise UsageError(f"{where} is over {FLOOR_MAX_BYTES} bytes")
    try:
        data = json.loads(raw)
    except (ValueError, RecursionError) as e:
        raise UsageError(f"{where} is not JSON: {e if isinstance(e, json.JSONDecodeError) else type(e).__name__}") from None
    if not isinstance(data, dict):
        raise UsageError(f"{where}: the top level is not a JSON object")
    for key in ["schema_version"] + FLOOR_SETS:
        if key not in data:
            raise UsageError(f"{where}: {key} is missing")
    if type(data["schema_version"]) is not int or data["schema_version"] != 1:
        raise UsageError(f"{where}: schema_version is not 1")
    for key in FLOOR_SETS:
        if not isinstance(data[key], dict):
            raise UsageError(f"{where}: {key} is not a JSON object")
    for key in data:
        if key != "schema_version" and key not in FLOOR_SETS:
            raise UsageError(f"{where}: {key} is not a key of the file")
    return {key: data[key] for key in FLOOR_SETS}


def dump(obj, ascii_only=True):
    """The one JSON text of this module: sorted keys, no space, so the same state gives the same text."""
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=ascii_only)


def build_snapshot(con, sets, at, store):
    """Return the snapshot of version 1 as a dict. SETS are the rule sets as read from the file.

    The caller has an open read transaction (`cmd_snapshot_take`), so all sections show 1 state of the store.
    """
    scrub = Scrubber()
    day_ago = (parse_iso(at) - timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
    # The label is the key line.label of the store; a store with no such key gets line-<6 hex digits of its id>.
    row = con.execute("SELECT value FROM kv WHERE key = 'line.label'").fetchone()
    label = scrub.value(_LABEL, row[0] if row else f"line-{store[:6]}")
    snap = {"schema_version": SCHEMA_VERSION, "taken_at": at, "line": {"store": store, "label": label}}
    for section, (query, fields) in SNAPSHOT_FIELDS.items():
        rows = con.execute(query, (day_ago,) if "?" in query else ()).fetchall()
        snap[section] = [{f: scrub.value(form, r[f]) for f, form in fields.items()} for r in rows]
    snap["queue"] = [scrub.value(_ID, r["item"])
                     for r in con.execute("SELECT item FROM queue ORDER BY position")]
    snap["rules"] = {name: {f: scrub.value(form, sets[name][f]) for f, form in RULE_FIELDS[name].items()
                            if f in sets[name]} for name in FLOOR_SETS}
    snap["rules_digest"] = "sha256:" + hashlib.sha256(dump(sets).encode()).hexdigest()
    snap["nulled"] = scrub.nulled
    return snap


def private_values(con, db_path_arg):
    """The values that no snapshot may hold, as a list of (kind, value). A value under 4 characters is left out."""
    found = []

    def add(kind, values):
        found.extend((kind, v.strip()) for v in values if isinstance(v, str) and len(v.strip()) >= GUARD_MIN_CHARS)

    # A session id that is its own name is no secret: the name goes into the snapshot on purpose. A real store holds
    # such a row (a stopped session that was written by hand), and it would stop the snapshot each time. An id of the
    # form of a UUID is a real session id (issue 2097), so it stays on the list also when it is its own name.
    add("a session id", [sid for sid, name in con.execute("SELECT id, name FROM sessions")
                         if (sid or "").strip() != (name or "").strip() or _UUID.fullmatch((sid or "").strip())])
    paths = [r[0] for r in con.execute("SELECT worktree FROM items")]
    paths.append(os.environ.get("HOME"))
    paths.append(os.path.realpath(os.path.dirname(os.path.abspath(db_path_arg))))
    try:
        paths.append(main_folder())
    except (subprocess.CalledProcessError, OSError):
        pass
    add("a path", paths)
    logins = []
    for (who,) in con.execute("SELECT decided_by FROM decisions UNION ALL SELECT by_whom FROM interactions"):
        m = re.fullmatch(r"human:(.+)", who or "", re.DOTALL)
        if m:
            logins.append(m.group(1))
    add("a person login", logins)
    add("a machine value", [r[0] for r in con.execute("SELECT value FROM kv WHERE key LIKE 'machine.%'")])
    return found


def _texts(obj, where, found, extend):
    """Add each text of OBJ (a parsed JSON value) to FOUND as (where, text): each key of a dict, each string, and the
    text of each number. A boolean and null have no text of a value, so they are left out.

    WHERE of a key is the path of its dict, and WHERE of a value is its own path (a list adds nothing). A key adds a
    part to the path of its value only when the path is still open and the text of the key is in WHERE_NAMES. Below
    any other key, the path stops: that value and each node under it get the path of the dict, so no key of the store
    or of the file goes into a message (STORY-485). When EXTEND is false, the path is closed from the start, because
    the keys of that OBJ come from the file.
    """
    stack = [(where, obj, extend)]
    while stack:
        path, node, grows = stack.pop()
        if isinstance(node, dict):
            found.extend((path, str(k)) for k in node)
            for k, v in node.items():
                name = str(k)
                if grows and name in WHERE_NAMES:
                    stack.append((f"{path}.{name}" if path else name, v, True))
                else:
                    stack.append((path, v, False))
        elif isinstance(node, list):
            stack.extend((path, v, grows) for v in node)
        elif isinstance(node, str):
            found.append((path, node))
        elif isinstance(node, (int, float)) and not isinstance(node, bool):
            found.append((path, str(node)))


def snapshot_strings(snap, sets):
    """Each text that goes into the snapshot, or that the file holds in a rule set, as (where, text).

    This is the full JSON text of spec row 10: the keys, the strings and the numbers of the snapshot and of the rule
    sets. WHERE is a path of names of `WHERE_NAMES` (`items.id`; a key adds its dict), or `the snapshot`, or `the
    floor configuration set <name>`. WHERE holds only names of `WHERE_NAMES`: a key of the store or of the file adds a
    part only when its text is such a name, and below any other key the path stops, so no other text of the store or
    of the file goes into WHERE.
    """
    found = []
    _texts(snap, "", found, True)
    for name in FLOOR_SETS:
        _texts(sets[name], f"the floor configuration set {name}", found, False)
    return [(where or "the snapshot", text) for where, text in found]


def guard_snapshot(con, a, snap, sets, code=1):
    """Fail closed: stop when the snapshot, or a rule set of the file, holds a known private value (any letter case).

    The rule sets are read too, because version 1 copies none of their fields into the snapshot, so a path in the
    file would not show in the snapshot, and the file is the place where an operator can write one. The message names
    the kind and where the value is (never the value), so the operator can find it.
    """
    strings = [(where, s.casefold()) for where, s in snapshot_strings(snap, sets)]
    for kind, value in private_values(con, a.db_path):
        needle = value.casefold()
        where = sorted({w for w, s in strings if needle in s})
        if where:
            raise UsageError(f"the snapshot holds {kind}; no snapshot written (in {', '.join(where[:5])})", code=code)


def write_atomic(path, text):
    """Write TEXT to PATH through a temporary file in the same folder, so a reader sees all of it or none."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)), prefix=".snapshot-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
        tmp = None
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def snapshot_text(con, a, code):
    """The snapshot text of this line (rows 3 to 5 and 15): read the floor configuration, take the store id, then
    build and guard the snapshot in 1 read transaction. CODE is the exit code of a refusal of the guard."""
    path = a.config
    if not path:
        try:
            path = os.path.join(main_folder(), FLOOR_CONFIG)
        except (subprocess.CalledProcessError, OSError):
            raise UsageError("not in a git repository; give --config") from None
    sets = read_floor_config(path)
    store = store_id(con)  # a write only when the store has no id yet: it commits at once
    # 1 read transaction for each read below (WAL): the sections and the guard show 1 state of the store, also when
    # another session writes while this command runs.
    con.execute("BEGIN")
    try:
        snap = build_snapshot(con, sets, a.at, store)
        guard_snapshot(con, a, snap, sets, code=code)
        return dump(snap) + "\n", snap
    except RecursionError:
        raise UsageError("the floor configuration is nested too deep; no snapshot written") from None
    finally:
        con.rollback()


def cmd_snapshot_take(con, a):
    """Write 1 scrubbed snapshot of this line as JSON, to stdout or to --out."""
    text, _ = snapshot_text(con, a, 1)
    if a.out:
        write_atomic(a.out, text)
    else:
        sys.stdout.write(text)


# --- snapshot publish and snapshot lines (STORY-444) ---
# Each line pushes its snapshot to 1 ref of origin, `refs/sofa-floor/<store id>`, and a reader gets the snapshot of
# each line from the refs. The ref holds 1 commit with no parent, so a new snapshot replaces the old one (ADR-0012,
# ADR-0013). The only forced push of the team is the push of the own ref with an explicit old id (rule 24).
FLOOR_REF = "refs/sofa-floor/"
READ_FAILED = "cannot read the lines"
READ_TMP = "refs/sofa-state/floor-"
LINE_MAX_BYTES = 1048576
SNAPSHOT_FILE = "snapshot.json"


def remote_old(git, ref):
    """The object id that REF has on origin, or an empty text when origin has no such ref."""
    for row in git.must("ls-remote", "origin", ref).splitlines():
        oid, _, name = row.partition("\t")
        if name.strip() == ref:
            return oid.strip()
    return ""


def make_snapshot_commit(git, text, taken_at):
    """Write the commit of the snapshot into the object store of the repository and return its id: the file
    snapshot.json (mode 100644), a tree with that 1 entry, no parent, and the identity sofa-state (never the identity
    of the person), the date TAKEN_AT, the message `snapshot <taken_at>`."""
    blob = git.must("hash-object", "-w", "--stdin", stdin=text).strip()
    tree = git.must("mktree", stdin=f"100644 blob {blob}\t{SNAPSHOT_FILE}\n").strip()
    stamp = f"{int(parse_iso(taken_at).timestamp())} +0000"
    who = {"GIT_AUTHOR_NAME": "sofa-state", "GIT_AUTHOR_EMAIL": "sofa-state@localhost", "GIT_AUTHOR_DATE": stamp,
           "GIT_COMMITTER_NAME": "sofa-state", "GIT_COMMITTER_EMAIL": "sofa-state@localhost",
           "GIT_COMMITTER_DATE": stamp}
    return git.must("-c", "commit.gpgsign=false", "commit-tree", tree, "-m", f"snapshot {taken_at}",
                    extra=who).strip()


def cmd_snapshot_publish(con, a):
    """Push the scrubbed snapshot of this line to refs/sofa-floor/<store id> on origin (rows 3 to 8, 15 and 19)."""
    text, snap = snapshot_text(con, a, 3)  # a config error and a refusal of the guard stop before the first git call
    if not has_app_values(con):
        raise UsageError(f"{PUBLISH_FAILED}: the store has no App values; run /sofa:setup")
    git = Git(repo_of_store(a, PUBLISH_FAILED), failed=PUBLISH_FAILED, tail=PUBLISH_TAIL, short=PUBLISH_TAIL)
    problem = app_setup_ok(con, git, origin_url(git))
    if problem:
        raise UsageError(f"{PUBLISH_FAILED}: this session has no App git setup ({problem}); {PUBLISH_TAIL}")
    ref = f"{FLOOR_REF}{snap['line']['store']}"
    commit = make_snapshot_commit(git, text, snap["taken_at"])
    old = remote_old(git, ref)
    for attempt in (1, 2):
        # The lease names the old id that we read, so another publish of this store between the read and the push
        # makes git refuse (an empty old id means that the ref must not exist).
        rc, _, err = git.run("push", "origin", f"--force-with-lease={ref}:{old}", f"{commit}:{ref}")
        if rc == 0:
            print(f"published {ref} {snap['taken_at']}")
            return
        new = remote_old(git, ref)
        if attempt == 2 or new == old:
            raise git.failure("push", rc, err)
        old = new  # the lease was stale: read again and push 1 more time


def cmd_snapshot_lines(con, a):
    """Print the snapshot of each line on origin as JSON (rows 10 to 13)."""
    git = Git(repo_of_store(a, READ_FAILED), failed=READ_FAILED, tail="", short="")
    origin_url(git)  # origin must have 1 URL; no App check, so a session with no App values reads the lines too
    read_at = a.now or now_iso()
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    own = row[0] if row else None  # a read: this command writes no store id
    lines = []
    if git.must("ls-remote", "origin", FLOOR_REF + "*").strip():
        tmp = f"{READ_TMP}{os.getpid()}-{secrets.token_hex(4)}"
        try:
            git.must("fetch", "--no-tags", "--no-write-fetch-head", "--refmap=", "origin",
                     f"+{FLOOR_REF}*:{tmp}/*")
            names = git.must("for-each-ref", "--format=%(refname)", f"{tmp}/").split()
            for name in sorted(names):
                store = name[len(tmp) + 1:]
                if _STORE_ID.fullmatch(store):
                    lines.append(read_line(git, name, store, read_at, own))
        finally:
            # Only local refs go: the temporary refs of this run (never a ref of origin).
            for name in git.run("for-each-ref", "--format=%(refname)", f"{tmp}/")[1].split():
                git.run("update-ref", "-d", name)
    lines.sort(key=lambda line: (line["label"] is None, line["label"] or "", line["store"]))
    sys.stdout.write(dump({"lines": lines, "read_at": read_at}) + "\n")


def read_line(git, name, store, read_at, own):
    """The line of the ref NAME (the temporary copy of refs/sofa-floor/STORE): its snapshot, or the reason that no
    snapshot is there. The text comes from another machine, so it is data: a bad line gives an error, never a stop."""
    line = {"store": store, "label": None, "taken_at": None, "age_seconds": None, "old": None,
            "own": store == own, "schema_version": None, "snapshot": None, "error": None}

    def bad(message):
        line["error"] = message
        return line

    rc, size, _ = git.run("cat-file", "-s", f"{name}:{SNAPSHOT_FILE}")
    if rc != 0:
        return bad(f"the ref has no {SNAPSHOT_FILE}")
    if int(size.strip()) > LINE_MAX_BYTES:
        return bad(f"the snapshot is over {LINE_MAX_BYTES} bytes")
    rc, text, _ = git.run("cat-file", "blob", f"{name}:{SNAPSHOT_FILE}")
    if rc != 0:
        return bad(f"the ref has no {SNAPSHOT_FILE}")
    try:
        snap = json.loads(text)
    except (ValueError, RecursionError):
        return bad("the snapshot is not JSON")
    if not isinstance(snap, dict):
        return bad("the snapshot is not 1 JSON object")
    version = snap.get("schema_version")
    if type(version) is not int:
        return bad("schema_version is not a whole number")
    line["schema_version"] = version
    if version > SCHEMA_VERSION:
        return bad(f"unknown schema {version}")
    taken = snap.get("taken_at")
    try:
        taken_dt = parse_iso(taken) if isinstance(taken, str) and _TIME.fullmatch(taken) else None
    except ValueError:
        taken_dt = None
    if taken_dt is None:
        return bad("taken_at is not a time of the form YYYY-MM-DDTHH:MM:SSZ")
    info = snap.get("line") if isinstance(snap.get("line"), dict) else {}
    named = info.get("store")
    if named != store:
        return bad(f"the snapshot names store {named}" if isinstance(named, str) and _STORE_ID.fullmatch(named)
                   else "the snapshot names no store of the form of a store id")
    label = info.get("label")
    line["label"] = label if isinstance(label, str) and _LABEL.fullmatch(label) else None
    line["taken_at"] = taken
    line["age_seconds"] = age = max(0, int((parse_iso(read_at) - taken_dt).total_seconds()))
    rules = snap.get("rules") if isinstance(snap.get("rules"), dict) else {}
    health = rules.get("health") if isinstance(rules.get("health"), dict) else {}
    limit = health.get("snapshot_max_age_seconds")
    line["old"] = age > limit if type(limit) is int and limit in SNAPSHOT_MAX_AGE else None
    line["snapshot"] = snap
    return line


# --- output helpers ---

def table(rows, header, width=28):
    """Print rows as aligned text columns. Each cell is cut at WIDTH."""
    if not rows:
        print("  (none)")
        return
    cells = [[("" if c is None else str(c))[:width] for c in r] for r in [header] + rows]
    widths = [max(len(r[i]) for r in cells) for i in range(len(header))]
    for r in cells:
        print("  " + "  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())


def emit(rows, as_json, columns):
    """Print rows as JSON or as a text table with the given columns."""
    if as_json:
        print(json.dumps([dict(r) for r in rows]))
        return
    table([[r[c] for c in columns] for r in rows], columns)


# --- argument parsing ---

def build_parser():
    """Build the argparse tree. --db and --at are accepted before and after the command words."""
    def add_common(parser, default):
        parser.add_argument("--db", default=default,
                            help="database path (else $SOFA_STATE_DB, else <main folder>/.sofa/state.db)")
        parser.add_argument("--at", type=norm_iso, default=default,
                            help="time to record, ISO-8601 (default: now, UTC)")

    # SUPPRESS on the leaf copy keeps a value given before the command words.
    common = argparse.ArgumentParser(add_help=False)
    add_common(common, argparse.SUPPRESS)

    p = argparse.ArgumentParser(prog="sofa-state", description="The SQLite state store of sofa.")
    add_common(p, None)
    top = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    def leaf(parent, name, func, help_text):
        sp = parent.add_parser(name, parents=[common], help=help_text, description=help_text)
        sp.set_defaults(func=func)
        return sp

    def group(name, help_text):
        g = top.add_parser(name, help=help_text, description=help_text)
        return g.add_subparsers(dest="sub", required=True, metavar="ACTION")

    leaf(top, "init", lambda con, a: None, "create the schema when it is not there")

    s = group("session", "sessions of the fleet")
    sp = leaf(s, "upsert", cmd_session_upsert, "insert or update a session")
    sp.add_argument("--name", required=True)
    sp.add_argument("--id", required=True)
    sp.add_argument("--role", required=True)
    sp.add_argument("--model")
    sp.add_argument("--state", choices=["live", "stopped"],
                    help="live on insert when omitted; kept on update when omitted")
    sp.add_argument("--item", help="item the session works on; clears free_since")
    sp = leaf(s, "free", cmd_session_free, "set the item to NULL and free_since to now")
    sp.add_argument("--name", required=True)
    sp = leaf(s, "colour", cmd_session_colour, "record the colour that /color set in the session")
    sp.add_argument("--name", required=True)
    sp.add_argument("--colour", required=True)
    sp = leaf(s, "heartbeat", cmd_session_heartbeat, "record a heartbeat")
    sp.add_argument("--name", required=True)
    sp = leaf(s, "list", cmd_session_list, "print all sessions")
    sp.add_argument("--json", action="store_true")

    i = group("item", "work items (stories, features)")
    sp = leaf(i, "set", cmd_item_set, "insert or update an item; an empty value clears a field")
    sp.add_argument("--id", required=True)
    sp.add_argument("--state", required=True)
    sp.add_argument("--pr")
    sp.add_argument("--branch")
    sp.add_argument("--worktree")
    sp.add_argument("--waits-for", dest="waits_for")
    sp.add_argument("--session")
    sp = leaf(i, "trip", cmd_item_trip, "record a hand-over between two roles")
    sp.add_argument("--id", required=True)
    sp.add_argument("--from", dest="from_role", required=True)
    sp.add_argument("--to", dest="to_role", required=True)

    m = group("message", "message headers")
    sp = leaf(m, "log", cmd_message_log, "record a message header (never the body)")
    sp.add_argument("--type", required=True)
    sp.add_argument("--from", dest="from_name", required=True)
    sp.add_argument("--to", dest="to_name", required=True)
    sp.add_argument("--subject", required=True)

    d = group("decision", "decisions per story")
    sp = leaf(d, "log", cmd_decision_log, "record a decision and print its id")
    sp.add_argument("--id", help="the id; with no --id, the next free D-<n>")
    sp.add_argument("--replace", action="store_true", help="write over the decision with this --id")
    sp.add_argument("--story", required=True)
    # The 4 values of the decision tables of docs/adlc.md, section 4. A value outside
    # the list exits 2 and writes nothing, so the digest and the band audit can read each row.
    sp.add_argument("--level", required=True, choices=DECISION_LEVELS)
    sp.add_argument("--confidence", required=True, choices=DECISION_CONFIDENCES)
    sp.add_argument("--reversibility", required=True, choices=DECISION_REVERSIBILITIES)
    sp.add_argument("--visibility", required=True, choices=DECISION_VISIBILITIES)
    sp.add_argument("--by", required=True, help="who decided, for example decision-judge or hitl")
    sp.add_argument("--summary", required=True)
    sp = leaf(d, "block", cmd_decision_block, "print the block of decision ids of this store")
    sp.add_argument("--reserve", action="store_true", help="reserve a block when no id is free")
    sp.add_argument("--check", action="store_true", help="check that origin holds the tag of the block")
    sp = leaf(d, "veto", cmd_decision_veto, "mark a decision as vetoed")
    sp.add_argument("--id", required=True)
    sp = leaf(d, "list", cmd_decision_list, "print decisions")
    sp.add_argument("--story")
    sp.add_argument("--since", type=norm_iso, help="ISO-8601 lower bound")
    sp.add_argument("--json", action="store_true")

    k = group("ask", "asks to hitl")
    sp = leaf(k, "open", cmd_ask_open, "open an ask")
    sp.add_argument("--id", required=True)
    sp.add_argument("--story", required=True)
    sp.add_argument("--priority", required=True)
    sp = leaf(k, "close", cmd_ask_close, "close an ask")
    sp.add_argument("--id", required=True)
    sp = leaf(k, "list", cmd_ask_list, "print all asks")
    sp.add_argument("--json", action="store_true")

    n = group("interaction", "human interactions per story")
    sp = leaf(n, "log", cmd_interaction_log, "record one interaction")
    sp.add_argument("--story", required=True)
    sp.add_argument("--kind", required=True, choices=INTERACTION_KINDS)
    sp.add_argument("--by", required=True)

    u = group("usage", "tokens per session per item")
    sp = leaf(u, "set", cmd_usage_set, "set the token count")
    sp.add_argument("--session", required=True)
    sp.add_argument("--item", required=True)
    sp.add_argument("--tokens", required=True, type=int)

    q = group("queue", "the item queue")
    sp = leaf(q, "set", cmd_queue_set, "replace the queue")
    sp.add_argument("items", nargs="*", metavar="ITEM")
    leaf(q, "list", cmd_queue_list, "print the queue in order")

    v = group("kv", "key-value pairs")
    sp = leaf(v, "set", cmd_kv_set, "set a key")
    sp.add_argument("key")
    sp.add_argument("value")
    sp = leaf(v, "get", cmd_kv_get, "print a value; exit 1 when the key is not there")
    sp.add_argument("key")

    sp = leaf(top, "metrics", cmd_metrics, "print the metrics of one story")
    sp.add_argument("--story", required=True)
    sp.add_argument("--json", action="store_true")

    sp = leaf(top, "report", cmd_report, "print the dashboard tables")
    sp.add_argument("--json", action="store_true")

    sn = group("snapshot", "the scrubbed snapshot of this line")
    sp = leaf(sn, "take", cmd_snapshot_take, "write 1 scrubbed snapshot of this line as JSON")
    sp.add_argument("--config", help=f"the floor configuration (default: <main folder>/{FLOOR_CONFIG})")
    sp.add_argument("--out", help="write the snapshot to this file, not to stdout")
    sp.set_defaults(lock_tries=1, locked="the store is locked by another writer; no snapshot written")

    sp = leaf(sn, "publish", cmd_snapshot_publish, "push the scrubbed snapshot of this line to its ref on origin")
    sp.add_argument("--config", help=f"the floor configuration (default: <main folder>/{FLOOR_CONFIG})")
    sp.set_defaults(lock_tries=1,
                    locked=f"{PUBLISH_FAILED}: the store is locked by another writer; {PUBLISH_TAIL}")

    sp = leaf(sn, "lines", cmd_snapshot_lines, "print the snapshot of each line on origin as JSON")
    sp.add_argument("--now", type=norm_iso, help="the time of the read, ISO-8601 (default: now, UTC)")

    sp = leaf(top, "prune", cmd_prune, "remove heartbeats and messages older than N days")
    sp.add_argument("--days", required=True, type=int)
    return p


LOCK_TRIES = 25


def run_with_retry(a):
    """Open the database and run the command. Try again when the database is locked.

    The busy timeout covers most waits. It does not cover the moment the file is
    created: until WAL is on, SQLite can return "locked" at once to avoid a
    deadlock between two connections in rollback mode. Each command commits only
    at its end, so a new try does not write a row twice.
    """
    path = a.db_path = db_path(a.db)
    # A leaf may set lock_tries and locked (the output line of its stop): `snapshot take` and `snapshot publish`
    # make 1 try, so they stop at the first "database is locked" error, after the busy timeout of open_db.
    tries = getattr(a, "lock_tries", LOCK_TRIES)
    for n in range(tries):
        try:
            con = open_db(path)
            try:
                a.func(con, a)
                return
            finally:
                con.close()
        except sqlite3.OperationalError as e:
            locked = "locked" in str(e) or "busy" in str(e)
            if not locked:
                raise
            if n == tries - 1:
                if getattr(a, "locked", None):
                    raise UsageError(a.locked) from None
                raise
            time.sleep(random.uniform(0.02, 0.1 * (n + 1)))


def main(argv=None):
    """Run one command. Return the exit code."""
    a = build_parser().parse_args(argv)
    if a.at is None:
        a.at = now_iso()
    try:
        run_with_retry(a)
    except UsageError as e:
        if not isinstance(e, Quiet):
            print(f"sofa-state: {e}", file=sys.stderr)
        return e.code
    except subprocess.CalledProcessError:
        print("sofa-state: not in a git repository; give --db or set SOFA_STATE_DB", file=sys.stderr)
        return 1
    except (sqlite3.Error, OSError) as e:
        print(f"sofa-state: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
