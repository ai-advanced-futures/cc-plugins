#!/usr/bin/env python3
"""sofa-state: the SQLite state store of sofa.

Many sessions write at the same time, so the database runs in WAL mode with a
busy timeout. Each command creates the schema when it is not there.

Database path: --db PATH, else $SOFA_STATE_DB, else <main folder>/.sofa/state.db.
Exit code: 0 on success; 2 on a bad argument (argparse), when `decision log` refuses
its arguments, when `kv set` gets a key that starts with `decision.` or `rows.retired.`, when `item set` refuses
its input (an id that is not in the form of an item id, a state that is not in the list, a new row with no
`--state`, a closed row that opens again with no `--reopen`, a `--session` that is not a name of the caller,
the work order of another session with no `--take-over`, `--take-over` with no `--session`, or a work order
with no holder), when
SOFA_GIT_TIMEOUT is not a number greater than 0 (read at the first git call, so a command
that makes no git call does not read it; the 4 leaves `item remove`, `item rename`, `session remove`
and `session rename` read it before the lock), and when a `--to` of `item rename` or `session rename`
does not have the form of its key; 3 when `snapshot publish` refuses a snapshot because the guard
found a private value (nothing is pushed; `snapshot take` keeps exit 1 for the same output line); 1 on all other errors, also when
a leaf of `item remove`, `item rename`, `session remove` or `session rename` refuses a change of a row (STORY-503), and when
`decision log` cannot reserve a block of decision ids (see "decisions" below); also on
`snapshot take` when the floor configuration is missing or wrong, and when the snapshot or a rule set of the
file would hold a known private value (a session id, a path, a person login or a machine value).
"""

import argparse
import copy
import hashlib
import json
import math
import os
import random
import re
import secrets
import shlex
import shutil
import signal
import sqlite3
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone

SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions (
    name TEXT PRIMARY KEY, id TEXT, role TEXT, model TEXT,
    state TEXT, item TEXT, since TEXT, last_heartbeat TEXT, free_since TEXT,
    colour TEXT);
CREATE TABLE IF NOT EXISTS items (
    id TEXT PRIMARY KEY, state TEXT, pr TEXT, branch TEXT, worktree TEXT,
    waits_for TEXT, session TEXT, picked_up_at TEXT, released_at TEXT, updated_at TEXT);
CREATE TABLE IF NOT EXISTS trips (
    id INTEGER PRIMARY KEY AUTOINCREMENT, item TEXT, from_role TEXT, to_role TEXT, at TEXT);
CREATE TABLE IF NOT EXISTS messages (
    id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, from_name TEXT, to_name TEXT,
    subject TEXT, at TEXT);
CREATE TABLE IF NOT EXISTS decisions (
    id TEXT PRIMARY KEY, story TEXT, level TEXT, confidence TEXT, reversibility TEXT,
    visibility TEXT, decided_by TEXT, summary TEXT, at TEXT, vetoed_at TEXT);
CREATE TABLE IF NOT EXISTS interactions (
    id INTEGER PRIMARY KEY AUTOINCREMENT, story TEXT, kind TEXT, by_whom TEXT, at TEXT);
CREATE TABLE IF NOT EXISTS asks (
    id TEXT PRIMARY KEY, story TEXT, priority TEXT, opened_at TEXT, closed_at TEXT);
CREATE TABLE IF NOT EXISTS usage (
    session TEXT, item TEXT, tokens INTEGER, at TEXT, UNIQUE(session, item));
CREATE TABLE IF NOT EXISTS heartbeats (name TEXT, at TEXT);
CREATE TABLE IF NOT EXISTS queue (position INTEGER PRIMARY KEY, item TEXT);
CREATE TABLE IF NOT EXISTS kv (key TEXT PRIMARY KEY, value TEXT);
"""

INTERACTION_KINDS = ["ask", "answer", "veto", "request", "defect"]
# The states of an item row (a work order or a roadmap row). STORY-502, D-7200, D-7212.
OPEN_STATES = ["backlog", "ready", "in progress", "in review", "fix round", "waiting", "blocked"]
STARTED_STATES = ["in progress", "in review", "fix round", "waiting", "blocked"]
CLOSED_STATES = ["done", "merged", "released", "cancelled", "superseded"]
ITEM_STATES = OPEN_STATES + CLOSED_STATES
# The known old words of the live stores and their new word.
OLD_STATES = {"in_progress": "in progress", "building": "in progress", "spec": "in progress",
              "claimed": "in progress", "in_review": "in review", "review": "in review",
              "ready to merge": "in review", "waits": "waiting", "changes requested": "done",
              "": "backlog", "specified": "done", "approved": "done"}
# The floor stage of each state (owner rule 5). STORY-502 amendment 1, D-7268, D-7276, ADR-0015.
STAGES = ["open", "on hold", "shipped", "closed"]
STATE_STAGES = {"backlog": "open", "ready": "open", "in progress": "open", "in review": "open",
                "fix round": "open", "waiting": "on hold", "blocked": "on hold",
                "released": "shipped",
                "done": "closed", "merged": "closed", "cancelled": "closed", "superseded": "closed"}
_FIX_ROUND = re.compile(r"fix round( [0-9]+)?")
_ROADMAP_ID = re.compile(r"(STORY|FEATURE|MILESTONE)-[0-9]+")
# The values of the decision tables (docs/adlc.md, section 4).
DECISION_LEVELS = ["detail", "middle", "direction"]
DECISION_CONFIDENCES = ["high", "medium", "low"]
DECISION_REVERSIBILITIES = ["reversible", "hard to reverse", "irreversible"]
DECISION_VISIBILITIES = ["visible", "hidden"]


class UsageError(Exception):
    """A bad argument that argparse cannot catch. `code` is the exit code."""

    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


class Quiet(UsageError):
    """An exit code with no message on stderr: the command printed its report on stdout."""


def now_iso():
    """Return the current UTC time as ISO-8601 with second precision."""
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def norm_iso(text):
    """Return TEXT in the one timestamp format of this store, as UTC."""
    if text is None:
        return now_iso()
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    dt = datetime.fromisoformat(text)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# argparse names the type in its error line, so the name must read well.
norm_iso.__name__ = "ISO-8601 time"


def parse_iso(text):
    """Return the datetime of a stored timestamp, or None."""
    if not text:
        return None
    return datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


class GitTimeout(UsageError):
    """A git call of main_folder did not end in its time limit. Its full process group is stopped."""


def main_folder(limit=None):
    """The main folder of the repository: the parent of the common .git folder.

    The same folder in the main checkout and in each worktree. Raises
    subprocess.CalledProcessError outside a git repository. LIMIT: the time limit of each
    git call in seconds (see rev_parse); None gives no limit, as on main.
    """
    common = rev_parse(["--path-format=absolute", "--git-common-dir"], limit)
    if os.path.basename(common) == ".git":
        return os.path.dirname(common)
    return rev_parse(["--show-toplevel"], limit)


def rev_parse(args, limit=None):
    """The stdout of 1 `git rev-parse ARGS` with no white space at its ends. The environment is the
    environment of the session in each case (the suite case `envall`).

    With LIMIT None, the call of main: no time limit. With LIMIT, git runs in its own process group,
    and on the limit the full group stops, not only git, because a git wrapper can start children
    that hold the pipes open (docs/adlc.md, rule 16, as run_git). Then GitTimeout. A git that exits
    non-zero raises subprocess.CalledProcessError in each case.
    """
    cmd = ["git", "rev-parse", *args]
    if limit is None:
        return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout.strip()
    p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                         start_new_session=True)
    try:
        out, err = p.communicate(timeout=limit)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            # The group ended between the time-out and the kill. macOS answers EPERM for a group that holds only
            # zombies, so PermissionError ends the same way: as the time-out, not as a traceback with the lock held.
            pass
        try:
            p.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            # A child that left the group still holds the pipes: do not wait for it.
            p.stdout.close()
            p.stderr.close()
        raise GitTimeout(f"git did not end after {limit:g} seconds; no change (try again)") from None
    if p.returncode:
        raise subprocess.CalledProcessError(p.returncode, cmd, out, err)
    return out.strip()


def db_path(arg):
    """Find the database path from the flag, the environment or the main folder."""
    if arg:
        return arg
    if os.environ.get("SOFA_STATE_DB"):
        return os.environ["SOFA_STATE_DB"]
    folder = os.path.join(main_folder(), ".sofa")
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, "state.db")


def open_db(path):
    """Open the database for many writers and create the schema."""
    con = sqlite3.connect(path, timeout=5)
    con.row_factory = sqlite3.Row
    # busy_timeout must be set first: the change to WAL needs an exclusive lock.
    con.execute("PRAGMA busy_timeout=5000")
    con.execute("PRAGMA journal_mode=WAL")
    con.executescript(SCHEMA)
    # A store from an earlier version has no sessions.colour, items.left_over_at and items.state_was column.
    add_column(con, "sessions", "colour", "TEXT")
    add_column(con, "items", "left_over_at", "TEXT")
    add_column(con, "items", "state_was", "TEXT")
    return con


def add_column(con, table, column, decl):
    """Add a column that an old store has not. Many processes can open an old store at the same time: the
    process that loses the race gets `duplicate column name`, and the column is there, so that error is no failure."""
    if column in [row[1] for row in con.execute(f"PRAGMA table_info({table})")]:
        return
    try:
        con.execute(f"ALTER TABLE {table} ADD COLUMN {column} {decl}")
    except sqlite3.OperationalError as error:
        if "duplicate column name" not in str(error):
            raise


def blank_to_none(value):
    """An empty string clears a field; None keeps the old value."""
    return None if value == "" else value


# --- sessions ---

def cmd_session_upsert(con, a):
    """Insert or update a session. `since` changes with the state, and at a restart (STORY-502, row 17). A restart is
    an upsert of a name whose stored id and whose new id both have the form of a session id (_UUID) and are not equal.
    At a restart, the work orders of the name that are started and older than --at get the mark left_over_at. A
    roadmap row has no mark: it follows its page. An empty --id keeps the stored id. The upsert maps the known old
    state words first (D-7221). The 3 steps are 1 write transaction."""
    at = a.at
    con.execute("BEGIN IMMEDIATE")
    try:
        _, _, _, changed = map_old_states(con, False)
        # Row 19 of STORY-503: under the write lock, after the map and before the upsert (D-7358).
        refuse_retired(con, a, "sessions", a.name, "--name")
        refuse_retired(con, a, "items", a.item, "--item")
        old = con.execute("SELECT id FROM sessions WHERE name = ?", (a.name,)).fetchone()
        old_id = old["id"] if old else None
        restart = bool(old_id and a.id and _UUID.fullmatch(old_id) and _UUID.fullmatch(a.id) and old_id != a.id)
        con.execute("""
            INSERT INTO sessions (name, id, role, model, state, item, since, free_since)
            VALUES (:name, NULLIF(:id, ''), :role, :model, COALESCE(:state, 'live'), :item, :at, NULL)
            ON CONFLICT(name) DO UPDATE SET
                id = COALESCE(NULLIF(excluded.id, ''), sessions.id),
                role = excluded.role,
                model = COALESCE(excluded.model, sessions.model),
                state = COALESCE(:state, sessions.state),
                item = COALESCE(excluded.item, sessions.item),
                since = CASE WHEN :restart OR (:state IS NOT NULL AND :state IS NOT sessions.state)
                             THEN excluded.since ELSE sessions.since END,
                free_since = CASE WHEN excluded.item IS NOT NULL THEN NULL ELSE sessions.free_since END
        """, dict(name=a.name, id=a.id, role=a.role, model=a.model,
                  state=a.state, item=a.item, at=at, restart=restart))
        if restart:
            # SQLite has no regex, so the ids are read first and filtered here.
            marks = ", ".join("?" for _ in STARTED_STATES)
            ids = [r["id"] for r in con.execute(
                f"SELECT id FROM items WHERE session = ? AND state IN ({marks}) AND updated_at < ? "
                "AND left_over_at IS NULL", [a.name, *STARTED_STATES, at])]
            for item_id in ids:
                if not _ROADMAP_ID.fullmatch(item_id):
                    con.execute("UPDATE items SET left_over_at = ? WHERE id = ?", (at, item_id))
        con.commit()
    except BaseException:
        con.rollback()
        raise
    report_map(changed)


def cmd_session_free(con, a):
    """Set the session item to NULL and record when it became free."""
    con.execute("UPDATE sessions SET item = NULL, free_since = ? WHERE name = ?", (a.at, a.name))
    con.commit()


def cmd_session_colour(con, a):
    """Record the colour that /color set in the session. A row is created when it is not there."""
    con.execute("BEGIN IMMEDIATE")  # T1: the check and the write under 1 write lock
    refuse_retired(con, a, "sessions", a.name, "--name")
    con.execute("INSERT INTO sessions (name, state, since) VALUES (?, 'live', ?) "
                "ON CONFLICT(name) DO NOTHING", (a.name, a.at))
    con.execute("UPDATE sessions SET colour = ? WHERE name = ?", (a.colour, a.name))
    con.commit()


def cmd_session_heartbeat(con, a):
    """Record a heartbeat. A session row is created when it is not there."""
    con.execute("BEGIN IMMEDIATE")  # T1: the check and the write under 1 write lock
    refuse_retired(con, a, "sessions", a.name, "--name")
    con.execute("INSERT INTO sessions (name, state, since) VALUES (?, 'live', ?) "
                "ON CONFLICT(name) DO NOTHING", (a.name, a.at))
    con.execute("UPDATE sessions SET last_heartbeat = ? WHERE name = ?", (a.at, a.name))
    con.execute("INSERT INTO heartbeats (name, at) VALUES (?, ?)", (a.name, a.at))
    con.commit()


def cmd_session_list(con, a):
    """Print all sessions."""
    rows = con.execute("SELECT * FROM sessions ORDER BY name").fetchall()
    emit(rows, a.json, ["name", "id", "role", "model", "state", "item", "since",
                        "last_heartbeat", "free_since", "colour"])


# --- items ---

def plain(text):
    """TEXT with each control character and each line separator (U+2028, U+2029) changed to ?, so a message or a
    table cell is 1 line."""
    return re.sub(r"[\x00-\x1f\x7f-\x9f  ]", "?", text)


def state_hint(word):
    """The new word of a known old state word, or None."""
    if word in OLD_STATES:
        return OLD_STATES[word]
    if _FIX_ROUND.fullmatch(word):
        return "fix round"
    return None


def map_old_states(con, unknown_to_blocked):
    """Change the old state words of the items rows to the words of ITEM_STATES (D-7221). It runs in the transaction
    of its caller and does not commit, so a refusal of the caller rolls it back. A known old word gets its new word
    (OLD_STATES, a numbered fix round, NULL). Another word gets `blocked` when UNKNOWN_TO_BLOCKED is true, else it
    stays. The map changes only `state` and `state_was` (the first old word is kept), so the age and the holder of a
    row stay true. It returns the count of each pair (old word, new word), the (id, old word) of each row that got
    `blocked`, the (id, word) of each row that stayed, and the (id, old word, new word) of each row that it changed.
    When no row has an old word, it reads 1 query and writes nothing."""
    marks = ", ".join("?" for _ in ITEM_STATES)
    rows = con.execute(f"SELECT id, state FROM items WHERE state IS NULL OR state NOT IN ({marks})",
                       ITEM_STATES).fetchall()
    pairs, blocked, stayed, changed = {}, [], [], []
    for row in rows:
        old = row["state"]
        if old in OLD_STATES:
            new = OLD_STATES[old]
        elif old is not None and _FIX_ROUND.fullmatch(old):
            new = "fix round"
        elif old is None:
            new = "backlog"
        elif unknown_to_blocked:
            new = "blocked"
            blocked.append((row["id"], old))
        else:
            stayed.append((row["id"], old))
            continue
        con.execute("UPDATE items SET state_was = COALESCE(state_was, state), state = :new WHERE id = :id",
                    dict(new=new, id=row["id"]))
        pairs[(old, new)] = pairs.get((old, new), 0) + 1
        changed.append((row["id"], old, new))
    return pairs, blocked, stayed, changed


def report_map(changed, own_id=None):
    """Print 1 line on stderr for each row that the map changed, except the row OWN_ID (D-7349): `<id>: <old> -> <new>`.
    The caller prints after the commit, so a refusal that rolled the map back prints nothing."""
    for item_id, old, new in changed:
        if item_id != own_id:
            word = "NULL" if old is None else (old if old != "" else '""')
            print(f"{plain(item_id)}: {plain(word)} -> {new}", file=sys.stderr)


def caller_names(con):
    """The names of the sessions rows whose id is $CLAUDE_CODE_SESSION_ID: the caller. An empty set means
    that the caller is unknown (the variable is not set or is empty, or no row has that id), and no guard
    of the caller runs. STORY-469 uses this function too."""
    sid = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not sid:
        return set()
    return {r["name"] for r in con.execute("SELECT name FROM sessions WHERE id = ?", (sid,))}


def check_item_set(con, a):
    """The refusals of item set that need the old row. Raise UsageError (exit 2). The caller holds the write lock."""
    old = con.execute("SELECT * FROM items WHERE id = ?", (a.id,)).fetchone()
    if a.state is None and old is None:
        raise UsageError(f"item {a.id} is new; give --state", 2)
    names = caller_names(con)
    stored = (old["session"] if old else None) or ""
    roadmap = bool(_ROADMAP_ID.fullmatch(a.id))
    # The reopen guard (row 2).
    if old is not None and old["state"] in CLOSED_STATES and a.state in OPEN_STATES and not a.reopen:
        raise UsageError(f"item {a.id} is {plain(old['state'])}; a closed row opens again only with --reopen (STORY-502)", 2)
    # The session guard (row 3): a session writes only its own name.
    if names and a.session is not None:
        own = (old is None or stored in names) if a.session == "" else a.session in names
        if not own:
            raise UsageError(f"--session {plain(a.session)} is not your session (you are {', '.join(sorted(names))}); "
                             "a session writes only its own rows (station rule 6)", 2)
    # The owner guard (row 4): a work order of another session. A roadmap row is outside it.
    if names and old is not None and not roadmap and stored.strip() != "" and stored not in names and not a.take_over:
        raise UsageError(f"item {a.id} is a work order of {plain(stored)}; a session writes only its own rows "
                         "(give --take-over only when a TASK gives you this work order)", 2)
    # The holder rule (row 30): a work order always has a holder. It does not read the caller.
    # The raw --session value counts here (blank_to_none comes later), and a new row has no old session.
    after = a.session if a.session is not None else stored
    if not roadmap and (after or "").strip() == "":
        raise UsageError(f"item {a.id} is a work order with no holder; give --session <your name> (owner rule 4)", 2)
    # The form of --session (security issue 2354): the name form of `session upsert --name`. '' clears a roadmap row.
    if a.session and not _NAME.fullmatch(a.session):
        raise UsageError(f"--session {plain(a.session)} is not a session name (form [a-z0-9][a-z0-9._-]{{0,63}})", 2)


def cmd_item_set(con, a):
    """Insert or update an item. Omitted flags keep the old value. '' clears --pr, --branch, --worktree,
    --waits-for, and --session of a roadmap row. '' for --id, --state, or --session of a work order exits 2."""
    if not _ID.fullmatch(a.id):
        raise UsageError(f"item id {plain(a.id)} is not in the form [A-Za-z0-9][A-Za-z0-9._:-]{{0,79}}", 2)
    if a.state is not None and a.state not in ITEM_STATES:
        hint = state_hint(a.state)
        raise UsageError(f"{plain(a.state)} is not a state of an item row; use 1 of: {', '.join(ITEM_STATES)}"
                         + (f' (use "{hint}")' if hint else ""), 2)
    if a.take_over and a.session is None:
        raise UsageError("--take-over needs --session <your name>", 2)
    # 1 write transaction: the reads and the write are 1 step. A refusal rolls back and writes nothing.
    con.execute("BEGIN IMMEDIATE")
    try:
        _, _, _, changed = map_old_states(con, False)
        # Row 19 of STORY-503: after the map and before the guards of check_item_set, so a key that the operator took
        # out gets the message of row 19, not a guard message (D-7358).
        refuse_retired(con, a, "items", a.id, "--id")
        refuse_retired(con, a, "sessions", a.session, "--session")
        check_item_set(con, a)
        write_item(con, a)
        con.commit()
    except BaseException:
        con.rollback()
        raise
    report_map(changed, a.id)


def write_item(con, a):
    """The upsert of item set. The caller checked the refusals and holds the write lock."""
    con.execute("""
        INSERT INTO items (id, state, pr, branch, worktree, waits_for, session,
                           picked_up_at, released_at, updated_at)
        VALUES (:id, :state, :pr, :branch, :worktree, :waits_for, :session,
                :at, CASE WHEN :state = 'released' THEN :at END, :at)
        ON CONFLICT(id) DO UPDATE SET
            state = CASE WHEN :state_given THEN excluded.state ELSE items.state END,
            pr = CASE WHEN :pr_given THEN excluded.pr ELSE items.pr END,
            branch = CASE WHEN :branch_given THEN excluded.branch ELSE items.branch END,
            worktree = CASE WHEN :worktree_given THEN excluded.worktree ELSE items.worktree END,
            waits_for = CASE WHEN :waits_for_given THEN excluded.waits_for ELSE items.waits_for END,
            session = CASE WHEN :session_given THEN excluded.session ELSE items.session END,
            released_at = CASE WHEN excluded.state = 'released'
                               THEN COALESCE(items.released_at, excluded.updated_at)
                               ELSE items.released_at END,
            left_over_at = NULL,
            state_was = NULL,
            updated_at = excluded.updated_at
    """, dict(id=a.id, state=a.state, state_given=a.state is not None, at=a.at,
              pr=blank_to_none(a.pr), pr_given=a.pr is not None,
              branch=blank_to_none(a.branch), branch_given=a.branch is not None,
              worktree=blank_to_none(a.worktree), worktree_given=a.worktree is not None,
              waits_for=blank_to_none(a.waits_for), waits_for_given=a.waits_for is not None,
              session=blank_to_none(a.session), session_given=a.session is not None))


def cmd_item_migrate(con, a):
    """Change each old state word of the items rows to a word of ITEM_STATES (D-7221). A word that the map does not
    know gets `blocked`, and the output names its row. --dry-run prints the same lines and changes nothing."""
    con.execute("BEGIN IMMEDIATE")
    try:
        pairs, blocked, _, _ = map_old_states(con, True)
        open_rows = con.execute(f"SELECT COUNT(*) FROM items WHERE state NOT IN ({', '.join('?' for _ in CLOSED_STATES)})",
                                CLOSED_STATES).fetchone()[0]
        if a.dry_run:
            con.rollback()
        else:
            con.commit()
    except BaseException:
        con.rollback()
        raise
    for (old, new), count in sorted(pairs.items(), key=lambda p: (p[0][0] or "", p[0][1])):
        word = "NULL" if old is None else (old if old != "" else '""')
        print(f"{plain(word)} -> {new}: {count}")
    if blocked:
        print("fallback blocked: " + " ".join(f"{plain(i)} ({plain(w)})" for i, w in blocked))
    print(f"open rows: {open_rows}")


def cmd_item_list(con, a):
    """Print the item rows, oldest write first (a read command: no map, no write). --session keeps the rows of that
    session. --open keeps the rows whose state is not in CLOSED_STATES, also a row with no state or with an old word."""
    where, args = [], []
    if a.session is not None:
        where.append("session = ?")
        args.append(a.session)
    if a.open:
        where.append(f"(state IS NULL OR state NOT IN ({', '.join('?' for _ in CLOSED_STATES)}))")
        args.extend(CLOSED_STATES)
    rows = con.execute("SELECT * FROM items" + (" WHERE " + " AND ".join(where) if where else "")
                       + " ORDER BY updated_at, id", args).fetchall()
    if a.json:
        print(json.dumps([dict(r) for r in rows]))
        return
    table([[r["id"], r["state"], r["pr"], r["branch"], r["worktree"], r["waits_for"], r["left_over_at"]] for r in rows],
          ["id", "state", "pr", "branch", "worktree", "waits", "left over"])


def cmd_item_trip(con, a):
    """Record one hand-over of an item between two roles."""
    con.execute("BEGIN IMMEDIATE")  # T1: the check and the write under 1 write lock
    refuse_retired(con, a, "items", a.id, "--id")
    con.execute("INSERT INTO trips (item, from_role, to_role, at) VALUES (?, ?, ?, ?)",
                (a.id, a.from_role, a.to_role, a.at))
    con.commit()


# --- messages ---

def cmd_message_log(con, a):
    """Record the header of a message. The body is never stored."""
    con.execute("INSERT INTO messages (type, from_name, to_name, subject, at) VALUES (?, ?, ?, ?, ?)",
                (a.type, a.from_name, a.to_name, a.subject, a.at))
    con.commit()


# --- decisions ---

# An id is D- and 1 to 9 ASCII digits. Use `fullmatch`: a longer id makes `int()` slow or raise.
DECISION_ID_RE = re.compile(r"D-([0-9]{1,9})")

INSERT_DECISION = """
    INSERT INTO decisions (id, story, level, confidence, reversibility, visibility,
                           decided_by, summary, at, vetoed_at)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, NULL)
"""

ON_ID_CONFLICT_UPDATE = """
    ON CONFLICT(id) DO UPDATE SET
        story = excluded.story, level = excluded.level, confidence = excluded.confidence,
        reversibility = excluded.reversibility, visibility = excluded.visibility,
        decided_by = excluded.decided_by, summary = excluded.summary, at = excluded.at
"""


# A store gives ids only from its own block of ids. Block k holds D-<1000k+1> to
# D-<1000k+999> (block 0: D-001 to D-999). A store reserves a block on origin with the tag
# refs/tags/sofa-decision-block/<k>, which git creates only 1 time (ADR-0011).
TAG_PREFIX = "refs/tags/sofa-decision-block/"
TAG_RE = re.compile(r"refs/tags/sofa-decision-block/([0-9]{1,6})")
MAX_BLOCK = 999999
MAX_CITED_ID = 99999  # the highest id of main that counts; old ids are near 5000 (block 99 at most)
MAX_PUSHES = 5
APP_KEYS = ["app-id", "installation-id", "key-path", "slug", "bot-user-id"]
RESERVE_FAILED = "cannot reserve a block of decision ids"
RESERVE_TAIL = "no decision written. Try again in 1 minute."
RESERVE_SHORT = "no decision written."
PUBLISH_FAILED = "cannot publish the snapshot"
PUBLISH_TAIL = "nothing pushed."


def block_range(k):
    """The first and the last id number of block K."""
    return (1, 999) if k == 0 else (1000 * k + 1, 1000 * k + 999)


def block_of(n):
    """The block of id number N. D-1000 belongs to block 0, because block 1 starts at D-1001."""
    return (n - 1) // 1000


def store_numbers(con):
    """The number of each id of the store that has the form of row 2."""
    return [int(m.group(1)) for row in con.execute("SELECT id FROM decisions")
            if (m := DECISION_ID_RE.fullmatch(row[0] or ""))]


def next_decision_id(con, k):
    """Return the next free D-<n> of block K (3 digits at least), or None when the block is full."""
    first, last = block_range(k)
    n = max((x for x in store_numbers(con) if first <= x <= last), default=first - 1) + 1
    return None if n > last else f"D-{n:03d}"


def stored_block(con):
    """The block of this store (the key decision.block), or None."""
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.block'").fetchone()
    try:
        block = int(row[0]) if row else None
    except ValueError:
        return None
    # A value out of range would give ids that do not have the form of row 2.
    return block if block is not None and 0 <= block <= MAX_BLOCK else None


def write_block(con, block):
    """Make BLOCK the block of this store. The caller holds the write transaction."""
    con.execute("INSERT INTO kv (key, value) VALUES ('decision.block', ?) "
                "ON CONFLICT(key) DO UPDATE SET value = excluded.value", (str(block),))


def git_timeout():
    """The time limit of 1 git call in seconds: SOFA_GIT_TIMEOUT, else 60."""
    raw = os.environ.get("SOFA_GIT_TIMEOUT")
    if raw is None:
        return 60.0
    try:
        value = float(raw)
    except ValueError:
        value = 0.0
    if not (math.isfinite(value) and value > 0):
        raise UsageError("SOFA_GIT_TIMEOUT must be a number of seconds greater than 0", code=2)
    return value


# The keys that select a repository, or change what `git config` reads. A value that a parent git
# process (a hook, an `exec` step of a rebase) set for its own repository is wrong for the
# repository of the store. 13 keys are the list of `git rev-parse --local-env-vars` (githooks(5)
# tells a hook to clear them), without GIT_CONFIG_PARAMETERS and GIT_CONFIG_COUNT, which hold the
# git setup of the session. GIT_CONFIG makes `git config` read 1 file, and `git push` reads the
# full config (git-config(1)). GIT_NAMESPACE is not in the list of git: it moves a tag on a local
# `origin` to a ref that other stores do not read. The case `envlist` compares this tuple with git.
REPO_ENV_KEYS = (
    "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CONFIG", "GIT_OBJECT_DIRECTORY", "GIT_DIR",
    "GIT_WORK_TREE", "GIT_IMPLICIT_WORK_TREE", "GIT_GRAFT_FILE", "GIT_INDEX_FILE",
    "GIT_NO_REPLACE_OBJECTS", "GIT_REPLACE_REF_BASE", "GIT_PREFIX", "GIT_SHALLOW_FILE",
    "GIT_COMMON_DIR", "GIT_NAMESPACE",
)


def git_env():
    """The environment of each git call: a copy of os.environ with no key of REPO_ENV_KEYS.

    The GIT_CONFIG_* entries of the session stay (the App git setup, ADR-0007, decision 3).
    GIT_TERMINAL_PROMPT=0 stops the prompt on the terminal, and an empty GIT_ASKPASS stops each
    askpass program (GIT_ASKPASS, core.askPass, SSH_ASKPASS), so a call with no credential fails.
    """
    env = {k: v for k, v in os.environ.items() if k not in REPO_ENV_KEYS}
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_ASKPASS"] = ""
    return env


def run_git(repo, args, env=None, stdin=None):
    """Run `git -C REPO ARGS` in its own process group. Return (exit code, stdout, stderr).

    With `env=None` the call gets `git_env()`. On the time limit the full group stops, not only
    `git`: `git` starts children (`ssh`, `git-remote-https`, `upload-pack`) that hold the pipes
    open (docs/adlc.md, rule 16).
    """
    if env is None:
        env = git_env()
    limit = git_timeout()
    p = subprocess.Popen(["git", "-C", repo, *args], stdin=subprocess.PIPE if stdin is not None
                         else subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         text=True, errors="replace", env=env, start_new_session=True)
    try:
        out, err = p.communicate(stdin, timeout=limit)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass  # the group ended between the time-out and the kill
        try:
            out, err = p.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            # A child that left the group still holds the pipes: do not wait for it.
            p.stdout.close()
            p.stderr.close()
            out, err = "", ""
        return 124, out, f"no end after {limit:g} seconds"
    return p.returncode, out, err


class Git:
    """The git calls of 1 reservation: 1 repository, 1 environment (row 10 of the STORY-143 spec and
    rows 2 to 4 of the STORY-425 spec)."""

    def __init__(self, repo, failed=None, tail=None, short=None):
        # The text of an error is an argument, so a reservation and a publish each keep their own (row 8 of the
        # STORY-444 spec). The default is the text of a reservation. SHORT ends a message that gives no advice.
        self.failed = failed or RESERVE_FAILED
        self.tail = RESERVE_TAIL if tail is None else tail
        self.short = RESERVE_SHORT if short is None else short
        self.repo = repo
        self.env = git_env()
        ssh = self.env.get("GIT_SSH_COMMAND")
        if not ssh:
            rc, out, _ = run_git(repo, ["config", "--get", "core.sshCommand"], env=self.env)
            ssh = out.strip() if rc == 0 else ""
        if not ssh:
            ssh = shlex.quote(self.env["GIT_SSH"]) if self.env.get("GIT_SSH") else "ssh"
        self.env["GIT_SSH_COMMAND"] = ssh + " -o BatchMode=yes"

    def run(self, *args, stdin=None, extra=None):
        # The output is parsed, so a color setting of the person must not add escape codes to it.
        # EXTRA are more variables for this 1 call (the identity of a commit).
        env = {**self.env, **extra} if extra else self.env
        return run_git(self.repo, ["-c", "color.ui=never", "-c", "color.grep=never", *args],
                       env=env, stdin=stdin)

    def must(self, *args, stdin=None, extra=None):
        """Run a git call. Return stdout. Raise the error of row 9 when it fails."""
        rc, out, err = self.run(*args, stdin=stdin, extra=extra)
        if rc != 0:
            raise self.failure(args[0], rc, err)
        return out

    def failure(self, step, rc, err):
        text = f"{self.failed}: {step}: {git_reason(err, rc)}"
        return UsageError(f"{text}; {self.tail}" if self.tail else text)


def git_reason(err, rc):
    """The detail of a failed git step, from its stderr ERR (row 5 of the STORY-425 spec).

    A refused push prints `To <url>` first, which does not name the reason. The status line of the
    ref (flag `!`, git-push(1)) holds the reason of git, and a `remote:` line is the text of the
    hook or of the server. So: the first `! ` line, then `, ` and the first `remote:` line when
    there is one; else the first line; else `git exited RC`. A line that is only `remote:` is skipped.
    """
    lines = [x for x in (line.strip() for line in err.splitlines()) if x and x != "remote:"]
    flagged = [x for x in lines if x.startswith("! ")]
    if flagged:
        remote = [x for x in lines if x.startswith("remote:")]
        return flagged[0] + (", " + remote[0] if remote else "")
    return lines[0] if lines else f"git exited {rc}"


def store_repo(path):
    """The repository of the store at PATH, or None (row 10).

    The folder F that holds the `.sofa` folder of the store, only when `git -C F rev-parse
    --show-toplevel` prints the real path of F. A plain folder inside a checkout is no repository.
    """
    full = os.path.realpath(path)
    sofa = os.path.dirname(full)
    if os.path.basename(sofa) != ".sofa":
        return None
    folder = os.path.dirname(sofa)
    rc, out, _ = run_git(folder, ["rev-parse", "--show-toplevel"])
    return folder if rc == 0 and os.path.realpath(out.strip()) == folder else None


def repo_of_store(a, failed=RESERVE_FAILED):
    repo = store_repo(a.db_path)
    if repo is None:
        raise UsageError(f"{failed}: the store {a.db_path} is not <repository>/.sofa/"
                         "state.db; give no --db, or give the path of the store of the main folder.")
    return repo


def origin_url(git):
    """The 1 URL of origin, for fetch and for push (rows 3, 5, 6 and 20). The tags are read from the
    fetch URL and pushed to each push URL, so a second URL would send the tag to another repository
    (a fork, or an SSH address that uses the key of the person). It makes only local git calls."""
    fetch = [u for u in git.must("remote", "get-url", "--all", "origin").split("\n") if u]
    push = [u for u in git.must("remote", "get-url", "--push", "--all", "origin").split("\n") if u]
    if len(fetch) != 1 or push != fetch:
        raise UsageError((f"{git.failed}: remote: origin must have 1 URL for fetch and push "
                          f"(fetch {' '.join(fetch) or 'none'}, push {' '.join(push) or 'none'}); "
                          f"{git.short}").rstrip("; "))
    return fetch[0]


def has_app_values(con):
    """Does the store hold at least 1 of the machine.github-app.* values?"""
    marks = [f"machine.github-app.{k}" for k in APP_KEYS]
    rows = con.execute(f"SELECT value FROM kv WHERE key IN ({','.join('?' * len(marks))})", marks)
    return any(row[0] for row in rows)


def app_setup_ok(con, git, url):
    """Row 20. Return None when the store has no App values or the git setup is the App setup,
    else the text of the check that failed. URL is the 1 URL of origin. It makes no network call."""
    if not has_app_values(con):
        return None
    rc, out, _ = git.run("config", "-z", "--get-regexp", r"^credential\..*helper$")
    values = [e.split("\n", 1)[1] if "\n" in e else "" for e in out.split("\0") if e] if rc == 0 else []
    while "" in values:
        values = values[len(values) - values[::-1].index(""):]
    if not values:
        return "no credential helper is set after the last empty value"
    for value in values:
        try:
            words = shlex.split(value[1:]) if value.startswith("!") else []
        except ValueError:
            words = []
        if len(words) != 2 or words[1] != "credential" or os.path.basename(words[0]) != "sofa-github":
            return f"the credential helper {value} is not sofa-github credential"
    if not url.startswith("https://github.com/"):
        return f"the URL of origin is {url}, not an https://github.com/ URL"
    return None


def tag_numbers(git):
    """The reserved tags on origin, as {block number: object id of the tag}."""
    out = git.must("ls-remote", "--tags", "origin", TAG_PREFIX + "*")
    tags = {}
    for line in out.splitlines():
        oid, _, ref = line.partition("\t")
        m = TAG_RE.fullmatch(ref.strip())
        if m:
            tags[int(m.group(1))] = oid.strip()
    return tags


def main_block(git):
    """The highest block of an id that docs/ of origin/main cites, or -1 (row 7)."""
    # The random part: a stale lock of a killed run must not stop a run with the same pid.
    ref = f"refs/sofa-state/main-{os.getpid()}-{secrets.token_hex(4)}"
    try:
        git.must("fetch", "--no-tags", "--no-write-fetch-head", "--refmap=", "origin",
                 f"+refs/heads/main:{ref}")
        rc, out, err = git.run("grep", "--no-color", "-o", "-h", "-w", "-E", "D-[0-9]+", ref, "--", "docs/")
        if rc not in (0, 1):
            raise git.failure("grep", rc, err)
    finally:
        git.run("update-ref", "-d", ref)
    ids = (DECISION_ID_RE.fullmatch(line.rsplit(":", 1)[-1].strip()) for line in out.splitlines())
    # An id above MAX_CITED_ID is an example or a typo, not an old id: one D-<9 digits> in docs/
    # must not stop each reservation (issue 1803). A block above it comes from a tag (k_tag).
    return max((block_of(n) for n in (int(m.group(1)) for m in ids if m) if n <= MAX_CITED_ID),
               default=-1)


def store_id(con):
    """The id of this store (the key decision.store). It is read first, so a store that has an id needs no write
    lock (in WAL mode a read goes on while another writer holds the lock, STORY-444 row 18). Only when the key is
    absent, it is written and committed at once."""
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    if row:
        return row[0]
    con.execute("INSERT OR IGNORE INTO kv (key, value) VALUES ('decision.store', ?)",
                (secrets.token_hex(8),))
    con.commit()
    return con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()[0]


def reserve_block(con, repo):
    """Reserve a new block on origin and return its number k (rows 6, 7, 18 and 20)."""
    git = Git(repo)
    problem = app_setup_ok(con, git, origin_url(git))
    if problem:
        raise UsageError(f"{RESERVE_FAILED}: this session has no App git setup ({problem}); "
                         "no decision written. Start the session fresh with dispatch.sh.")
    k_main = main_block(git)
    tags = tag_numbers(git)
    k_store = max((block_of(n) for n in store_numbers(con)), default=-1)
    for _ in range(MAX_PUSHES):
        k_tag = max(tags, default=-1)  # tags is a dict: max() reads its keys
        k = 1 + max(k_tag, k_main, k_store, -1)
        if k > MAX_BLOCK:
            top = max(k_tag, k_main, k_store)
            source = "the tags" if top == k_tag else "main" if top == k_main else "the store"
            raise UsageError(f"{RESERVE_FAILED}: no block above {MAX_BLOCK} is free "
                             f"(the highest is from {source}).")
        sid = store_id(con)
        blob = git.must("hash-object", "-w", "--stdin", stdin=f"store {sid}\nblock {k}\n").strip()
        text = (f"object {blob}\ntype blob\ntag sofa-decision-block/{k}\n"
                f"tagger sofa-state <sofa-state@localhost> {int(time.time())} +0000\n\nstore {sid}\n")
        tag = git.must("hash-object", "-t", "tag", "-w", "--stdin", stdin=text).strip()
        rc, _, err = git.run("push", "origin", f"{tag}:{TAG_PREFIX}{k}")
        if rc == 0:
            return k
        # Another store may have taken block k. Read the tags again: a tag k there means yes.
        try:
            tags = tag_numbers(git)
        except UsageError:
            raise git.failure("push", rc, err) from None
        if tags.get(k) == tag:
            return k  # the push reached origin and the client saw a failure: the tag is ours
        if k not in tags:
            raise git.failure("push", rc, err)
    raise UsageError(f"{RESERVE_FAILED}: push: {MAX_PUSHES} blocks were taken while this store "
                     "reserved; no decision written. Try again in 1 minute.")


def claim_block(con, a):
    """Return the block that gives the next id, with the write transaction open (rows 8 and 12)."""
    for _ in range(3):
        block = stored_block(con)
        if (block is None or next_decision_id(con, block) is None) \
                and getattr(a, "reserved_block", None) is None:
            a.reserved_block = reserve_block(con, repo_of_store(a))
        # The write lock comes before the second read, so 2 sessions do not take the same id.
        con.execute("BEGIN IMMEDIATE")
        block = stored_block(con)
        if block is None or next_decision_id(con, block) is None:
            if getattr(a, "reserved_block", None) is None:
                con.rollback()
                continue
            block = a.reserved_block
            write_block(con, block)
        if next_decision_id(con, block) is not None:
            return block
        con.rollback()
        a.reserved_block = None
    raise UsageError("the block of this store filled 3 times while it reserved; "
                     "run the command again.")


def cmd_decision_log(con, a):
    """Record a decision and print its id. With no --id, take the next free id of the block."""
    if a.replace and not a.id:
        raise UsageError("--replace needs --id", code=2)
    if a.id is not None and not DECISION_ID_RE.fullmatch(a.id):
        raise UsageError("--id must be D- and 1 to 9 digits, for example D-042", code=2)
    # Before claim_block: a refused call must not reserve a block on origin.
    refuse_retired(con, a, "items", a.story, "--story")
    if a.id:
        con.execute("BEGIN IMMEDIATE")
        decision_id = a.id
    else:
        decision_id = next_decision_id(con, claim_block(con, a))
    # Again under the write lock of the write (each branch holds it here): a rename may have committed after the
    # early check. claim_block runs no git while the lock is held.
    refuse_retired(con, a, "items", a.story, "--story")
    old = con.execute("SELECT story FROM decisions WHERE id = ?", (decision_id,)).fetchone()
    if old and not a.replace:
        raise UsageError(f"decision {decision_id} exists (story {old['story']}); give no --id "
                         "to take the next free id, or --replace to write over it", code=2)
    # Only --replace writes over a row. A plain insert fails on an id that exists.
    sql = INSERT_DECISION + (ON_ID_CONFLICT_UPDATE if a.replace else "")
    con.execute(sql, (decision_id, a.story, a.level, a.confidence, a.reversibility,
                      a.visibility, a.by, a.summary, a.at))
    con.commit()
    print(decision_id)


def check_tag(con, a, block):
    """`decision block --check`: does origin hold the tag of this block, made by this store?"""
    git = Git(repo_of_store(a))
    problem = app_setup_ok(con, git, origin_url(git))
    if problem:
        raise UsageError(f"{RESERVE_FAILED}: this session has no App git setup ({problem}); "
                         "no decision written. Start the session fresh with dispatch.sh.")
    name = f"{TAG_PREFIX}{block}"
    if not git.must("ls-remote", "--tags", "origin", name).strip():
        print("tag missing")
        raise Quiet("", code=1)
    ref = f"refs/sofa-state/check-{os.getpid()}-{secrets.token_hex(4)}"
    try:
        git.must("fetch", "--no-tags", "--no-write-fetch-head", "--refmap=", "origin", f"+{name}:{ref}")
        text = git.must("cat-file", "-p", f"{ref}^{{}}")
    finally:
        git.run("update-ref", "-d", ref)
    owner = text.splitlines()[0].removeprefix("store ") if text.startswith("store ") else "unknown"
    mine = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    if mine is None or owner != mine[0]:
        print(f"tag of store {owner}")
        raise Quiet("", code=1)
    print("tag ok")


def cmd_decision_block(con, a):
    """Print the block of this store. --reserve reserves one when no id is free; --check reads its tag."""
    block = stored_block(con)
    if a.reserve and (block is None or next_decision_id(con, block) is None):
        # `a` is the same object in each try of run_with_retry, so a lock after the push
        # does not push a second tag.
        if getattr(a, "reserved_block", None) is None:
            a.reserved_block = reserve_block(con, repo_of_store(a))
        con.execute("BEGIN IMMEDIATE")
        block = stored_block(con)
        if block is None or next_decision_id(con, block) is None:
            block = a.reserved_block
            write_block(con, block)
        con.commit()
    if block is None:
        print("no block")
        raise Quiet("", code=1)
    if a.check:
        return check_tag(con, a, block)
    first, last = block_range(block)
    free = next_decision_id(con, block)
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    print(f"block {block}: D-{first:03d} to D-{last:03d}, "
          f"{'full' if free is None else 'next ' + free}, store {row[0] if row else 'unknown'}")


def cmd_decision_veto(con, a):
    """Mark a decision as vetoed."""
    cur = con.execute("UPDATE decisions SET vetoed_at = ? WHERE id = ?", (a.at, a.id))
    con.commit()
    if cur.rowcount == 0:
        raise UsageError(f"no decision with id {a.id}")


def cmd_decision_list(con, a):
    """Print decisions, with filters on story and time."""
    sql, args = "SELECT * FROM decisions WHERE 1=1", []
    if a.story:
        sql += " AND story = ?"
        args.append(a.story)
    if a.since:
        sql += " AND at >= ?"
        args.append(a.since)
    rows = con.execute(sql + " ORDER BY at, id", args).fetchall()
    emit(rows, a.json, ["id", "story", "level", "confidence", "reversibility", "visibility",
                        "decided_by", "at", "vetoed_at", "summary"])


# --- asks ---

def cmd_ask_open(con, a):
    """Open an ask to hitl."""
    con.execute("BEGIN IMMEDIATE")  # T1: the check and the write under 1 write lock
    refuse_retired(con, a, "items", a.story, "--story")
    con.execute("INSERT INTO asks (id, story, priority, opened_at, closed_at) VALUES (?, ?, ?, ?, NULL) "
                "ON CONFLICT(id) DO UPDATE SET story = excluded.story, priority = excluded.priority",
                (a.id, a.story, a.priority, a.at))
    con.commit()


def cmd_ask_close(con, a):
    """Close an ask."""
    cur = con.execute("UPDATE asks SET closed_at = ? WHERE id = ? AND closed_at IS NULL", (a.at, a.id))
    con.commit()
    if cur.rowcount == 0:
        raise UsageError(f"no open ask with id {a.id}")


def cmd_ask_list(con, a):
    """Print all asks."""
    rows = con.execute("SELECT * FROM asks ORDER BY opened_at, id").fetchall()
    emit(rows, a.json, ["id", "story", "priority", "opened_at", "closed_at"])


# --- interactions, usage, queue, kv ---

def cmd_interaction_log(con, a):
    """Record one human interaction on a story."""
    con.execute("BEGIN IMMEDIATE")  # T1: the check and the write under 1 write lock
    refuse_retired(con, a, "items", a.story, "--story")
    con.execute("INSERT INTO interactions (story, kind, by_whom, at) VALUES (?, ?, ?, ?)",
                (a.story, a.kind, a.by, a.at))
    con.commit()


def cmd_usage_set(con, a):
    """Set the token count of a session on an item."""
    con.execute("INSERT INTO usage (session, item, tokens, at) VALUES (?, ?, ?, ?) "
                "ON CONFLICT(session, item) DO UPDATE SET tokens = excluded.tokens, at = excluded.at",
                (a.session, a.item, a.tokens, a.at))
    con.commit()


def cmd_queue_set(con, a):
    """Replace the queue with the given items, in order."""
    con.execute("BEGIN IMMEDIATE")  # T1: the check and the write under 1 write lock
    for item in a.items:
        refuse_retired(con, a, "items", item, "ITEM")
    with con:
        con.execute("DELETE FROM queue")
        con.executemany("INSERT INTO queue (position, item) VALUES (?, ?)",
                        list(enumerate(a.items, start=1)))


def cmd_queue_list(con, a):
    """Print the queue, one item per line."""
    for row in con.execute("SELECT item FROM queue ORDER BY position"):
        print(row["item"])


def cmd_kv_set(con, a):
    """Set one key. A key that starts with `decision.` is written only by `decision log`, and a key that starts
    with `rows.retired.` only by `item remove`, `item rename`, `session remove` and `session rename`."""
    if a.key.startswith("decision."):
        raise UsageError("a key that starts with decision. is written only by sofa-state "
                         "(the block of decision ids); do not set it by hand", code=2)
    if a.key.startswith("rows.retired."):
        raise UsageError("a key that starts with rows.retired. is written only by sofa-state item remove, item "
                         "rename, session remove and session rename (the keys that the operator took out); do not "
                         "set it by hand", code=2)
    con.execute("INSERT INTO kv (key, value) VALUES (?, ?) "
                "ON CONFLICT(key) DO UPDATE SET value = excluded.value", (a.key, a.value))
    con.commit()


def cmd_kv_get(con, a):
    """Print one value. Exit 1 when the key is not there."""
    row = con.execute("SELECT value FROM kv WHERE key = ?", (a.key,)).fetchone()
    if row is None:
        raise UsageError(f"no key {a.key}")
    print(row["value"])


# --- metrics, report, prune ---

def story_metrics(con, story):
    """Compute the metrics of one story (STORY-502, row 20). The work orders of a story are the item rows whose id
    starts with the story id and a dash (STORY-1-build is of STORY-1; STORY-10-build is not). `picked_up_at` is the
    earliest `picked_up_at` of the work orders; a story with no work order uses the one of its roadmap row.
    `released_at` is the one of the roadmap row. `trips` counts the trips of the story and of its work orders."""
    one = lambda sql, *args: con.execute(sql, args).fetchone()[0]
    closed_asks = one("SELECT COUNT(*) FROM asks WHERE story = ? AND closed_at IS NOT NULL", story)
    ask_inter = one("SELECT COUNT(*) FROM interactions WHERE story = ? AND kind = 'ask'", story)
    item = con.execute("SELECT picked_up_at, released_at FROM items WHERE id = ?", (story,)).fetchone()
    prefix = story + "-"
    work_picked = one("SELECT MIN(picked_up_at) FROM items WHERE substr(id, 1, length(?)) = ?", prefix, prefix)
    picked = work_picked or (item["picked_up_at"] if item else None)
    released = item["released_at"] if item else None
    cycle = None
    if picked and released:
        hours = (parse_iso(released) - parse_iso(picked)).total_seconds() / 3600
        cycle = round(hours, 1)
    return {
        "story": story,
        "hitl_questions": closed_asks + ask_inter,
        "autonomous_decisions": one("SELECT COUNT(*) FROM decisions WHERE story = ? "
                                    "AND decided_by != 'hitl' AND vetoed_at IS NULL", story),
        "review_defects": one("SELECT COUNT(*) FROM interactions WHERE story = ? AND kind = 'defect'", story),
        "trips": one("SELECT COUNT(*) FROM trips WHERE item = ? OR substr(item, 1, length(?)) = ?",
                     story, prefix, prefix),
        "picked_up_at": picked,
        "released_at": released,
        "cycle_hours": cycle,
    }


def cmd_metrics(con, a):
    """Print the metrics of one story."""
    m = story_metrics(con, a.story)
    if a.json:
        print(json.dumps(m))
        return
    for key, value in m.items():
        print(f"{key}: {'' if value is None else value}")


def age(text, now):
    """Return a short age such as 5m or 2h, or '-' when there is no time."""
    dt = parse_iso(text)
    if dt is None:
        return "-"
    seconds = max(0, int((now - dt).total_seconds()))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h"
    return f"{seconds // 86400}d"


# The slug pattern of sofa-github (Values.slug) and the pattern of a GitHub login.
SLUG_RE = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,98}[A-Za-z0-9])?"
LOGIN_RE = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?"


def store_owner(con):
    """The instance and the bot of this store, from 2 keys. A missing value, or a value that does
    not match its pattern, gives None. It reads no other machine. key, so the report never shows
    the key path of the App."""
    def value(key, pattern):
        row = con.execute("SELECT value FROM kv WHERE key = ?", (key,)).fetchone()
        text = (row["value"] or "") if row else ""
        return text if re.fullmatch(pattern, text) else None
    slug = value("machine.github-app.slug", SLUG_RE)
    return value("machine.instance", LOGIN_RE), (f"{slug}[bot]" if slug else None)


def cmd_report(con, a):
    """Print the dashboard: the instance and the bot of the store, sessions, items, open asks, queue,
    recent decisions."""
    now = parse_iso(a.at)
    day_ago = (now - timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
    sessions = con.execute("SELECT * FROM sessions ORDER BY name").fetchall()
    items = con.execute("SELECT * FROM items ORDER BY id").fetchall()
    asks = con.execute("SELECT * FROM asks WHERE closed_at IS NULL ORDER BY opened_at").fetchall()
    queue = [r["item"] for r in con.execute("SELECT item FROM queue ORDER BY position")]
    decisions = con.execute("SELECT * FROM decisions WHERE at >= ? ORDER BY at", (day_ago,)).fetchall()
    instance, bot = store_owner(con)
    if a.json:
        print(json.dumps({
            "instance": instance,
            "bot": bot,
            "sessions": [dict(r, heartbeat_age=age(r["last_heartbeat"], now)) for r in sessions],
            "items": [dict(r) for r in items],
            "open_asks": [dict(r) for r in asks],
            "queue": queue,
            "decisions_24h": [dict(r) for r in decisions],
        }))
        return
    print(f"instance {instance or '?'} · bot {bot or '?'}")
    print("\nsessions")
    table([[s["name"], s["role"], s["state"], s["item"], age(s["last_heartbeat"], now)] for s in sessions],
          ["name", "role", "state", "item", "beat"])
    print("\nitems")
    table([[i["id"], f"{i['state'] or ''} (left over)" if i["left_over_at"] else i["state"], i["pr"], i["session"], i["waits_for"]]
           for i in items],
          ["id", "state", "pr", "session", "waits"])
    print("\nopen asks")
    table([[k["id"], k["story"], k["priority"], age(k["opened_at"], now)] for k in asks],
          ["id", "story", "prio", "age"])
    print("\nqueue")
    print("  " + (" ".join(queue) if queue else "(empty)"))
    print("\ndecisions (24h)")
    table([[d["id"], d["story"], d["decided_by"], "veto" if d["vetoed_at"] else "", d["summary"]]
           for d in decisions], ["id", "story", "by", "veto", "summary"])


def cmd_prune(con, a):
    """Remove heartbeats and messages older than N days."""
    limit = (parse_iso(a.at) - timedelta(days=a.days)).strftime("%Y-%m-%dT%H:%M:%SZ")
    with con:
        con.execute("DELETE FROM heartbeats WHERE at < ?", (limit,))
        con.execute("DELETE FROM messages WHERE at < ?", (limit,))


# --- snapshot ---
# `snapshot take` writes 1 versioned, scrubbed JSON snapshot of the line (STORY-443). Each view of the
# floor reads this and nothing else, so no view can leak a value that it did not get.
#
# How a later story adds data and keeps SCHEMA_VERSION at 1: it adds a new top-level section or a new field of
# a row, with its form, to SNAPSHOT_FIELDS (or RULE_FIELDS, for a field of a rule set), and 1 new key or field
# of `build_snapshot`. A story that removes or renames a key, or changes the meaning or the type of a value,
# adds 1 to SCHEMA_VERSION. A reader ignores a key that it does not know, and a reader that gets a higher
# number, or a number below 1, judges nothing in that line (`unknown schema <n>`). A story that adds a key, a
# section or a field to `build_snapshot` adds it to `rebuild_snapshot` in the same change (STORY-513).

SCHEMA_VERSION = 1
FLOOR_CONFIG = os.path.join(".claude", "sofa-floor.json")
FLOOR_MAX_BYTES = 262144
FLOOR_SETS = ["health", "streams", "prices"]

_NAME = re.compile(r"[a-z0-9][a-z0-9._-]{0,63}")
_ROLE = re.compile(r"[a-z][a-z0-9-]{0,39}")
_MODEL = re.compile(r"[a-z0-9][a-z0-9.\[\]-]{0,63}")
_STATE = re.compile(r"[a-z][a-z _-]{0,31}")
_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]{0,79}")
_TIME = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z")
_PR = re.compile(r"[0-9]{1,9}")
_UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.IGNORECASE)
_LEVEL, _CONFIDENCE = set(DECISION_LEVELS), set(DECISION_CONFIDENCES)
_REVERSIBILITY, _VISIBILITY = set(DECISION_REVERSIBILITIES), set(DECISION_VISIBILITIES)

# A section of the snapshot: the query of cmd_report, and each field that may go into it with its form (a regex,
# fullmatch, or a set of words). The field `stage` of `items` is not a column: build_snapshot computes it from
# STATE_STAGES. A field that is not here goes nowhere: only a list of allowed fields is safe,
# because the free-text columns (waits_for, summary) and the person columns (decided_by, by_whom) hold any text.
SNAPSHOT_FIELDS: dict[str, tuple[str, dict]] = {
    "sessions": ("SELECT * FROM sessions ORDER BY name", {
        "name": _NAME, "role": _ROLE, "model": _MODEL, "state": _STATE, "item": _ID,
        "since": _TIME, "last_heartbeat": _TIME, "free_since": _TIME}),
    "items": ("SELECT * FROM items ORDER BY id", {
        "id": _ID, "state": _STATE, "pr": _PR, "session": _NAME,
        "picked_up_at": _TIME, "released_at": _TIME, "updated_at": _TIME,
        "left_over_at": _TIME, "stage": set(STAGES)}),
    "open_asks": ("SELECT * FROM asks WHERE closed_at IS NULL ORDER BY opened_at", {
        "id": _ID, "story": _ID, "priority": _STATE, "opened_at": _TIME}),
    "decisions_24h": ("SELECT * FROM decisions WHERE at >= ? ORDER BY at", {
        "id": _ID, "story": _ID, "level": _LEVEL, "confidence": _CONFIDENCE,
        "reversibility": _REVERSIBILITY, "visibility": _VISIBILITY, "at": _TIME, "vetoed_at": _TIME}),
}
# The fields of each rule set that may go into the key `rules`. The story that owns a field adds it here with its
# form (D-7032, CONSTRAINT-01). `health.snapshot_max_age_seconds` (STORY-444, D-7199) is the age in seconds after
# which a reader marks the snapshot of a line as old: a whole number from 60 to 86400.
SNAPSHOT_MAX_AGE = range(60, 86401)
RULE_FIELDS: dict[str, dict] = {name: {} for name in FLOOR_SETS}
RULE_FIELDS["health"]["snapshot_max_age_seconds"] = SNAPSHOT_MAX_AGE
# The label of a line (the key line.label of the store): the name that a view shows for the line (STORY-444).
_LABEL = re.compile(r"[a-z0-9][a-z0-9-]{0,31}")
_STORE_ID = re.compile(r"[0-9a-f]{16}")

# The names that may go into the place (WHERE) of a guard message: each key that build_snapshot writes. A key of a
# dict that is not here comes from data (the store or the file), so it never goes into a message (STORY-485). A story
# that adds a section, a key or a field adds its name here, in the same change. Each name is a word of the script:
# a key that comes from data (a login, a path, a work order) is never added here.
WHERE_NAMES = frozenset({
    "schema_version", "taken_at", "line", "store", "label", "queue", "rules", "rules_digest", "nulled",
    *SNAPSHOT_FIELDS, *(f for _, fields in SNAPSHOT_FIELDS.values() for f in fields),
    *FLOOR_SETS, *(f for fields in RULE_FIELDS.values() for f in fields),
})

GUARD_MIN_CHARS = 4


class Scrubber:
    """Keep a value only when it has the form of its field, and count each value that it replaces."""

    def __init__(self):
        self.nulled = 0

    def value(self, form, value):
        """FORM is a regex (fullmatch), a set of words, or a `range` (a whole number inside it; a boolean and a
        float are no whole number)."""
        if value is None:
            return None
        if isinstance(form, range):
            ok = type(value) is int and value in form
        else:
            ok = isinstance(value, str) and (value in form if isinstance(form, set) else form.fullmatch(value))
        if ok:
            return value
        self.nulled += 1
        return None

    def drop(self):
        """Count 1 value that goes nowhere because its container has the wrong type, and give null (STORY-513)."""
        self.nulled += 1
        return None


def read_floor_config(path):
    """Read and check the floor configuration. Return its 3 rule sets. Raise UsageError (exit 1)."""
    where = f"the floor configuration {path}"
    if not os.path.exists(path):
        raise UsageError(f"no floor configuration: {path} does not exist; create it with the keys "
                         "schema_version (1), health, streams and prices")
    try:
        with open(path, "rb") as f:
            raw = f.read(FLOOR_MAX_BYTES + 1)
    except OSError as e:
        raise UsageError(f"{where} cannot be read: {e.strerror or type(e).__name__}") from None
    if len(raw) > FLOOR_MAX_BYTES:
        raise UsageError(f"{where} is over {FLOOR_MAX_BYTES} bytes")
    try:
        data = json.loads(raw)
    except (ValueError, RecursionError) as e:
        raise UsageError(f"{where} is not JSON: {e if isinstance(e, json.JSONDecodeError) else type(e).__name__}") from None
    if not isinstance(data, dict):
        raise UsageError(f"{where}: the top level is not a JSON object")
    for key in ["schema_version"] + FLOOR_SETS:
        if key not in data:
            raise UsageError(f"{where}: {key} is missing")
    if type(data["schema_version"]) is not int or data["schema_version"] != 1:
        raise UsageError(f"{where}: schema_version is not 1")
    for key in FLOOR_SETS:
        if not isinstance(data[key], dict):
            raise UsageError(f"{where}: {key} is not a JSON object")
    for key in data:
        if key != "schema_version" and key not in FLOOR_SETS:
            raise UsageError(f"{where}: {key} is not a key of the file")
    return {key: data[key] for key in FLOOR_SETS}


def dump(obj, ascii_only=True):
    """The one JSON text of this module: sorted keys, no space, so the same state gives the same text."""
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=ascii_only)


def build_snapshot(con, sets, at, store):
    """Return the snapshot of version 1 as a dict. SETS are the rule sets as read from the file.

    The caller has an open read transaction (`cmd_snapshot_take`), so all sections show 1 state of the store.
    """
    scrub = Scrubber()
    day_ago = (parse_iso(at) - timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
    # The label is the key line.label of the store; a store with no such key gets line-<6 hex digits of its id>.
    row = con.execute("SELECT value FROM kv WHERE key = 'line.label'").fetchone()
    label = scrub.value(_LABEL, row[0] if row else f"line-{store[:6]}")
    snap = {"schema_version": SCHEMA_VERSION, "taken_at": at, "line": {"store": store, "label": label}}
    for section, (query, fields) in SNAPSHOT_FIELDS.items():
        rows = con.execute(query, (day_ago,) if "?" in query else ()).fetchall()
        # `items.stage` is no column. It comes from STATE_STAGES in Python, and not from the query: the query must stay
        # `SELECT * FROM items` (D-7303). A state with no stage gives null.
        snap[section] = [{f: scrub.value(form, STATE_STAGES.get(r["state"]) if (section, f) == ("items", "stage") else r[f])
                          for f, form in fields.items()} for r in rows]
    snap["queue"] = [scrub.value(_ID, r["item"])
                     for r in con.execute("SELECT item FROM queue ORDER BY position")]
    snap["rules"] = {name: {f: scrub.value(form, sets[name][f]) for f, form in RULE_FIELDS[name].items()
                            if f in sets[name]} for name in FLOOR_SETS}
    snap["rules_digest"] = "sha256:" + hashlib.sha256(dump(sets).encode()).hexdigest()
    snap["nulled"] = scrub.nulled
    return snap


def private_values(con, db_path_arg, limit=None):
    """The values that no snapshot may hold, as a list of (kind, value). A value under 4 characters is left out.

    LIMIT: the time limit of the git call of main_folder (None: no limit, as on main, for `snapshot take`). A
    GitTimeout is not caught here: the caller stops, and the main folder never leaves the list without a word.
    """
    found = []

    def add(kind, values):
        found.extend((kind, v.strip()) for v in values if isinstance(v, str) and len(v.strip()) >= GUARD_MIN_CHARS)

    # A session id that is its own name is no secret: the name goes into the snapshot on purpose. A real store holds
    # such a row (a stopped session that was written by hand), and it would stop the snapshot each time. An id of the
    # form of a UUID is a real session id (issue 2097), so it stays on the list also when it is its own name.
    add("a session id", [sid for sid, name in con.execute("SELECT id, name FROM sessions")
                         if (sid or "").strip() != (name or "").strip() or _UUID.fullmatch((sid or "").strip())])
    paths = [r[0] for r in con.execute("SELECT worktree FROM items")]
    paths.append(os.environ.get("HOME"))
    paths.append(os.path.realpath(os.path.dirname(os.path.abspath(db_path_arg))))
    try:
        paths.append(main_folder(limit))
    except (subprocess.CalledProcessError, OSError):
        pass
    add("a path", paths)
    logins = []
    for (who,) in con.execute("SELECT decided_by FROM decisions UNION ALL SELECT by_whom FROM interactions"):
        m = re.fullmatch(r"human:(.+)", who or "", re.DOTALL)
        if m:
            logins.append(m.group(1))
    add("a person login", logins)
    add("a machine value", [r[0] for r in con.execute("SELECT value FROM kv WHERE key LIKE 'machine.%'")])
    return found


def _texts(obj, where, found, extend):
    """Add each text of OBJ (a parsed JSON value) to FOUND as (where, text): each key of a dict, each string, and the
    text of each number. A boolean and null have no text of a value, so they are left out.

    WHERE of a key is the path of its dict, and WHERE of a value is its own path (a list adds nothing). A key adds a
    part to the path of its value only when the path is still open and the text of the key is in WHERE_NAMES. Below
    any other key, the path stops: that value and each node under it get the path of the dict, so no key of the store
    or of the file goes into a message (STORY-485). When EXTEND is false, the path is closed from the start, because
    the keys of that OBJ come from the file.
    """
    stack = [(where, obj, extend)]
    while stack:
        path, node, grows = stack.pop()
        if isinstance(node, dict):
            found.extend((path, str(k)) for k in node)
            for k, v in node.items():
                name = str(k)
                if grows and name in WHERE_NAMES:
                    stack.append((f"{path}.{name}" if path else name, v, True))
                else:
                    stack.append((path, v, False))
        elif isinstance(node, list):
            stack.extend((path, v, grows) for v in node)
        elif isinstance(node, str):
            found.append((path, node))
        elif isinstance(node, (int, float)) and not isinstance(node, bool):
            found.append((path, str(node)))


def snapshot_strings(snap, sets):
    """Each text that goes into the snapshot, or that the file holds in a rule set, as (where, text).

    This is the full JSON text of spec row 10: the keys, the strings and the numbers of the snapshot and of the rule
    sets. WHERE is a path of names of `WHERE_NAMES` (`items.id`; a key adds its dict), or `the snapshot`, or `the
    floor configuration set <name>`. WHERE holds only names of `WHERE_NAMES`: a key of the store or of the file adds a
    part only when its text is such a name, and below any other key the path stops, so no other text of the store or
    of the file goes into WHERE.
    """
    found = []
    _texts(snap, "", found, True)
    for name in FLOOR_SETS:
        _texts(sets[name], f"the floor configuration set {name}", found, False)
    return [(where or "the snapshot", text) for where, text in found]


def guard_snapshot(con, a, snap, sets, code=1):
    """Fail closed: stop when the snapshot, or a rule set of the file, holds a known private value (any letter case).

    The rule sets are read too, because version 1 copies none of their fields into the snapshot, so a path in the
    file would not show in the snapshot, and the file is the place where an operator can write one. The message names
    the kind and where the value is (never the value), so the operator can find it.
    """
    strings = [(where, s.casefold()) for where, s in snapshot_strings(snap, sets)]
    for kind, value in private_values(con, a.db_path):
        needle = value.casefold()
        where = sorted({w for w, s in strings if needle in s})
        if where:
            raise UsageError(f"the snapshot holds {kind}; no snapshot written (in {', '.join(where[:5])})", code=code)


def write_atomic(path, text):
    """Write TEXT to PATH through a temporary file in the same folder, so a reader sees all of it or none."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(path)), prefix=".snapshot-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
        tmp = None
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def snapshot_text(con, a, code):
    """The snapshot text of this line (rows 3 to 5 and 15): read the floor configuration, take the store id, then
    build and guard the snapshot in 1 read transaction. CODE is the exit code of a refusal of the guard."""
    path = a.config
    if not path:
        try:
            path = os.path.join(main_folder(), FLOOR_CONFIG)
        except (subprocess.CalledProcessError, OSError):
            raise UsageError("not in a git repository; give --config") from None
    sets = read_floor_config(path)
    store = store_id(con)  # a write only when the store has no id yet: it commits at once
    # 1 read transaction for each read below (WAL): the sections and the guard show 1 state of the store, also when
    # another session writes while this command runs.
    con.execute("BEGIN")
    try:
        snap = build_snapshot(con, sets, a.at, store)
        guard_snapshot(con, a, snap, sets, code=code)
        return dump(snap) + "\n", snap
    except RecursionError:
        raise UsageError("the floor configuration is nested too deep; no snapshot written") from None
    finally:
        con.rollback()


def cmd_snapshot_take(con, a):
    """Write 1 scrubbed snapshot of this line as JSON, to stdout or to --out."""
    text, _ = snapshot_text(con, a, 1)
    if a.out:
        write_atomic(a.out, text)
    else:
        sys.stdout.write(text)


# --- snapshot publish and snapshot lines (STORY-444) ---
# Each line pushes its snapshot to 1 ref of origin, `refs/sofa-floor/<store id>`, and a reader gets the snapshot of
# each line from the refs. The ref holds 1 commit with no parent, so a new snapshot replaces the old one (ADR-0012,
# ADR-0013). The only forced push of the team is the push of the own ref with an explicit old id (rule 24).
FLOOR_REF = "refs/sofa-floor/"
# The local name of a line in the scratch repository of the reader. It is outside refs/sofa-floor/*, so only
# snapshot publish writes a ref refs/sofa-floor/* (ADR-0012, decision 2), also in a local repository (STORY-513).
READ_REF = "refs/sofa-read/"
READ_FAILED = "cannot read the lines"
LINE_MAX_BYTES = 1048576
# The reader reads each line of the form, with no maximum count (ADR-0012, decision 3; STORY-513, D-7398).
# The fetch takes 1 commit of each line (--depth=1) and, when origin honors the filter, no blob of LINE_MAX_BYTES + 1
# bytes or more. It does not limit the count of the lines, the count of the blobs of a tree, or a ref that names a blob
# or a tag of a blob (git sends an object that a ref names, whole). SOFA_GIT_TIMEOUT limits the time of the call, the
# scratch repository goes after the run, and read_line reads at most LINE_MAX_BYTES of each line.
# blob:limit=<n> leaves out each blob of n bytes or more, so n is LINE_MAX_BYTES + 1: a blob of LINE_MAX_BYTES stays.
READ_FILTER = f"blob:limit={LINE_MAX_BYTES + 1}"
_DIGEST = re.compile(r"sha256:[0-9a-f]{64}")
# nulled of another line: a whole number from 0 to LINE_MAX_BYTES (a snapshot cannot null more values than its bytes).
NULLED_FORM = range(0, LINE_MAX_BYTES + 1)
SNAPSHOT_FILE = "snapshot.json"


def remote_old(git, ref):
    """The object id that REF has on origin, or an empty text when origin has no such ref."""
    for row in git.must("ls-remote", "origin", ref).splitlines():
        oid, _, name = row.partition("\t")
        if name.strip() == ref:
            return oid.strip()
    return ""


def make_snapshot_commit(git, text, taken_at):
    """Write the commit of the snapshot into the object store of the repository and return its id: the file
    snapshot.json (mode 100644), a tree with that 1 entry, no parent, and the identity sofa-state (never the identity
    of the person), the date TAKEN_AT, the message `snapshot <taken_at>`."""
    blob = git.must("hash-object", "-w", "--stdin", stdin=text).strip()
    tree = git.must("mktree", stdin=f"100644 blob {blob}\t{SNAPSHOT_FILE}\n").strip()
    stamp = f"{int(parse_iso(taken_at).timestamp())} +0000"
    who = {"GIT_AUTHOR_NAME": "sofa-state", "GIT_AUTHOR_EMAIL": "sofa-state@localhost", "GIT_AUTHOR_DATE": stamp,
           "GIT_COMMITTER_NAME": "sofa-state", "GIT_COMMITTER_EMAIL": "sofa-state@localhost",
           "GIT_COMMITTER_DATE": stamp}
    return git.must("-c", "commit.gpgsign=false", "commit-tree", tree, "-m", f"snapshot {taken_at}",
                    extra=who).strip()


def cmd_snapshot_publish(con, a):
    """Push the scrubbed snapshot of this line to refs/sofa-floor/<store id> on origin (rows 3 to 8, 15 and 19)."""
    # The store id names the ref of the push, so it must have the form of a store id before the first git call
    # (STORY-513, item a): `snapshot_text` already runs git (the guard reads the main folder). A store with no id gets
    # a new id of that form from `store_id`. The message names the rule, never the value of the store.
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    if row is not None and not (isinstance(row[0], str) and _STORE_ID.fullmatch(row[0])):
        raise UsageError(f"{PUBLISH_FAILED}: the store id (the key decision.store) is not 16 hex digits "
                         f"(0-9, a-f); {PUBLISH_TAIL}")
    text, snap = snapshot_text(con, a, 3)  # a config error and a refusal of the guard stop before the first git call
    # The ref comes from the id of the snapshot (the id that store_id read or wrote). Another writer can change the
    # row after the check above, so the id of the snapshot is checked again before the commit and the push.
    store = snap["line"]["store"]
    if not (isinstance(store, str) and _STORE_ID.fullmatch(store)):
        raise UsageError(f"{PUBLISH_FAILED}: the store id (the key decision.store) is not 16 hex digits "
                         f"(0-9, a-f); {PUBLISH_TAIL}")
    if not has_app_values(con):
        raise UsageError(f"{PUBLISH_FAILED}: the store has no App values; run /sofa:setup")
    git = Git(repo_of_store(a, PUBLISH_FAILED), failed=PUBLISH_FAILED, tail=PUBLISH_TAIL, short=PUBLISH_TAIL)
    problem = app_setup_ok(con, git, origin_url(git))
    if problem:
        raise UsageError(f"{PUBLISH_FAILED}: this session has no App git setup ({problem}); {PUBLISH_TAIL}")
    ref = f"{FLOOR_REF}{store}"
    commit = make_snapshot_commit(git, text, snap["taken_at"])
    old = remote_old(git, ref)
    for attempt in (1, 2):
        # The lease names the old id that we read, so another publish of this store between the read and the push
        # makes git refuse (an empty old id means that the ref must not exist).
        rc, _, err = git.run("push", "origin", f"--force-with-lease={ref}:{old}", f"{commit}:{ref}")
        if rc == 0:
            print(f"published {ref} {snap['taken_at']}")
            return
        new = remote_old(git, ref)
        if attempt == 2 or new == old:
            raise git.failure("push", rc, err)
        old = new  # the lease was stale: read again and push 1 more time


def floor_names(git):
    """The names of the lines on origin, from `git ls-remote origin refs/sofa-floor/*` (STORY-513, item c).

    Return (NAMES, BAD). NAMES are the names `refs/sofa-floor/<store id>` in sorted order, with no maximum count. BAD
    counts the names under refs/sofa-floor/ whose part after it is not a store id. `ls-remote` matches the tail of a
    name, so a name that does not start with refs/sofa-floor/ (refs/heads/refs/sofa-floor/<id>) names no floor ref and
    is not counted.
    No name of origin goes into an output: names of origin are data."""
    names, bad = [], 0
    for row in git.must("ls-remote", "origin", FLOOR_REF + "*").splitlines():
        name = row.partition("\t")[2].strip()
        if not name.startswith(FLOOR_REF) or name.endswith("^{}"):
            continue  # not under refs/sofa-floor/, or the peeled line of a tag: no floor ref
        if _STORE_ID.fullmatch(name[len(FLOOR_REF):]):
            names.append(name)
        else:
            bad += 1
    names.sort()
    return names, bad


def scratch_url(top, url):
    """The URL of origin for the scratch repository of the reader. A relative path names a folder from the main folder
    TOP, and the scratch is in another folder, so it becomes absolute. A URL with a scheme, an absolute path and an scp
    address (host:path, with no / before the first :) stay as they are, as git reads them."""
    if "://" in url or os.path.isabs(url):
        return url
    colon, slash = url.find(":"), url.find("/")
    if colon > 0 and (slash < 0 or colon < slash):
        return url
    return os.path.normpath(os.path.join(top, url))


def add_origin(repo, url):
    """Write the remote origin with URL into the config of the scratch repository REPO, with no git call, so the URL
    is not an argument of `git fetch` or of `git config`. A fetch with --filter needs a remote with a name (git writes
    `remote.<name>.promisor`, and a name cannot start with /). For an http(s) URL, git still gives the URL to its
    remote helper (`git remote-http origin <url>`) as an argument, as on main and for the ls-remote of the main
    folder."""
    value = url.replace("\\", "\\\\").replace('"', '\\"')
    with open(os.path.join(repo, ".git", "config"), "a", encoding="utf-8") as config:
        config.write(f'[remote "origin"]\n\turl = "{value}"\n')


def no_warnings(err):
    """The stderr ERR of a failed fetch with no `warning:` line, so that the reason is the line of the error."""
    kept = [line for line in err.splitlines() if not line.strip().startswith("warning:")]
    return "\n".join(kept) if kept else err


REFUSED = re.compile(r"filter '[^']*' not supported|does not support shallow")


def refused(err):
    """True when the stderr ERR of a failed fetch (LC_ALL=C) says that git or origin refused the filter or the depth:
    `filter 'blob:limit' not supported` (upload-pack, uploadpackfilter.<kind>.allow false), `dumb http transport does
    not support shallow capabilities`, `Server does not support shallow clients`."""
    return REFUSED.search(err) is not None


def new_scratch(git, url, form):
    """A new scratch repository of the reader and a Git object for its calls. The folder is new in TMPDIR (mode 700).
    The repository has the object format FORM of the main folder, no hook (--template=), and the remote origin with
    URL. It is not bare, because a person with safe.bareRepository=explicit cannot use a bare repository that git finds
    by its folder. The calls take the env of the main folder (the GIT_CONFIG_* of the session, the ssh command, no key
    of REPO_ENV_KEYS), GIT_NO_LAZY_FETCH=1, so no read fetches a blob that the filter left out, and LC_ALL=C, so the
    text of a refusal (refused) is not translated."""
    scratch = tempfile.mkdtemp(prefix="sofa-floor-")
    try:
        local = copy.copy(git)  # no second Git(): its constructor runs git in the folder before the init
        local.repo, local.env = scratch, {**git.env, "GIT_NO_LAZY_FETCH": "1", "LC_ALL": "C"}
        local.must("init", "-q", "--template=", f"--object-format={form}")
        add_origin(scratch, scratch_url(git.repo, url))
    except BaseException:
        shutil.rmtree(scratch, ignore_errors=True)
        raise
    return scratch, local


def cmd_snapshot_lines(con, a):
    """Print the snapshot of each line on origin as JSON (rows 10 to 13; STORY-513, items b and c)."""
    git = Git(repo_of_store(a, READ_FAILED), failed=READ_FAILED, tail="", short="")
    url = origin_url(git)  # origin must have 1 URL; no App check, so a session with no App values reads the lines too
    read_at = a.now or now_iso()
    row = con.execute("SELECT value FROM kv WHERE key = 'decision.store'").fetchone()
    own = row[0] if row else None  # a read: this command writes no store id
    names, bad = floor_names(git)
    lines = []
    if names:
        # The fetch runs in a scratch repository (new_scratch), never in the main folder: a fetch with --filter
        # writes the config of the repository that runs it (a partial clone: promisor, partialclonefilter), and the
        # objects of another line must not stay in the main folder. The object format is the format of the main
        # folder, not the default of the person (init.defaultObjectFormat, GIT_DEFAULT_HASH): a scratch of another
        # format cannot fetch from origin. The folder goes in `finally`.
        form = git.must("rev-parse", "--show-object-format").strip()
        limits = ["--depth=1", f"--filter={READ_FILTER}"]
        scratch, local = new_scratch(git, url, form)
        try:
            for attempt in (1, 2):
                rc, _, err = local.run("fetch", "--no-tags", "--no-write-fetch-head", "--refmap=", *limits,
                                       "origin", *(f"{name}:{READ_REF}{name[len(FLOOR_REF):]}" for name in names))
                if rc == 0:
                    break
                if attempt == 2:
                    raise local.failure("fetch", rc, no_warnings(err))
                if refused(err):
                    # git or origin refused the filter or the depth (Done when 3: "else the current read"): the 1 more
                    # fetch has no filter and no depth, in a new scratch, because the refused fetch already wrote the
                    # promisor config of the filter. read_line checks the size of each line. A lost name after this
                    # exits 1: the read has at most 2 fetches, and the first failure takes the second.
                    limits = []
                    shutil.rmtree(scratch, ignore_errors=True)
                    scratch, local = new_scratch(git, url, form)
                    continue
                # A name that origin lost between the ls-remote and the fetch fails the whole fetch: read the names
                # again and fetch 1 more time. The same names exit 1.
                again = floor_names(git)
                if again[0] == names:
                    raise local.failure("fetch", rc, no_warnings(err))
                names, bad = again
                if not names:
                    break
            if names:
                # No remote after the fetch: a read of a blob that the filter left out then fails with no fetch,
                # because the scratch has no promisor remote (probe 8, C3, on git 2.50.1; build step 6 checks the git
                # of CI; an unset remote.origin.promisor alone does not stop the fetch), and the URL leaves the config
                # of the scratch. GIT_NO_LAZY_FETCH=1 (git 2.45 and later) is the second guard.
                local.must("config", "--remove-section", "remote.origin")
                stores = [name[len(FLOOR_REF):] for name in names]
                lines = [read_line(local, READ_REF + store, store, read_at, own) for store in stores]
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
    lines.sort(key=lambda line: (line["label"] is None, line["label"] or "", line["store"]))
    out = {"lines": lines, "read_at": read_at}
    if bad:
        out["skipped"] = {"bad_name": bad}
    sys.stdout.write(dump(out) + "\n")


def read_line(git, name, store, read_at, own):
    """The line of the ref NAME (refs/sofa-read/STORE in the scratch repository of the reader): its snapshot, or the
    reason that no snapshot is there. The text comes from another machine, so it is data: a bad line gives an error,
    never a stop. The snapshot of the line is rebuilt from the known keys (rebuild_snapshot), never the parsed text."""
    line = {"store": store, "label": None, "taken_at": None, "age_seconds": None, "old": None,
            "own": store == own, "schema_version": None, "snapshot": None, "error": None}

    def bad(message):
        line["error"] = message
        return line

    # The entry first, with no read of the blob: the filter of the fetch can leave the blob out (STORY-513, item c).
    rc, entry, _ = git.run("ls-tree", name, SNAPSHOT_FILE)
    meta, _, path = entry.partition("\t")
    parts = meta.split()
    if rc != 0 or path.strip() != SNAPSHOT_FILE or len(parts) != 3 or parts[1] != "blob":
        return bad(f"the ref has no {SNAPSHOT_FILE}")
    blob = parts[2]
    if git.run("cat-file", "-e", blob)[0] != 0:
        return bad(f"the snapshot is over {LINE_MAX_BYTES} bytes")  # the filter left out a blob over the limit
    rc, size, _ = git.run("cat-file", "-s", blob)
    if rc != 0 or not size.strip().isdigit():
        return bad(f"the ref has no {SNAPSHOT_FILE}")
    if int(size.strip()) > LINE_MAX_BYTES:
        return bad(f"the snapshot is over {LINE_MAX_BYTES} bytes")  # origin did not honor the filter
    rc, text, _ = git.run("cat-file", "blob", blob)
    if rc != 0:
        return bad(f"the ref has no {SNAPSHOT_FILE}")
    try:
        snap = json.loads(text)
    except (ValueError, RecursionError):
        return bad("the snapshot is not JSON")
    if not isinstance(snap, dict):
        return bad("the snapshot is not 1 JSON object")
    version = snap.get("schema_version")
    if type(version) is not int:
        return bad("schema_version is not a whole number")
    line["schema_version"] = version
    if version > SCHEMA_VERSION or version < 1:
        return bad(f"unknown schema {version}")
    taken = snap.get("taken_at")
    try:
        taken_dt = parse_iso(taken) if isinstance(taken, str) and _TIME.fullmatch(taken) else None
    except ValueError:
        taken_dt = None
    if taken_dt is None:
        return bad("taken_at is not a time of the form YYYY-MM-DDTHH:MM:SSZ")
    info = snap.get("line") if isinstance(snap.get("line"), dict) else {}
    named = info.get("store")
    if named != store:
        return bad(f"the snapshot names store {named}" if isinstance(named, str) and _STORE_ID.fullmatch(named)
                   else "the snapshot names no store of the form of a store id")
    clean = rebuild_snapshot(snap, store)
    line["label"] = clean["line"].get("label")
    line["taken_at"] = taken
    line["age_seconds"] = age = max(0, int((parse_iso(read_at) - taken_dt).total_seconds()))
    limit = ((clean.get("rules") or {}).get("health") or {}).get("snapshot_max_age_seconds")
    line["old"] = age > limit if type(limit) is int else None
    line["snapshot"] = clean
    return line


def scrub_rows(scrub, rows, fields):
    """The rows of 1 section of another line: each row keeps only the fields of FIELDS, each with its form. A section
    that is not a list is null, and a row that is not an object goes nowhere; each counts 1 in nulled."""
    if not isinstance(rows, list):
        return scrub.drop()
    out = []
    for row in rows:
        if isinstance(row, dict):
            out.append({f: scrub.value(form, row[f]) for f, form in fields.items() if f in row})
        else:
            scrub.drop()
    return out


def scrub_rules(scrub, rules):
    """The rule sets of another line: only the sets of FLOOR_SETS, and in each set only the fields of RULE_FIELDS."""
    if not isinstance(rules, dict):
        return scrub.drop()
    out = {}
    for name in FLOOR_SETS:
        if name in rules:
            fields = rules[name]
            out[name] = ({f: scrub.value(form, fields[f]) for f, form in RULE_FIELDS[name].items() if f in fields}
                         if isinstance(fields, dict) else scrub.drop())
    return out


def rebuild_snapshot(snap, store):
    """The snapshot of another line, rebuilt from the known keys of version 1 (STORY-513, item b).

    SNAP passed the checks of read_line (schema_version, taken_at, line.store). The rebuild takes only the keys that
    build_snapshot writes, each with the form of its field (SNAPSHOT_FIELDS, RULE_FIELDS, the Scrubber). A value that
    does not have its form is null, and nulled adds 1 for it to the nulled of the publisher. An unknown key goes
    nowhere and is not counted, because a reader ignores an unknown key (the rule of change of STORY-443). A known key
    that the snapshot does not hold stays out. The parsed object never goes into the output."""
    scrub = Scrubber()
    out = {"schema_version": snap["schema_version"], "taken_at": snap["taken_at"], "line": {"store": store}}
    if "label" in snap["line"]:
        out["line"]["label"] = scrub.value(_LABEL, snap["line"]["label"])
    for section, (_, fields) in SNAPSHOT_FIELDS.items():
        if section in snap:
            out[section] = scrub_rows(scrub, snap[section], fields)
    if "queue" in snap:
        queue = snap["queue"]
        out["queue"] = [scrub.value(_ID, item) for item in queue] if isinstance(queue, list) else scrub.drop()
    if "rules" in snap:
        out["rules"] = scrub_rules(scrub, snap["rules"])
    if "rules_digest" in snap:
        out["rules_digest"] = scrub.value(_DIGEST, snap["rules_digest"])
    base = scrub.value(NULLED_FORM, snap.get("nulled", 0))
    out["nulled"] = (base or 0) + scrub.nulled
    return out


# --- rows: remove or rename 1 row of items or sessions (STORY-503) ---
# The guard of `snapshot take` refuses a snapshot when a key (items.id, sessions.name) holds a private value, and no
# other leaf changes a key: `item set` and `session upsert` write a row by its key. These 4 leaves change 1 key row,
# and only a row that the guard refuses. They are a delete of data, so the rule card of the STORY-503 spec decides
# who runs them and when. Each of the 4 records the old key as retired (a digest in kv), and the writers of a key call
# refuse_retired, so no writer writes a key again that the operator took out. Any other key passes as on main.
# A twin of a key K is another key of the same table that is K in any letter case, and is not the exact text of K. The
# 1 rule of the twins: at each place that compares a key or a reference, a key that has a twin compares the exact text,
# and a key with no twin compares in any letter case, as the guard (compare_of). A writer of the exact text of a live
# key passes refuse_retired, also when its twin was taken out. Each of the 9 writers checks under the write lock of
# its write (BEGIN IMMEDIATE before refuse_retired), so a writer that starts during a rename reads the kv row of the
# rename after its commit (review 3, T1).

# For each table: the key column, the form of a key (the form of the field in SNAPSHOT_FIELDS: the snapshot keeps
# only a value of this form), the places of the snapshot that hold a reference to the key (section and field; a
# remove stops while one holds it), and each column of the store that holds a reference (a rename writes the new key
# into each). An item id is also the story id of asks, decisions and interactions (story_metrics reads them with 1
# value). A story that adds a field of the snapshot that holds a key adds it here in the same change, as for
# WHERE_NAMES.
ROW_TABLES = {
    "items": {"key": "id", "form": _ID, "label": "item",
              "places": [("sessions", "item"), ("queue", "item"), ("open_asks", "story"), ("decisions_24h", "story")],
              "refs": [("sessions", "item"), ("queue", "item"), ("trips", "item"), ("usage", "item"),
                         ("messages", "subject"), ("asks", "story"), ("decisions", "story"),
                         ("interactions", "story")]},
    "sessions": {"key": "name", "form": _NAME, "label": "session",
                 "places": [("items", "session")],
                 "refs": [("items", "session"), ("heartbeats", "name"), ("usage", "session"),
                            ("messages", "from_name"), ("messages", "to_name")]},
}
# The rows of each section of the snapshot: the query of build_snapshot (decisions_24h takes the time 24 hours ago).
PLACE_QUERIES = {"queue": "SELECT item FROM queue ORDER BY position",
                 **{s: q for s, (q, _) in SNAPSHOT_FIELDS.items()}}
# The line `| Team prefix | `<prefix>` ...` of docs/adlc.md: the regex of teamPrefix in hooks/register.tsx.
TEAM_PREFIX_RE = re.compile(r"^\|\s*Team prefix\s*\|\s*`([^`<>]+)`", re.MULTILINE)
# The kv row of a key that remove or rename took out. Its value is the --at of the change.
RETIRE = "INSERT INTO kv (key, value) VALUES (?, ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value"
# The names of the copy of 1 second of --at: <store>.copy-<stamp>, then -2 to -99 (review 3, T2).
COPY_NAMES = 99
# The roadmap prefix of an item id: STORY-<n>-, FEATURE-<n>- or MILESTONE-<n>- at its start. story_metrics counts the
# work orders of a story by this prefix (STORY-502, row 20), so an item rename keeps it (row 10, D-7357).
_ROADMAP_PREFIX = re.compile(r"(STORY|FEATURE|MILESTONE)-[0-9]+-")


def roadmap_prefix(key):
    """The roadmap prefix at the start of KEY (its exact text, as story_metrics compares it), or "" for none."""
    m = _ROADMAP_PREFIX.match(key)
    return m.group(0) if m else ""


def match_rows(con, table, key):
    """The key of TABLE that is exactly KEY; when there is none, each key that is KEY in any letter case (casefold,
    the match of the guard)."""
    col = ROW_TABLES[table]["key"]
    if con.execute(f"SELECT 1 FROM {table} WHERE {col} = ?", (key,)).fetchone():
        return [key]
    needle = key.casefold()
    return [k for (k,) in con.execute(f"SELECT {col} FROM {table}") if (k or "").casefold() == needle]


# The 2 compares of compare_of, as SQL conditions on the column {c} with 1 parameter.
EXACT, ANY_CASE = "{c} = ?", "lower({c}) = lower(?)"
# For each table: the column of usage that holds its key, and the other column of UNIQUE(session, item).
USAGE_PAIR = {"items": ("item", "session"), "sessions": ("session", "item")}


def compare_of(con, table, key):
    """The compare of a key or a reference with KEY of TABLE: EXACT when KEY has a twin, else ANY_CASE (the match of
    the guard). The forms _ID and _NAME are ASCII, so lower() gives the result of casefold() for a key of the form."""
    col = ROW_TABLES[table]["key"]
    twin = con.execute(f"SELECT 1 FROM {table} WHERE lower({col}) = lower(?) AND {col} != ?", (key, key)).fetchone()
    return EXACT if twin else ANY_CASE


def holds_private(values, text):
    """True when TEXT holds a value of VALUES (the list of `private_values`) in any letter case, as the guard tests
    it."""
    folded = text.casefold()
    return any(v.casefold() in folded for _, v in values)


def retired_key(table, key):
    """The kv key that records KEY of TABLE as taken out: the sha256 of the casefolded key, so the store keeps no old
    key, and the match is in any letter case, as the match of the guard."""
    digest = hashlib.sha256(key.casefold().encode("utf-8", "surrogateescape")).hexdigest()
    return f"rows.retired.{table}.{digest}"


def refuse_retired(con, a, table, value, arg):
    """Stop a writer that would write a key that remove or rename took out of TABLE. Exit 1 and write nothing.

    VALUE passes when it is exactly a key of TABLE (the table of its key kind): a live key, also the twin of a key that
    was taken out, or a key that a rename gave again. Else VALUE is refused when kv records it as retired, in any
    letter case. Any other value passes as on main, also a new key that holds a private value: the guard and the route
    of STORY-444 handle it. It does no form check, reads no private value and starts no git. The message names ARG,
    never the value.
    """
    if not value:
        return
    col = ROW_TABLES[table]["key"]
    if con.execute(f"SELECT 1 FROM {table} WHERE {col} = ?", (value,)).fetchone():
        return
    if con.execute("SELECT 1 FROM kv WHERE key = ?", (retired_key(table, value),)).fetchone():
        raise UsageError(f"{a.cmd} {a.sub}: {arg} is a key that the operator took out of {table}; no change "
                         "(use the new key)")


def team_prefix(a):
    """The team prefix of docs/adlc.md in the main folder of the store, or None.

    db_path puts the store at <main folder>/.sofa/state.db, so the main folder is the parent of the folder `.sofa`. A
    store in another folder has no main folder here, and no prefix.
    """
    folder = os.path.dirname(os.path.abspath(a.db_path))
    if os.path.basename(folder) != ".sofa":
        return None
    try:
        with open(os.path.join(os.path.dirname(folder), "docs", "adlc.md"), encoding="utf-8") as f:
            m = TEAM_PREFIX_RE.search(f.read())
    except (OSError, UnicodeDecodeError):
        return None
    return m.group(1) if m else None


def copy_store(con, a, lead):
    """Copy the store to a new file next to it with the backup API, and return the path. LEAD: the words of the leaf.

    The store runs in WAL mode, so the last writes can be in the -wal file: a copy of the main file alone can miss
    them. The backup API reads 1 consistent state. It reads through a second connection, because SQLite refuses
    (SQLITE_LOCKED) a backup from a connection that holds a write transaction, and the backup of Python then waits
    for ever. The caller holds the write lock (BEGIN IMMEDIATE) and has written nothing yet, so the second
    connection reads the state before the change, and no other session can commit between the copy and the change.
    The file is made first with O_EXCL and mode 600, so the copy is never looser than the store and never replaces a
    file. When the name <store>.copy-<stamp> is taken (2 commands in the same second of --at), the copy takes the
    next free name <store>.copy-<stamp>-2 to -99, each with O_EXCL. Each message names the file, not its folder: the
    folder can hold the home path.
    """
    stamp = a.at.replace("-", "").replace(":", "")
    first = f"{os.path.abspath(a.db_path)}.copy-{stamp}"
    for n in range(1, COPY_NAMES + 1):
        path = first if n == 1 else f"{first}-{n}"
        try:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            break
        except FileExistsError:
            continue
        except OSError as e:
            raise UsageError(f"{lead}: the copy {os.path.basename(path)} cannot be made ({e.strerror}); "
                             "no change") from None
    else:
        raise UsageError(f"{lead}: the copy {os.path.basename(first)} is there already; no change "
                         "(give another --at, not later than now)")
    os.close(fd)
    try:
        src, dst = sqlite3.connect(a.db_path, timeout=5), sqlite3.connect(path)
        try:
            src.backup(dst)
        finally:
            dst.close()
            src.close()
    except (sqlite3.Error, OSError):
        os.unlink(path)
        raise UsageError(f"{lead}: the copy {os.path.basename(path)} cannot be made; no change") from None
    except BaseException:
        os.unlink(path)
        raise
    return path


def change_row(con, a, table, key, new_key):
    """Remove (NEW_KEY None) or rename 1 row of TABLE, in 1 write transaction, after 1 copy of the store. The same
    transaction records the old key as retired (refuse_retired)."""
    t = ROW_TABLES[table]
    col, where = t["key"], f"{table}.{t['key']}"
    verb = "remove" if new_key is None else "rename"
    lead = f"{t['label']} {verb}"
    if new_key is not None and not t["form"].fullmatch(new_key):
        raise UsageError(f"{lead}: --to does not have the form of {where}; no change", code=2)
    # The time limit of the git call of the checks (review 5, risk 10). A SOFA_GIT_TIMEOUT that is not a number stops
    # the leaf here, before the write lock, with exit 2.
    try:
        limit = git_timeout()
    except UsageError as e:
        raise UsageError(f"{lead}: {e}; no change", code=e.code) from None
    con.execute("BEGIN IMMEDIATE")
    path = None
    try:
        rows = match_rows(con, table, key)
        if len(rows) != 1:
            hint = "; `report` cuts a cell at 28 characters, `report --json` gives the full key" if not rows else ""
            raise UsageError(f"{lead}: the key matches {len(rows)} rows of {table} in any letter case; no change{hint}")
        old = rows[0]
        # The guard reads the scrubbed snapshot, where a key without the form of its field is null.
        if not t["form"].fullmatch(old):
            raise UsageError(f"{lead}: the key does not have the form of {where}, so the snapshot has no such value "
                             "and the guard does not refuse it; no change")
        # 1 read of the private values for the command (1 git call, main_folder), under the write lock: the block
        # "row 11" uses this git call as its seam. Each check of a private value below uses this list (review 3, Q2).
        # The git call runs in its own process group with the time limit LIMIT, and the full group stops on the
        # limit: a git that does not end cannot hold the write lock of the team (review 5, risk 10).
        try:
            values = private_values(con, a.db_path, limit)
        except GitTimeout as e:
            raise UsageError(f"{lead}: {e}") from None
        if not holds_private(values, old):
            raise UsageError(f"{lead}: the key holds no private value of the snapshot guard, so the guard does not "
                             "refuse it; no change")
        if new_key is None:
            # The guard matches in any letter case, so a place holds the key also in another letter case, unless the
            # key has a twin: then a place in another letter case belongs to the twin, and only the exact text counts.
            same = compare_of(con, table, old)
            # The window ends at --at, and never later than now: an --at in the future (a typo of a year) would move
            # the start of the window past each decision of now, and the remove would leave a key that the snapshot
            # still refuses for 24 hours (review 6, finding 1). --at still names the copy and the retired value.
            day_ago = (min(parse_iso(a.at), datetime.now(timezone.utc)) - timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
            held = []
            for section, field in t["places"]:
                query = PLACE_QUERIES[section]
                n = con.execute(f"SELECT COUNT(*) FROM ({query}) WHERE {same.format(c=field)}",
                                ((day_ago,) if "?" in query else ()) + (old,)).fetchone()[0]
                if n:
                    held.append(f"{section if section == 'queue' else section + '.' + field} ({n} rows)")
            if held:
                raise UsageError(f"{lead}: the key is still in {', '.join(held)}; no change (rename the row instead)")
        else:
            # An item rename keeps the roadmap prefix of the old id, or has none when the old id has none (row 10,
            # D-7357). Else story_metrics moves the trips and the start of the work order to another story, or out of
            # its story.
            if table == "items" and roadmap_prefix(new_key) != roadmap_prefix(old):
                raise UsageError(f"{lead}: --to must keep the roadmap prefix of the old id; no change")
            # A bare roadmap id is the id of a roadmap row, which only the plan-auditor writes (rule 15). A rename to it
            # would turn the work order into a roadmap row (D-7393).
            if table == "items" and _ROADMAP_ID.fullmatch(new_key):
                raise UsageError(f"{lead}: --to is a bare roadmap id; no change (give a work order id)")
            # The hook counts a session as a team session only by the form <team prefix>-<role>[-n] (roleOf).
            role = con.execute("SELECT role FROM sessions WHERE name = ?", (old,)).fetchone()[0] \
                if table == "sessions" else None
            prefix = team_prefix(a) if role else None
            if prefix is not None and holds_private(values, f"{prefix}-{role}"):
                raise UsageError(f"{lead}: the team form of the row holds a private value; no change (remove the row)")
            if prefix is not None and not re.fullmatch(re.escape(f"{prefix}-{role}") + r"(-[0-9]+)?", new_key):
                raise UsageError(f"{lead}: --to does not have the form <team prefix>-<role>[-n] of the row; no change",
                                 code=2)
            if holds_private(values, new_key):
                raise UsageError(f"{lead}: --to holds a private value of the snapshot guard; no change")
            if match_rows(con, table, new_key):
                raise UsageError(f"{lead}: --to is a key of {table} already; no change")
            # A reference column that holds --to in any letter case is the history of another key (old rows of a key
            # that was removed, or rows with no key row). The rename would merge it with the history of the row, and
            # story_metrics would count both as 1 (review 3, Q1).
            history = []
            for tbl, c in t["refs"]:
                n = con.execute(f"SELECT COUNT(*) FROM {tbl} WHERE lower({c}) = lower(?)", (new_key,)).fetchone()[0]
                if n:
                    history.append(f"{tbl}.{c} ({n} rows)")
            if history:
                raise UsageError(f"{lead}: --to is in the history of other rows ({', '.join(history)}); no change "
                                 "(give another --to)")
            # A reference in another letter case is a reference to the old key, unless the old key has a twin: then
            # such a reference belongs to the twin, and only the exact text changes.
            same = compare_of(con, table, old)
            # With no twin, the rename changes each reference in any letter case. When usage holds the key in 2 letter
            # cases for 1 session (an item) or for 1 item (a session), both rows get the same pair, and
            # UNIQUE(session, item) breaks. The check of the history reads only --to, so it cannot see them (review 4,
            # F1).
            mine, other = USAGE_PAIR[table]
            if same == ANY_CASE and con.execute(
                    f"SELECT 1 FROM usage WHERE lower({mine}) = lower(?) AND {other} IS NOT NULL GROUP BY {other} HAVING COUNT(*) > 1 LIMIT 1",
                    (old,)).fetchone():
                raise UsageError(f"{lead}: usage holds the key in 2 letter cases for 1 {other}; no change "
                                 "(no rename can pass; clear each place that the remove names, then remove the row)")
        path = copy_store(con, a, lead)
        # From the copy to the commit, each error of SQLite stops the leaf with the leaf words. The rollback below
        # takes back the change and deletes the copy (review 4, F1; review 5, G2).
        try:
            if new_key is None:
                con.execute(f"DELETE FROM {table} WHERE {col} = ?", (old,))
            else:
                con.execute(f"UPDATE {table} SET {col} = ? WHERE {col} = ?", (new_key, old))
                # The check of the history refuses a --to that a reference column holds, and the check of usage
                # refuses 2 rows of usage that would get the same pair. So UNIQUE(session, item) of usage does not
                # break here. Another unique key of the store (a later index) can still break: the catch below.
                refs = sum(con.execute(f"UPDATE {tbl} SET {c} = ? WHERE {same.format(c=c)}", (new_key, old)).rowcount
                           for tbl, c in t["refs"])
            con.execute(RETIRE, (retired_key(table, old), a.at))
            con.commit()
        except sqlite3.IntegrityError:
            raise UsageError(f"{lead}: the change breaks a unique key of the store; no change") from None
        except sqlite3.Error as e:
            # Only the code name of the error (for example SQLITE_IOERR_WRITE), never its text: a trigger can put any
            # text in it, and a message names no key and no folder.
            name = getattr(e, "sqlite_errorname", type(e).__name__)
            raise UsageError(f"{lead}: the store gave an error ({name}); no change") from None
    except BaseException:
        con.rollback()
        if path is not None:
            os.unlink(path)
        raise
    print(f"copy {path}")
    if new_key is None:
        print(f"removed 1 row of {table}")
    else:
        print(f"renamed 1 row of {table}, and {refs} references to the key in other rows")


def cmd_item_remove(con, a):
    """Remove 1 item whose id the snapshot guard refuses."""
    change_row(con, a, "items", a.id, None)


def cmd_item_rename(con, a):
    """Give 1 item whose id the snapshot guard refuses a new id."""
    change_row(con, a, "items", a.id, a.to)


def cmd_session_remove(con, a):
    """Remove 1 session whose name the snapshot guard refuses."""
    change_row(con, a, "sessions", a.name, None)


def cmd_session_rename(con, a):
    """Give 1 session whose name the snapshot guard refuses a new name."""
    change_row(con, a, "sessions", a.name, a.to)


# --- output helpers ---

def table(rows, header, width=28):
    """Print rows as aligned text columns. Each cell is 1 line (plain) and is cut at WIDTH."""
    if not rows:
        print("  (none)")
        return
    cells = [[plain("" if c is None else str(c))[:width] for c in r] for r in [header] + rows]
    widths = [max(len(r[i]) for r in cells) for i in range(len(header))]
    for r in cells:
        print("  " + "  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())


def emit(rows, as_json, columns):
    """Print rows as JSON or as a text table with the given columns."""
    if as_json:
        print(json.dumps([dict(r) for r in rows]))
        return
    table([[r[c] for c in columns] for r in rows], columns)


# --- argument parsing ---

def build_parser():
    """Build the argparse tree. --db and --at are accepted before and after the command words."""
    def add_common(parser, default):
        parser.add_argument("--db", default=default,
                            help="database path (else $SOFA_STATE_DB, else <main folder>/.sofa/state.db)")
        parser.add_argument("--at", type=norm_iso, default=default,
                            help="time to record, ISO-8601 (default: now, UTC)")

    # SUPPRESS on the leaf copy keeps a value given before the command words.
    common = argparse.ArgumentParser(add_help=False)
    add_common(common, argparse.SUPPRESS)

    p = argparse.ArgumentParser(prog="sofa-state", description="The SQLite state store of sofa.")
    add_common(p, None)
    top = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")

    def leaf(parent, name, func, help_text):
        sp = parent.add_parser(name, parents=[common], help=help_text, description=help_text)
        sp.set_defaults(func=func)
        return sp

    def group(name, help_text):
        g = top.add_parser(name, help=help_text, description=help_text)
        return g.add_subparsers(dest="sub", required=True, metavar="ACTION")

    leaf(top, "init", lambda con, a: None, "create the schema when it is not there")

    s = group("session", "sessions of the fleet")
    sp = leaf(s, "upsert", cmd_session_upsert, "insert or update a session; it does not check the caller (a consistency guard, not a security boundary), and at a restart it marks the started work orders of that name left over")
    sp.add_argument("--name", required=True)
    sp.add_argument("--id", required=True)
    sp.add_argument("--role", required=True)
    sp.add_argument("--model")
    sp.add_argument("--state", choices=["live", "stopped"],
                    help="live on insert when omitted; kept on update when omitted")
    sp.add_argument("--item", help="item the session works on; clears free_since")
    sp = leaf(s, "free", cmd_session_free, "set the item to NULL and free_since to now")
    sp.add_argument("--name", required=True)
    sp = leaf(s, "colour", cmd_session_colour, "record the colour that /color set in the session")
    sp.add_argument("--name", required=True)
    sp.add_argument("--colour", required=True)
    sp = leaf(s, "heartbeat", cmd_session_heartbeat, "record a heartbeat")
    sp.add_argument("--name", required=True)
    sp = leaf(s, "remove", cmd_session_remove, "remove 1 session whose name the snapshot guard refuses")
    sp.add_argument("--name", required=True)
    sp.set_defaults(lock_tries=1, locked="session remove: the store is locked by another writer; no change (try again)")
    sp = leaf(s, "rename", cmd_session_rename, "give 1 session whose name the snapshot guard refuses a new name")
    sp.add_argument("--name", required=True)
    sp.add_argument("--to", required=True)
    sp.set_defaults(lock_tries=1, locked="session rename: the store is locked by another writer; no change (try again)")
    sp = leaf(s, "list", cmd_session_list, "print all sessions")
    sp.add_argument("--json", action="store_true")

    i = group("item", "work items (stories, features)")
    sp = leaf(i, "set", cmd_item_set, "insert or update an item; an empty value clears --pr, --branch, --worktree, --waits-for, and --session of a roadmap row. The guards (reopen, session, owner) are a consistency check, not a security boundary: they run only when the caller is known (CLAUDE_CODE_SESSION_ID names a session). It prints 1 stderr line `<id>: <old> -> <new>` for each other row that the map of old state words changed")
    sp.add_argument("--id", required=True)
    sp.add_argument("--state")
    sp.add_argument("--pr")
    sp.add_argument("--branch")
    sp.add_argument("--worktree")
    sp.add_argument("--waits-for", dest="waits_for")
    sp.add_argument("--session")
    sp.add_argument("--reopen", action="store_true")
    sp.add_argument("--take-over", dest="take_over", action="store_true",
                    help="write a work order of another session; give it only when a TASK gives you that work order (a plain flag: no check of who gave it)")
    sp = leaf(i, "migrate", cmd_item_migrate, "change the old state words of the items to the new words")
    sp.add_argument("--dry-run", dest="dry_run", action="store_true")
    sp = leaf(i, "list", cmd_item_list, "print the item rows (a read command)")
    sp.add_argument("--session", help="keep only the rows of this session")
    sp.add_argument("--open", action="store_true", help="keep only the rows whose state is not closed")
    sp.add_argument("--json", action="store_true")
    sp = leaf(i, "remove", cmd_item_remove, "remove 1 item whose id the snapshot guard refuses")
    sp.add_argument("--id", required=True)
    sp.set_defaults(lock_tries=1, locked="item remove: the store is locked by another writer; no change (try again)")
    sp = leaf(i, "rename", cmd_item_rename, "give 1 item whose id the snapshot guard refuses a new id")
    sp.add_argument("--id", required=True)
    sp.add_argument("--to", required=True)
    sp.set_defaults(lock_tries=1, locked="item rename: the store is locked by another writer; no change (try again)")
    sp = leaf(i, "trip", cmd_item_trip, "record a hand-over between two roles")
    sp.add_argument("--id", required=True)
    sp.add_argument("--from", dest="from_role", required=True)
    sp.add_argument("--to", dest="to_role", required=True)

    m = group("message", "message headers")
    sp = leaf(m, "log", cmd_message_log, "record a message header (never the body)")
    sp.add_argument("--type", required=True)
    sp.add_argument("--from", dest="from_name", required=True)
    sp.add_argument("--to", dest="to_name", required=True)
    sp.add_argument("--subject", required=True)

    d = group("decision", "decisions per story")
    sp = leaf(d, "log", cmd_decision_log, "record a decision and print its id")
    sp.add_argument("--id", help="the id; with no --id, the next free D-<n>")
    sp.add_argument("--replace", action="store_true", help="write over the decision with this --id")
    sp.add_argument("--story", required=True)
    # The 4 values of the decision tables of docs/adlc.md, section 4. A value outside
    # the list exits 2 and writes nothing, so the digest and the band audit can read each row.
    sp.add_argument("--level", required=True, choices=DECISION_LEVELS)
    sp.add_argument("--confidence", required=True, choices=DECISION_CONFIDENCES)
    sp.add_argument("--reversibility", required=True, choices=DECISION_REVERSIBILITIES)
    sp.add_argument("--visibility", required=True, choices=DECISION_VISIBILITIES)
    sp.add_argument("--by", required=True, help="who decided, for example decision-judge or hitl")
    sp.add_argument("--summary", required=True)
    sp = leaf(d, "block", cmd_decision_block, "print the block of decision ids of this store")
    sp.add_argument("--reserve", action="store_true", help="reserve a block when no id is free")
    sp.add_argument("--check", action="store_true", help="check that origin holds the tag of the block")
    sp = leaf(d, "veto", cmd_decision_veto, "mark a decision as vetoed")
    sp.add_argument("--id", required=True)
    sp = leaf(d, "list", cmd_decision_list, "print decisions")
    sp.add_argument("--story")
    sp.add_argument("--since", type=norm_iso, help="ISO-8601 lower bound")
    sp.add_argument("--json", action="store_true")

    k = group("ask", "asks to hitl")
    sp = leaf(k, "open", cmd_ask_open, "open an ask")
    sp.add_argument("--id", required=True)
    sp.add_argument("--story", required=True)
    sp.add_argument("--priority", required=True)
    sp = leaf(k, "close", cmd_ask_close, "close an ask")
    sp.add_argument("--id", required=True)
    sp = leaf(k, "list", cmd_ask_list, "print all asks")
    sp.add_argument("--json", action="store_true")

    n = group("interaction", "human interactions per story")
    sp = leaf(n, "log", cmd_interaction_log, "record one interaction")
    sp.add_argument("--story", required=True)
    sp.add_argument("--kind", required=True, choices=INTERACTION_KINDS)
    sp.add_argument("--by", required=True)

    u = group("usage", "tokens per session per item")
    sp = leaf(u, "set", cmd_usage_set, "set the token count")
    sp.add_argument("--session", required=True)
    sp.add_argument("--item", required=True)
    sp.add_argument("--tokens", required=True, type=int)

    q = group("queue", "the item queue")
    sp = leaf(q, "set", cmd_queue_set, "replace the queue")
    sp.add_argument("items", nargs="*", metavar="ITEM")
    leaf(q, "list", cmd_queue_list, "print the queue in order")

    v = group("kv", "key-value pairs")
    sp = leaf(v, "set", cmd_kv_set, "set a key")
    sp.add_argument("key")
    sp.add_argument("value")
    sp = leaf(v, "get", cmd_kv_get, "print a value; exit 1 when the key is not there")
    sp.add_argument("key")

    sp = leaf(top, "metrics", cmd_metrics, "print the metrics of one story")
    sp.add_argument("--story", required=True)
    sp.add_argument("--json", action="store_true")

    sp = leaf(top, "report", cmd_report, "print the dashboard tables")
    sp.add_argument("--json", action="store_true")

    sn = group("snapshot", "the scrubbed snapshot of this line")
    sp = leaf(sn, "take", cmd_snapshot_take, "write 1 scrubbed snapshot of this line as JSON")
    sp.add_argument("--config", help=f"the floor configuration (default: <main folder>/{FLOOR_CONFIG})")
    sp.add_argument("--out", help="write the snapshot to this file, not to stdout")
    sp.set_defaults(lock_tries=1, locked="the store is locked by another writer; no snapshot written")

    sp = leaf(sn, "publish", cmd_snapshot_publish, "push the scrubbed snapshot of this line to its ref on origin")
    sp.add_argument("--config", help=f"the floor configuration (default: <main folder>/{FLOOR_CONFIG})")
    sp.set_defaults(lock_tries=1,
                    locked=f"{PUBLISH_FAILED}: the store is locked by another writer; {PUBLISH_TAIL}")

    sp = leaf(sn, "lines", cmd_snapshot_lines, "print the snapshot of each line on origin as JSON")
    sp.add_argument("--now", type=norm_iso, help="the time of the read, ISO-8601 (default: now, UTC)")

    sp = leaf(top, "prune", cmd_prune, "remove heartbeats and messages older than N days")
    sp.add_argument("--days", required=True, type=int)
    return p


LOCK_TRIES = 25


def run_with_retry(a):
    """Open the database and run the command. Try again when the database is locked.

    The busy timeout covers most waits. It does not cover the moment the file is
    created: until WAL is on, SQLite can return "locked" at once to avoid a
    deadlock between two connections in rollback mode. Each command commits only
    at its end, so a new try does not write a row twice.
    """
    path = a.db_path = db_path(a.db)
    # A leaf may set lock_tries and locked (the output line of its stop): `snapshot take`, `snapshot publish` and
    # the 4 leaves remove and rename of items and sessions make 1 try, so they stop at the first "database is locked"
    # error, after the busy timeout of open_db.
    tries = getattr(a, "lock_tries", LOCK_TRIES)
    for n in range(tries):
        try:
            con = open_db(path)
            try:
                a.func(con, a)
                return
            finally:
                con.close()
        except sqlite3.OperationalError as e:
            locked = "locked" in str(e) or "busy" in str(e)
            if not locked:
                raise
            if n == tries - 1:
                if getattr(a, "locked", None):
                    raise UsageError(a.locked) from None
                raise
            time.sleep(random.uniform(0.02, 0.1 * (n + 1)))


def main(argv=None):
    """Run one command. Return the exit code."""
    a = build_parser().parse_args(argv)
    if a.at is None:
        a.at = now_iso()
    try:
        run_with_retry(a)
    except UsageError as e:
        if not isinstance(e, Quiet):
            print(f"sofa-state: {e}", file=sys.stderr)
        return e.code
    except subprocess.CalledProcessError:
        print("sofa-state: not in a git repository; give --db or set SOFA_STATE_DB", file=sys.stderr)
        return 1
    except (sqlite3.Error, OSError) as e:
        print(f"sofa-state: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
