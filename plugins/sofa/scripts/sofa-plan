#!/usr/bin/env python3
"""Run Plan with the selected main repository profile, without a shell."""
import argparse
import sys

from sofa_plan import Plan, PlanFailure, run, selection


def setup_source(command, root):
    """Give the last --source-root value of a setup command, resolved as Plan resolves it, or None."""
    value = None
    for index, arg in enumerate(command):
        if arg == "--source-root" and index + 1 < len(command):
            value = command[index + 1]
        elif arg.startswith("--source-root="):
            value = arg.split("=", 1)[1]
    return None if value is None else str((root / value).resolve())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    try:
        if not args.command:
            raise PlanFailure("give a Plan command")
        if any(arg.startswith("--") and len(arg.split("=", 1)[0]) > 2
               and "--workspace".startswith(arg.split("=", 1)[0]) for arg in args.command):
            raise PlanFailure("the factory selects the workspace; do not pass --workspace")
        root, backend, profile = selection(args.repo)
        if backend != "plan":
            raise PlanFailure("this factory uses Product; select Plan before using sofa-plan")
        # A join makes the profile, so only setup --shared runs with no profile.
        # A plain setup would make a new Plan control, and the factory has one.
        first_setup = args.command[0] == "setup" and "--shared" in args.command and not profile.exists()
        plan = Plan(root, profile, allow_missing=first_setup)
        if first_setup:
            plan.check_source({"source_root": setup_source(args.command, root)})
        else:
            plan.check_source()
        code, _, _ = run([*plan.command, *args.command], cwd=root, capture=False)
        return code if code >= 0 else 128 - code
    except PlanFailure as exc:
        print(f"sofa-plan: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
