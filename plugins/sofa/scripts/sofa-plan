#!/usr/bin/env python3
"""Run Plan with the selected main repository profile, without a shell."""
import argparse
import sys

from sofa_plan import Plan, PlanFailure, run, selection


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    try:
        if not args.command:
            raise PlanFailure("give a Plan command")
        if any(arg.startswith("--") and len(arg.split("=", 1)[0]) > 2
               and "--workspace".startswith(arg.split("=", 1)[0]) for arg in args.command):
            raise PlanFailure("the factory selects the workspace; do not pass --workspace")
        root, backend, profile = selection(args.repo)
        if backend != "plan":
            raise PlanFailure("this factory uses Product; select Plan before using sofa-plan")
        plan = Plan(root, profile)
        plan.check_source()
        code, _, _ = run([*plan.command, *args.command], cwd=root, capture=False)
        return code if code >= 0 else 128 - code
    except PlanFailure as exc:
        print(f"sofa-plan: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
