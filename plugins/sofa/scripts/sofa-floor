LIVE_JS = """
(function () {
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var es = new EventSource('events');
  es.addEventListener('snapshot', function (e) {
    var d = JSON.parse(e.data);
    document.getElementById('floor').innerHTML = d.html;
    stamp();
  });
  es.addEventListener('handoff', function (e) {
    var d = JSON.parse(e.data);
    var tick = document.getElementById('ticker');
    if (tick) { var li = document.createElement('li'); li.textContent = d.at.slice(11, 19) + ' UTC  ' + d.type +
      '  ' + d.from + ' \\u2192 ' + d.to; tick.insertBefore(li, tick.firstChild);
      while (tick.children.length > 8) { tick.removeChild(tick.lastChild); } }
    var last = document.getElementById('last-handoff');
    if (last) { last.setAttribute('data-time', d.at); }
    if (reduce) { return; }
    var a = document.querySelector('.bay[data-station="' + CSS.escape(d.from) + '"]');
    var b = document.querySelector('.bay[data-station="' + CSS.escape(d.to) + '"]');
    var box = document.querySelector('.bays');
    if (!a || !b || !box) { return; }
    var r = box.getBoundingClientRect(), ra = a.getBoundingClientRect(), rb = b.getBoundingClientRect();
    var dot = document.createElement('span'); dot.className = 'handoff';
    dot.style.left = (ra.left - r.left + ra.width / 2) + 'px'; dot.style.top = (ra.top - r.top + ra.height / 2) + 'px';
    box.appendChild(dot);
    requestAnimationFrame(function () { requestAnimationFrame(function () {
      dot.style.transform = 'translate(' + (rb.left - ra.left) + 'px,' + (rb.top - ra.top) + 'px)'; }); });
    setTimeout(function () { dot.style.opacity = '0'; }, 1100);
    setTimeout(function () { dot.remove(); }, 1600);
  });
  es.onerror = function () { var s = document.getElementById('conn'); if (s) { s.textContent = 'Reconnecting'; } };
  es.onopen = function () { var s = document.getElementById('conn'); if (s) { s.textContent = 'Live'; } };
})();
"""

AGE_JS = """
function stamp() {
  var now = Date.now();
  document.querySelectorAll('[data-time]').forEach(function (el) {
    var t = Date.parse(el.getAttribute('data-time')); if (isNaN(t)) { return; }
    var s = Math.max(0, (now - t) / 1000);
    el.textContent = s < 60 ? Math.floor(s) + ' s' : s < 3600 ? Math.floor(s / 60) + ' min' :
      s < 86400 ? Math.floor(s / 3600) + ' h' : Math.floor(s / 86400) + ' d';
  });
}
stamp(); setInterval(stamp, 15000);
"""


def e(text):
    return html.escape(str(text), quote=True)


def level_html(level, scope, extra=""):
    """The shape and the word of a level, with the attributes that a test and a screen reader read."""
    return (f'<span class="lvl lvl-{e(level.replace(" ", "-"))}" data-scope="{e(scope)}" data-level="{e(level)}">'
            f'<span class="shape" aria-hidden="true">{HTML_SHAPES[level]}</span> '
            f'<span class="word">{e(level)}</span>{extra}</span>')


def render_floor(m):
    """The part of the page that a new snapshot replaces: the band, the alerts, the verdict, the line, the stations
    and the bays."""
    run_cls = f"run-{m['run'].replace(' ', '-')}"
    dot = {"running": "●", "paused": "○", "not running": "◌"}[m["run"]]
    if m["mode"] == "live":
        live = (f'<span><span id="conn">Live</span> · last hand-off '
                + (f'<span id="last-handoff" data-time="{e(m["last_handoff_at"])}">{e(age_words(m["handoff_age"] or 0))}</span> ago'
                   if m["last_handoff_at"] else '<span id="last-handoff">none yet</span>') + '</span>')
    else:
        live = (f'<span>Snapshot of {e(show_time(m["taken_at"]))} · <span data-time="{e(m["taken_at"])}">'
                f'{e(age_words(m["age"] or 0))}</span> old</span>')
    parts = [f'<section class="band {run_cls}" aria-label="Factory">'
             f'<span class="run" data-run="{e(m["run"])}"><span class="dot" aria-hidden="true">{dot}</span> '
             f'<strong>{e(m["run_word"])}</strong></span>{live}</section>']
    for alert in m["alerts"]:
        parts.append(f'<div class="alert lvl-{e(alert["level"].replace(" ", "-"))}" role="status">'
                     f'<span class="shape" aria-hidden="true">{HTML_SHAPES[alert["level"]]}</span> {e(alert["text"])}</div>')
    f = m["floor"]
    parts.append(f'<section class="figures{" dimmed" if m["dim"] else ""}"><div class="verdict">{level_html(f["level"], "floor")} '
                 f'<span class="sentence">{e(f["sentence"])}</span></div>')
    for line in m["lines"]:
        parts.append(f'<p>Line {e(line["label"])}: {level_html(line["level"], "line:" + str(line["label"]))} '
                     f'<span class="muted">({e(line["state"])})</span></p>')
    parts.append('<h2>Stations</h2><div class="panel"><table><thead><tr><th>Level</th><th>Station</th>'
                 '<th>Sessions</th><th>Why</th></tr></thead><tbody>')
    if not m["stations"]:
        parts.append('<tr><td colspan="4" class="muted">No station.</td></tr>')
    for x in m["stations"]:
        parts.append(f'<tr><td>{level_html(x["level"], "station:" + str(x["station"]))}</td><td>{e(x["station"])}</td>'
                     f'<td>{e(x["sessions"])}</td><td>{e(", ".join(x["reasons"]))}</td></tr>')
    parts.append('</tbody></table></div><h2>The floor</h2><div class="bays">')
    for x in m["stations"]:
        parts.append(f'<div class="bay lvl-{e(x["level"].replace(" ", "-"))}" data-station="{e(x["station"])}">'
                     f'<span class="shape" aria-hidden="true">{HTML_SHAPES[x["level"]]}</span> '
                     f'<strong>{e(x["station"])}</strong><div class="muted">{e(x["level"])}</div></div>')
    parts.append('</div></section>')
    return "".join(parts)


def render_html(m, snap):
    """The HTML page of MODE artifact or live. The artifact holds the snapshot as given, and no other data."""
    live = m["mode"] == "live"
    title = "Factory Floor"
    ticker = '<h2>Hand-offs</h2><ul id="ticker" class="panel muted"></ul>' if live else ""
    data = json.dumps(snap, sort_keys=True).replace("</", "<\\/")
    legend = " ".join(f'<span class="lvl-{k.replace(" ", "-")}"><span class="shape" aria-hidden="true">{v}</span> {k}</span>'
                      for k, v in HTML_SHAPES.items())
    script = AGE_JS + (LIVE_JS if live else "")
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
            f'<meta name="viewport" content="width=device-width, initial-scale=1"><title>{title}</title>'
            f'<style>{CSS}</style></head><body><main data-mode="{e(m["mode"])}">'
            f'<h1>{title}</h1><div id="floor">{render_floor(m)}</div>{ticker}'
            f'<p class="legend muted">Levels: {legend}</p></main>'
            f'<script type="application/json" id="snapshot">{data}</script>'
            f'<script>{script}</script></body></html>\n')


# --- the local live page ---

def store_path(a):
    if a.db:
        return a.db
    if os.environ.get("SOFA_STATE_DB"):
        return os.environ["SOFA_STATE_DB"]
    return os.path.join(sofa_state.main_folder(), ".sofa", "state.db")


class Live:
    """The state of the live page: the last snapshot, and the hand-offs of the message log (only the type, the sender
    station and the receiver station of a row; never its subject)."""

    def __init__(self, a):
        self.a, self.lock = a, threading.Lock()
        self.snap, self.error, self.version = None, None, 0
        self.db = store_path(a)

    def refresh(self):
        try:
            snap = take_snapshot(self.a)
            with self.lock:
                if self.snap is None or snap != self.snap:
                    self.snap, self.version = snap, self.version + 1
                self.error = None
        except (FloorError, subprocess.TimeoutExpired, ValueError) as err:
            with self.lock:
                self.error = str(err) if isinstance(err, FloorError) else type(err).__name__

    def loop(self, interval):
        while True:
            time.sleep(interval)
            self.refresh()

    def page(self):
        with self.lock:
            snap = self.snap
        if snap is None:
            return ('<!doctype html><html lang="en"><head><meta charset="utf-8"><title>Factory Floor</title>'
                    f'<style>{CSS}</style></head><body><main><h1>Factory Floor</h1><div id="floor">'
                    '<div class="alert">Loading the snapshot</div></div></main>'
                    f'<script>{AGE_JS}{LIVE_JS}</script></body></html>\n')
        return render_html(view_model(snap, datetime.now(timezone.utc), "live"), snap)

    def handoffs(self, after):
        """The rows of `messages` after the row id AFTER, as (id, event dict), with the station of each name."""
        try:
            con = sqlite3.connect(f"file:{self.db}?mode=ro", uri=True, timeout=2)
        except sqlite3.Error:
            return []
        try:
            roles = dict(con.execute("SELECT name, role FROM sessions").fetchall())
            rows = con.execute("SELECT id, type, from_name, to_name, at FROM messages WHERE id > ? ORDER BY id",
                               (after,)).fetchall()
            return [(i, {"type": t or "", "from": roles.get(f) or "", "to": roles.get(to) or "", "at": at or ""})
                    for i, t, f, to, at in rows]
        except sqlite3.Error:
            return []
        finally:
            con.close()

    def last_id(self):
        rows = self.handoffs(0)
        return rows[-1][0] if rows else 0


def make_handler(live):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            return

        def do_GET(self):
            if self.path in ("/", "/index.html"):
                body = live.page().encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif self.path == "/events":
                self.events()
            else:
                self.send_error(404)

        def send_event(self, name, data):
            self.wfile.write(f"event: {name}\ndata: {json.dumps(data)}\n\n".encode("utf-8"))
            self.wfile.flush()

        def events(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            seen, last, beat = -1, live.last_id(), time.monotonic()
            try:
                while True:
                    with live.lock:
                        version, snap = live.version, live.snap
                    if snap is not None and version != seen:
                        model = view_model(snap, datetime.now(timezone.utc), "live")
                        self.send_event("snapshot", {"taken_at": snap.get("taken_at"), "html": render_floor(model)})
                        seen = version
                    for row_id, event in live.handoffs(last):
                        self.send_event("handoff", event)
                        last = row_id
                    if time.monotonic() - beat > 15:
                        self.wfile.write(b": beat\n\n")
                        self.wfile.flush()
                        beat = time.monotonic()
                    time.sleep(0.5)
            except (BrokenPipeError, ConnectionResetError):
                return
    return Handler


def cmd_serve(a):
    live = Live(a)
    live.refresh()
    threading.Thread(target=live.loop, args=(a.interval,), daemon=True).start()
    server = ThreadingHTTPServer(("127.0.0.1", a.port), make_handler(live))
    server.daemon_threads = True
    print(f"floor page: http://127.0.0.1:{server.server_address[1]}/", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def cmd_terminal(a):
    snap = take_snapshot(a)
    color = not a.no_color and sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    sys.stdout.write(render_text(view_model(snap, now_of(a), "terminal"), color))
    return 0


def cmd_artifact(a):
    snap = take_snapshot(a)
    page = render_html(view_model(snap, now_of(a), "artifact"), snap)
    folder = os.path.dirname(os.path.abspath(a.out))
    os.makedirs(folder, exist_ok=True)
    with open(a.out, "w", encoding="utf-8") as f:
        f.write(page)
    print(f"artifact: {a.out}")
    return 0


def now_of(a):
    if a.now:
        t = parse_time(a.now)
        if t is None:
            raise FloorError("--now must be YYYY-MM-DDTHH:MM:SSZ")
        return t
    return datetime.now(timezone.utc)


def main(argv=None):
    p = argparse.ArgumentParser(prog="sofa-floor", description="The 3 views of the sofa factory floor (STORY-452).")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--db", help="the state store (else $SOFA_STATE_DB, else <main folder>/.sofa/state.db)")
    common.add_argument("--config", help="the floor configuration (else <main folder>/.claude/sofa-floor.json)")
    common.add_argument("--snapshot", help="read this snapshot file instead of taking a snapshot")
    common.add_argument("--now", help="the time of the view, YYYY-MM-DDTHH:MM:SSZ (default: now)")
    sub = p.add_subparsers(dest="cmd", required=True)
    t = sub.add_parser("terminal", parents=[common], help="print the terminal view")
    t.add_argument("--no-color", action="store_true", help="no colour; each level keeps its shape and its word")
    t.set_defaults(func=cmd_terminal)
    r = sub.add_parser("artifact", parents=[common], help="write the HTML page of the published artifact")
    r.add_argument("--out", required=True, help="the HTML file to write")
    r.set_defaults(func=cmd_artifact)
    s = sub.add_parser("serve", parents=[common], help="serve the local live page on 127.0.0.1")
    s.add_argument("--port", type=int, default=0, help="the port (default: a free port)")
    s.add_argument("--interval", type=float, default=10.0, help="seconds between 2 snapshots (default 10)")
    s.set_defaults(func=cmd_serve)
    a = p.parse_args(argv)
    try:
        return a.func(a)
    except FloorError as err:
        print(f"sofa-floor: {err}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
