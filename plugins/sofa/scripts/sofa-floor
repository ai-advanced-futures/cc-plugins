  --muted:#a3a39d; --line:#34342f; --running:#3fbf62; --caution:#e2b93b; --serious:#f08a3c; --critical:#f0645a;
  --tint-caution:#3a3216; --tint-serious:#3d2614; --tint-critical:#3f1c19; --tint-standing:#25272a; } }
:root[data-theme="dark"] { --bg:#141413; --panel:#1e1e1c; --ink:#ececea; --muted:#a3a39d; --line:#34342f;
  --running:#3fbf62; --caution:#e2b93b; --serious:#f08a3c; --critical:#f0645a; --tint-caution:#3a3216;
