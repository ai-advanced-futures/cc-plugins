#!/usr/bin/env python3
"""sofa-floor: the 3 views of the factory floor (STORY-452). Each view reads 1 snapshot of `sofa-state snapshot take`.

  terminal   the terminal view (the /sofa-dashboard pane shows it with --no-color)
  artifact   1 self-contained HTML page for the Artifact tool; it holds only the scrubbed snapshot
  serve      the local live page on 127.0.0.1: a new snapshot and each new hand-off reach it by server-sent events

Each view shows the levels and the words that the snapshot gives, and computes none of them (CONVENTION-04). The 1
exception is the age of the snapshot against its age limit (CONVENTION-04, STORY-450). The spec is
docs/superpowers/specs/2026-11-26-STORY-452-the-terminal-view-the-published-artifact-and-the-local-live-page-read-the-same-snapshot-design.md.
"""
import argparse
import html
import importlib.machinery
import importlib.util
import json
import os
import sqlite3
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.realpath(__file__))
STATE = os.path.join(HERE, "sofa-state")
_loader = importlib.machinery.SourceFileLoader("sofa_state", STATE)
sofa_state = importlib.util.module_from_spec(importlib.util.spec_from_loader("sofa_state", _loader))
_loader.exec_module(sofa_state)

LEVELS = sofa_state.VERDICT_LEVELS  # off, standing by, working, caution, serious, critical (CONVENTION-02)
# The shape of each level (CONVENTION-02): the terminal glyph, and the glyph of the HTML views.
TERMINAL_SHAPES = {"off": "·", "standing by": "○", "working": "●", "caution": "◆", "serious": "▲", "critical": "■"}
HTML_SHAPES = {**TERMINAL_SHAPES, "off": "◌"}
# The colour of a level on the terminal view (CONVENTION-01 and 02): only caution, serious and critical have a hue;
# green is only the running word.
ANSI = {"caution": "33", "serious": "38;5;208", "critical": "31", "running": "32"}
# The plain words of each reason of a station (the keys of `verdicts.stations.reasons`, STORY-448).
REASON_WORDS = {
    "working": "working", "waiting": "waiting", "blocked": "blocked", "blocked_overdue": "blocked too long",
    "stale_heartbeat": "no heartbeat", "stopped_with_work": "stopped with open work",
    "ask_blocks_now": "a question blocks work now", "ask_blocks_later": "a question for later",
    "ask_overdue": "a question waits too long",
}
RUN_WORDS = {"running": "Running", "paused": "Paused at a safe point", "not running": "Not running"}
DEFAULT_MAX_AGE = 1800  # seconds, when the snapshot carries no `health.snapshot_max_age_seconds` (STORY-444)
TIME_FORM = "%Y-%m-%dT%H:%M:%SZ"


class FloorError(Exception):
    """A failure that the command reports in 1 line, with exit 1."""


# --- the snapshot ---

def take_snapshot(a):
    """Take 1 snapshot with sofa-state. --snapshot FILE reads that file instead."""
    if getattr(a, "snapshot", None):
        try:
            with open(a.snapshot, encoding="utf-8") as f:
                return json.load(f)
        except (OSError, ValueError) as e:
            raise FloorError(f"cannot read the snapshot file: {type(e).__name__}") from None
    cmd = [sys.executable, STATE, "snapshot", "take"]
    if a.db:
        cmd += ["--db", a.db]
    if a.config:
        cmd += ["--config", a.config]
    run = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    if run.returncode != 0:
        lines = run.stderr.strip().splitlines()
        raise FloorError(lines[-1] if lines else f"sofa-state snapshot take exited {run.returncode}")
    return json.loads(run.stdout)


def parse_time(text):
    try:
        return datetime.strptime(text, TIME_FORM).replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return None


def age_words(seconds):
    """An age as 1 short phrase: 45 s, 12 min, 3 h, 2 d."""
    if seconds < 60:
        return f"{int(seconds)} s"
    if seconds < 3600:
        return f"{int(seconds // 60)} min"
    if seconds < 86400:
        return f"{int(seconds // 3600)} h"
    return f"{int(seconds // 86400)} d"


# --- the view model: 1 model for the 3 views ---

def view_model(snap, now, mode):
    """The view model of SNAP at the time NOW, for MODE (terminal, artifact or live). It copies the levels, the states
    and the run state of the snapshot, and adds only the words and the age (CONVENTION-04)."""
    verdicts = snap.get("verdicts") or {}
    floor = verdicts.get("floor") or {"level": "off", "state": "stopped"}
    lines = verdicts.get("lines") or []
    stations = verdicts.get("stations") or []
    factory = snap.get("factory") or {}
    run = factory.get("run") if factory.get("run") in RUN_WORDS else "not running"
    taken = parse_time(snap.get("taken_at"))
    age = max(0.0, (now - taken).total_seconds()) if taken else None
    limit = ((snap.get("rules") or {}).get("health") or {}).get("snapshot_max_age_seconds") or DEFAULT_MAX_AGE
    old = age is not None and age > limit
    alerts = []
    since = factory.get("last_handoff_at") or snap.get("taken_at")
    if run == "not running":
        alerts.append({"level": "serious", "text": f"The factory is not running. Nothing has moved since "
                       f"{show_time(since)}. Start the team with /sofa:start."})
    if old:
        alerts.append({"level": "caution", "text": f"The snapshot is {age_words(age)} old (limit {age_words(limit)}). "
                       f"Each figure is as of {show_time(snap.get('taken_at'))}."})
    if mode == "artifact":
        alerts.append({"level": "standing by", "text": f"This published page is not live. It shows the snapshot of "
                       f"{show_time(snap.get('taken_at'))}."})
    return {
        "mode": mode,
        "taken_at": snap.get("taken_at"),
        "age": age, "limit": limit, "old": old,
        "run": run, "run_word": RUN_WORDS[run], "last_handoff_at": factory.get("last_handoff_at"),
        "handoff_age": (max(0.0, (now - parse_time(factory.get("last_handoff_at"))).total_seconds())
                        if parse_time(factory.get("last_handoff_at")) else None),
        "alerts": alerts,
        "dim": old or run == "not running",
        "floor": {"level": level_of(floor), "state": floor.get("state"),
                  "sentence": verdict_sentence(level_of(floor), stations, run)},
        "lines": [{"label": x.get("label"), "level": level_of(x), "state": x.get("state")} for x in lines],
        "stations": [{"station": x.get("station"), "level": level_of(x), "sessions": x.get("sessions") or 0,
                      "reasons": reason_phrases(x.get("reasons") or {})} for x in stations],
    }


def level_of(x):
    return x.get("level") if x.get("level") in LEVELS else "off"


def show_time(text):
    t = parse_time(text)
    return t.strftime("%Y-%m-%d %H:%M UTC") if t else "an unknown time"


def reason_phrases(reasons):
    return [f"{n} {REASON_WORDS.get(k, k.replace('_', ' '))}" for k, n in reasons.items() if n]


def verdict_sentence(level, stations, run):
    """1 sentence that names the scope of the verdict (design record, section 2, part 2)."""
    working = sum((x.get("reasons") or {}).get("working", 0) for x in stations)
    sessions = f"{working} session{'s' if working != 1 else ''} work{'s' if working == 1 else ''}."
    worst = [x for x in stations if level_of(x) == level]
    if LEVELS.index(level) >= LEVELS.index("caution") and worst:
        where = " and ".join(f"the {x.get('station')}" for x in worst[:2]) + (" and more" if len(worst) > 2 else "")
        why = ", ".join(reason_phrases({k: v for k, v in (worst[0].get("reasons") or {}).items() if k != "working"}))
        tail = " The factory has not stopped." if run != "not running" else ""
        return f"{level.capitalize()} at {where}: {why or level}. {sessions}{tail}"
    return f"{level.capitalize()}. {sessions}"


# --- the terminal view ---

def paint(text, key, color):
    return f"\033[{ANSI[key]}m{text}\033[0m" if color and key in ANSI else text


def render_text(m, color):
    """The terminal view. Each level has its shape and its word, so the view reads the same with no colour."""
    out = []
    run_mark = paint("● " + m["run_word"], "running", color) if m["run"] == "running" else \
        ("○ " if m["run"] == "paused" else "· ") + m["run_word"]
    handoff = f"last hand-off {show_time(m['last_handoff_at'])}" if m["last_handoff_at"] else "no hand-off yet"
    age = f"{age_words(m['age'])} old" if m["age"] is not None else "age unknown"
    out.append(f"FACTORY  {run_mark}  ·  {handoff}  ·  snapshot {show_time(m['taken_at'])} ({age})")
    for alert in m["alerts"]:
        out.append(f"  {paint(TERMINAL_SHAPES[alert['level']] + ' ' + alert['level'].upper(), alert['level'], color)}  "
                   f"{alert['text']}")
    f = m["floor"]
    out.append("")
    out.append(f"VERDICT  {paint(TERMINAL_SHAPES[f['level']] + ' ' + f['level'], f['level'], color)}  {f['sentence']}")
    for line in m["lines"]:
        out.append(f"LINE     {paint(TERMINAL_SHAPES[line['level']] + ' ' + line['level'], line['level'], color)}  "
                   f"{line['label']} ({line['state']})")
    out.append("")
    out.append("STATIONS")
    if not m["stations"]:
        out.append("  (no station)")
    for x in m["stations"]:
        word = f"{TERMINAL_SHAPES[x['level']]} {x['level']}"
        pad = " " * max(1, 13 - len(word))
        out.append(f"  {paint(word, x['level'], color)}{pad}{x['station']:<18} {x['sessions']} session"
                   f"{'s' if x['sessions'] != 1 else ''}  {', '.join(x['reasons'])}".rstrip())
    out.append("")
    out.append("Levels: · off  ○ standing by  ● working  ◆ caution  ▲ serious  ■ critical")
    return "\n".join(out) + "\n"


# --- the HTML views ---

CSS = """
:root { --bg:#f7f7f5; --panel:#ffffff; --ink:#1d1d1b; --muted:#6b6b66; --line:#dcdcd6; --running:#1f8a3b;
  --caution:#a77a00; --serious:#c2570c; --critical:#c0261d; --tint-caution:#fbf3dc; --tint-serious:#fcebdd;
  --tint-critical:#fbe4e2; --tint-standing:#eef0f2; }
